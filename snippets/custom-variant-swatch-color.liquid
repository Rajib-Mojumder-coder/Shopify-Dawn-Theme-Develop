{% assign swatch_color = value | downcase | strip %}

{% case swatch_color %}

  {% when 'black', 'schwarz', 'nero', 'negro', 'zwart', 'noir' %}
    {% assign swatch_color = '#000000' %}

  {% when 'white', 'weiss', 'weiß', 'bianco', 'blanco', 'wit', 'blanc' %}
    {% assign swatch_color = '#ffffff' %}

  {% when 'red', 'rot', 'rosso', 'rojo', 'rood', 'rouge' %}
    {% assign swatch_color = '#ff0000' %}

  {% when 'blue', 'blau', 'blu', 'azul', 'blauw', 'bleu' %}
    {% assign swatch_color = '#0000ff' %}

  {% when 'green', 'grün', 'gruen', 'verde', 'groen', 'vert' %}
    {% assign swatch_color = '#008000' %}

  {% when 'yellow', 'gelb', 'giallo', 'amarillo', 'geel', 'jaune' %}
    {% assign swatch_color = '#ffff00' %}

  {% when 'orange', 'orange', 'arancione', 'naranja' %}
    {% assign swatch_color = '#ffa500' %}

  {% when 'purple', 'violett', 'lila', 'viola', 'morado', 'paars', 'violet' %}
    {% assign swatch_color = '#800080' %}

  {% when 'pink', 'rosa', 'rosé', 'roze', 'rose' %}
    {% assign swatch_color = '#ffc0cb' %}

  {% when 'gray', 'grey', 'grau', 'grigio', 'gris', 'grijs', 'gris' %}
    {% assign swatch_color = '#808080' %}

  {% when 'brown', 'braun', 'marrone', 'marrón', 'bruin', 'marron' %}
    {% assign swatch_color = '#8b4513' %}

  {% when 'navy', 'marine', 'navy blue' %}
    {% assign swatch_color = '#000080' %}

  {% when 'beige', 'beige' %}
    {% assign swatch_color = '#f5f5dc' %}

  {% when 'gold', 'golden', 'oro', 'dorado', 'goud' %}
    {% assign swatch_color = '#ffd700' %}

  {% when 'silver', 'silber', 'argento', 'plata', 'zilver' %}
    {% assign swatch_color = '#c0c0c0' %}

  {% else %}

    {% assign swatch_color = '#cccccc' %}

{% endcase %}


<input
  id="{{ input_id }}"
  class="custom-product-variant__swatch-input visually-hidden"
  type="radio"
  name="options[{{ option.name | escape }}]"
  value="{{ value | escape }}"
  form="{{ product_form_id }}"
  {% if option.selected_value == value %}
    checked
  {% endif %}
>

<label
  for="{{ input_id }}"
  class="custom-product-variant__swatch custom-product-variant__swatch--color custom-product-variant__swatch--{{ swatch_shape }}"
  title="{{ value | escape }}"
  aria-label="{{ value | escape }}"
  style="--swatch-color: {{ swatch_color }};"
>

  <span
    class="custom-product-variant__swatch-color"
    aria-hidden="true"
  ></span>

  <span class="visually-hidden">
    {{ value }}
  </span>

</label>