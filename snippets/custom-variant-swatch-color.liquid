{% assign swatch_color = swatch_value | downcase | strip %}

{% case swatch_color %}

  {% when 'black', 'schwarz', 'nero', 'negro', 'zwart', 'noir', 'asphalt black', 'diamondblack' %}
    {% assign swatch_color = '#4D4D4D' %}

  {% when 'white', 'weiss', 'weiß', 'bianco', 'blanco', 'wit', 'blanc' %}
    {% assign swatch_color = '#FFFFFF' %}

  {% when 'red', 'rot', 'rosso', 'rojo', 'rood', 'rouge' %}
    {% assign swatch_color = '#FF0000' %}

  {% when 'blue', 'blau', 'blu', 'azul', 'blauw', 'bleu' %}
    {% assign swatch_color = '#0000FF' %}

  {% when 'green', 'grün', 'gruen', 'verde', 'groen', 'vert' %}
    {% assign swatch_color = '#008000' %}

  {% when 'yellow', 'gelb', 'giallo', 'amarillo', 'geel', 'jaune' %}
    {% assign swatch_color = '#FFFF00' %}

  {% when 'orange', 'arancione', 'naranja' %}
    {% assign swatch_color = '#FFA500' %}

  {% when 'purple', 'violett', 'lila', 'viola', 'morado', 'paars', 'violet' %}
    {% assign swatch_color = '#800080' %}

  {% when 'pink', 'rosa', 'rosé', 'roze', 'rose' %}
    {% assign swatch_color = '#FFC0CB' %}

  {% when 'gray', 'grey', 'grau', 'grigio', 'gris', 'grijs' %}
    {% assign swatch_color = '#808080' %}

  {% when 'brown', 'braun', 'marrone', 'marrón', 'bruin', 'marron' %}
    {% assign swatch_color = '#8B4513' %}

  {% when 'navy', 'marine', 'navy blue' %}
    {% assign swatch_color = '#000080' %}

  {% when 'beige' %}
    {% assign swatch_color = '#F5F5DC' %}

  {% when 'gold', 'golden', 'oro', 'dorado', 'goud' %}
    {% assign swatch_color = '#FFD700' %}

  {% when 'silver', 'silber', 'argento', 'plata', 'zilver', 'adamantsilver' %}
    {% assign swatch_color = '#C0C0C0' %}

  {% when 'pebble green' %}
    {% assign swatch_color = '#598F9B' %}

  {% when 'asphalt black' %}
    {% assign swatch_color = '#4D4D4D' %}

  {% when 'slate blue' %}
    {% assign swatch_color = '#3C5358' %}

  {% else %}
    {% assign swatch_color = '#CCCCCC' %}

{% endcase %}

{{ swatch_color }}