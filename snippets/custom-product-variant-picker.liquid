{% liquid

  assign custom_variant_style = block.settings.custom_variant_style
  
%}

{%  unless product.has_only_default_variant %} {%  comment  %} {% if product.has_only_default_variant == false %} {% endcomment %} 

  <div class="custom-product-variant-picker" id="CustomVariantPicker-{{ section.id }}"
  data-section-id="{{ section.id }}" data-product-id = "{{ product.id }}">

  <script type="application/json" class="custom-product-variant__json">
    {{ product.variants | json }}
  </script>

    {% for option in product.options_with_values %}

      <fieldset class="custom-product-variant__option" data-option-position="{{ option.position }}">

        <legend class="custom-product-variant__label">
            <span class="custom-product-variant__label-title"> {{ option.name }} 
              {% if option.selected_value != blank %}:{% endif %} </span>
            <span class="custom-product-variant__selected-value" data-selected-value> {{ option.selected_value }} </span>
        </legend>

            {% if custom_variant_style == 'dropdown' %}

               {% comment %} This is actually not a CSS problem—it's a browser limitation. The <select> dropdown and the list of <option> elements are rendered by the operating system, not by your webpage.

              <div class="custom-product-variant__dropdown">
                 <select class="custom-product-variant__select" name="options[{{option.name |  escape}}]" form="{{ product_form_id }}">
                      {% for value in option.values %}
                      <option value="{{value |  escape}}" {% if option.selected_value == value %} selected {% endif %}>
                          {{ value }} 
                        </option>
                      {% endfor %}
                 </select>
               </div> {% endcomment %}
             
               <div class="custom-product-variant__dropdown">
                  <button type="button"  class="custom-product-variant__dropdown-toggle" aria-expanded="false" aria-haspopup="listbox">
                     <span class="custom-product-variant__dropdown-value"> {{ option.selected_value }} </span>
                     <span class="custom-product-variant__dropdown-icon"> ▼ </span>
                  </button>

                  <ul class="custom-product-variant__dropdown-menu" role="listbox">

                    {% for value in option.values  %}  
                    <li class="custom-product-variant__dropdown-item {% if option.selected_value == value %} selected{% endif %}" data-value="{{value |  escape}}"> 
                        {{ value }} 
                      </li> 
                    {% endfor %}
        
                  </ul>

                  <input type="hidden" class="custom-product-variant__hidden-input" 
                        name="options[{{option.name |  escape}}]" value="{{option.selected_value}}" form="{{product_form_id}}">
                      {% comment %} Without the hidden input, the browser submits nothing because a <button> and <li> do not send form data. Why not read the button text? Because browsers only submit values from form controls like: <input> <select> <textarea> {% endcomment %}

               </div>

          {%  else %} 
                
                <div class="custom-product-variant__values" role="radiogroup" aria-label="{{option.name}}">
                    {% for value in option.values %}
                      {% assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index %}

                      <input id="{{ input_id }}" class="custom-product-variant__radio visually-hidden"  form="{{ product_form_id }}" 
                      type="radio" name="options[{{option.name |  escape}}]" value="{{ value |  escape }}" 
                        {% if option.selected_value == value %} checked {% endif %}> 

                          <label class="custom-product-variant__button" for="{{ input_id }}">
                            <span class="custom-product-variant__button-text">  {{ value }} </span>
                           </label>
                           
                    {% endfor %}
                </div>

          {% endif %}

      </fieldset>

    {% endfor %} 
      
  </div>

{% endunless %}

<script>

document.addEventListener("click", function(e){

const dropdowns = document.querySelectorAll(".custom-product-variant__dropdown"); //Website-e if 3ta optn thke er mde dropdown sav hbe.

    dropdowns.forEach(function(dropdown){ //Loop every dropdown,  Current dropdown-er vitore
      const button = document.querySelector(".custom-product-variant__dropdown-toggle"); //button khuje ber kor
      const menu = document.querySelector(".custom-product-variant__dropdown-menu"); //menu khuje ber kor
      const value = document.querySelector(".custom-product-variant__dropdown-value"); //selected text khuje ber kor
      const input = document.querySelector(".custom-product-variant__hidden-input"); //
    })

});

</script>

<style>
/* ===== Shared Typography (Button + Dropdown) ===== */

.custom-product-variant__button,
.custom-product-variant__dropdown-toggle,
.custom-product-variant__dropdown-value,
.custom-product-variant__dropdown-item {
    font-family: inherit;
    font-size: var(--font-body);
    font-weight: 400;
    line-height: .9;
}

/* ========== Custom Product Variant Picker============== */
.custom-product-variant-picker {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: 1.75rem;
}
/* =============   Option ============= */
.custom-product-variant__option {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
}

.custom-product-variant__label {
    display: flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: .75rem;
    font-size: var(--font-body);
    font-family: inherit;
    font-weight: 600;
    color: #3F7280;
    /* line-height: 90%; */
}
.custom-product-variant__selected-value {
    font-weight: 500;
    color: rgba(var(--color-foreground), .65);
}
/* ==============   Buttons ================= */
.custom-product-variant__values {
  display: flex;
  flex-wrap: wrap;
  gap: .75rem;
}

.custom-product-variant__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: .8rem 1.4rem;
  border: 2px solid color-mix(in srgb, var(--color-primary) 50%, transparent);
  border-radius: 100px;
  background: var(--color-offwhite);
  color: var(--color-primary);
  cursor: pointer;
  transition:  background .25s ease, color .25s ease, border-color .25s ease, transform .2s ease;
}

.custom-product-variant__button:hover{
  border-color: color-mix(in srgb, var(--color-primary) 100%, transparent);
}
.custom-product-variant__button:active {
  transform: scale(.97);
}
.custom-product-variant__radio:checked + .custom-product-variant__button{
  background: var(--color-primary);
  color: var(--color-offwhite);
  border-color: color-mix(in srgb, var(--color-primary) 100%, transparent);
} 

/* ============= Keyboard Accessibility custom variant-এর জন্য যদি radio input hidden থাকে: তাহলে এই focus-visible CSS রাখা উচিত, কারণ নাহলে keyboard user বুঝতে পারবে না কোন variant বর্তমানে focus-এ আছে।================= */

.custom-product-variant__radio:focus-visible
+ .custom-product-variant__button {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

/* ===========   Disabled (Future)==================== */

.custom-product-variant__button--disabled {
  opacity: .45;
  pointer-events: none;
}

/* ================   Dropdown ===================== */

.custom-product-variant__dropdown {
  width: 100%;
  position: relative;
}

.custom-product-variant__dropdown-toggle {
  width: 100%;
  min-height: 4rem;
  justify-content: space-between;
  display: flex;
  align-items: center;
  padding-inline: 1.5rem;
  border: 1px solid #d9d9d9;
  border-radius: 8px;
  cursor: pointer;
  background: inherit;
}
.custom-product-variant__dropdown-item{
  line-height: 1.2;
}
/* text-overflow: ellipsis; লিখলেই কাজ করবে না। Browser-এর জন্য এই ৩টা condition দরকার।*/
.custom-product-variant__dropdown-value{
    overflow:hidden; /*যে content container-এর বাইরে চলে যায়, সেটা লুকিয়ে (hide) দেয়। */
    white-space:nowrap; /* এটা browser-কে বলে: "Text-কে নতুন লাইনে ভেঙো না।" */
    text-overflow:ellipsis; /* যদি text পুরোটা দেখানো না যায়, তাহলে শেষে... */
}
.custom-product-variant__dropdown-icon{
    transition:.3s;
}
.custom-product-variant__dropdown.is-open
.custom-product-variant__dropdown-icon{
    transform:rotate(180deg);
}

.custom-product-variant__dropdown-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  width: 100%;
  list-style: none;
  margin: 0;
  padding-block: 6px;
  border: 1px solid #ddd;
  border-radius: 8px;
  overflow: auto;
  z-index: 20;
  box-shadow:0 8px 30px rgba(0,0,0,.08);
  /* min-height: 260px; */
  display: none;
}

.custom-product-variant__dropdown.is-open
.custom-product-variant__dropdown-menu{
  display:block;
}

.custom-product-variant__dropdown-item{
  padding:12px 18px;
  cursor:pointer;
  transition:.25s;
}

.custom-product-variant__dropdown-item:hover{
  background:#f6f6f6;
}

.custom-product-variant__dropdown-item.selected{
  background:#111;
  color:#fff;
}
</style> 

