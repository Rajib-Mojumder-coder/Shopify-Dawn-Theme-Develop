{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign custom_variant_style = block.settings.custom_variant_style
  
%}

{%  unless product.has_only_default_variant %} {%  comment  %} {% if product.has_only_default_variant == false %} {% endcomment %} 

  <div class="custom-product-variant-picker" id="CustomVariantPicker-{{ section.id }}"
  data-section-id="{{ section.id }}" data-product-id = "{{ product.id }}">


    {% for option in product.options_with_values %}

      <fieldset class="custom-product-variant__option" data-option-position="{{ option.position }}">

        <legend class="custom-product-variant__label">
            {{ option.name }}
            <span class="custom-product-variant__selected-value" data-selected-value> {{ option.selected_value }} </span>
        </legend>

            {% if custom_variant_style == 'dropdown' %}

               <div class="custom-product-variant__dropdown">
                 <select class="custom-product-variant__select" name="options[{{option.name |  escape}}]">
                      {% for value in option.values %}
                        <option>
                          {{ value }}
                        </option>
                      {% endfor %}
                 </select>
               </div>
             
          {%  else %} 
                
                      <div class="custom-product-variant__button">
                          {% for value in option.values %}
                       
                          {{ value }}
                      
                      {% endfor %}
                      </div>

          {% endif %}

      </fieldset>

    {% endfor %} 
      
  </div>

{% endunless %}