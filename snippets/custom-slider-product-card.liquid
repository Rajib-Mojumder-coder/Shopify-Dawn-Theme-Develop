{% liquid
  assign show_image = block.settings.show_image
  assign image_link = block.settings.image_link

  assign show_title = block.settings.show_title
  assign show_description = block.settings.show_description
  assign show_vendor = block.settings.show_vendor

  assign show_badge = block.settings.show_badge
  assign show_wishlist = block.settings.show_wishlist
  assign show_price = block.settings.show_price
  assign show_compare_price = block.settings.show_compare_price

  assign show_button = block.settings.show_button

  assign button_text = block.settings.button_text
  assign button_style = block.settings.button_style

  assign current_variant = product.selected_or_first_available_variant

  assign show_secondary_image = block.settings.show_secondary_image
  assign second_image = product.images[1]
  assign quick_add_option = block.settings.quick_add_option | default: 'none'
  assign show_button = block.settings.show_add_to_cart
%}


<article
  class="custom-slider-product-card"
  data-product-id="{{ product.id }}"
  data-selected-variant-id="{{ current_variant.id }}"
  data-product-handle="{{ product.handle }}"
>

  {%- comment -%}
  =========================================================
  PRODUCT MEDIA
  =========================================================
  {%- endcomment -%}

  {% if show_image %}

    <div class="custom-slider-product-card__media">

      {% liquid
          assign color_option_name = block.settings.color_option_name | default: 'Kleur' | strip | downcase
          assign color_option = blank

          for option in product.options_with_values
            assign normalized_option_name = option.name | strip | downcase

            if normalized_option_name == color_option_name or normalized_option_name == 'kleur'
              assign color_option = option
              break
            endif
          endfor
        %}

      
      {% if block.settings.show_color_swatches and color_option != blank %}
        <div
          class="custom-slider-product-card__swatches custom-slider-product-card__swatches--{{ block.settings.color_swatch_position }} custom-slider-product-card__swatches--{{ block.settings.color_swatch_shape }}"
          role="group" aria-label="{{ color_option.name | escape }} options">
          {% for value in color_option.values %}
            {% liquid
              assign swatch_variant = blank
              assign swatch_fallback_variant = blank

              for variant in product.variants
                assign matches_color = false

                case color_option.position
                  when 1
                    if variant.option1 == value
                      assign matches_color = true
                    endif
                  when 2
                    if variant.option2 == value
                      assign matches_color = true
                    endif
                  when 3
                    if variant.option3 == value
                      assign matches_color = true
                    endif
                endcase

                if matches_color
                  if swatch_fallback_variant == blank
                    assign swatch_fallback_variant = variant
                  endif

                  if variant.available
                    assign swatch_variant = variant
                    break
                  endif
                endif
              endfor

              if swatch_variant == blank
                assign swatch_variant = swatch_fallback_variant
              endif

              assign swatch_color = blank

              capture swatch_color
                render 'custom-variant-swatch-color', swatch_value: value
              endcapture
            %}
            
            {% if swatch_variant != blank %}
              <button
                type="button"
                class="custom-slider-product-card__swatch{% if color_option.selected_value == value %} is-active{% endif %}{% unless swatch_variant.available %} is-unavailable{% endunless %}"
                data-card-swatch
                data-variant-id="{{ swatch_variant.id }}"
                data-price="{{ swatch_variant.price }}"
                data-compare-price="{{ swatch_variant.compare_at_price | default: 0 }}"
                data-available="{{ swatch_variant.available }}"
                data-image="{% if swatch_variant.featured_image %}{{ swatch_variant.featured_image | image_url: width: 1200 }}{% endif %}"
                aria-label="{{ value | escape }}"
                aria-pressed="{% if color_option.selected_value == value %}true{% else %}false{% endif %}"
                title="{{ value | escape }}"
                {% unless swatch_variant.available %}aria-disabled="true"{% endunless %}
              >
                {% if block.settings.color_swatch_type == 'image' %}
                  {% if swatch_variant.featured_image %}
                    {{
                      swatch_variant.featured_image
                      | image_url: width: 100
                      | image_tag: loading: 'lazy', alt: value, class: 'custom-slider-product-card__swatch-image'
                    }}
                  {% else %}
                    {% render 'custom-variant-swatch-image', product: product, swatch_value: value %}
                  {% endif %}
                {% else %}
                  <span
                    class="custom-slider-product-card__swatch-color"
                    style="--card-swatch-color: {{ swatch_color | strip }};"
                    aria-hidden="true"
                  ></span>
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}



      {% if product.featured_image != blank %}
        {% if image_link %}
          <a
            href="{{ product.url }}"
            class="custom-slider-product-card__image-link"
            aria-label="{{ product.title | escape }}"
          >
        {% endif %}

          {{
            product.featured_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900, 1200',
              class: 'custom-slider-product-card__image custom-slider-product-card__image--primary',
              alt: product.featured_image.alt | default: product.title
          }}

          {% if show_secondary_image and second_image != blank %}
            {{
              second_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1200',
                class: 'custom-slider-product-card__image custom-slider-product-card__image--secondary',
                alt: second_image.alt | default: product.title
            }}
          {% endif %}

        {% if image_link %}
          </a>
        {% endif %}

      {% else %}

        <div class="custom-slider-product-card__image-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>

      {% endif %}


      {%- comment -%}
      PRODUCT BADGE
      {%- endcomment -%}

      {% if show_badge %}

        {% if product.available == false %}

          <span class="custom-slider-product-card__badge">
            Sold Out
          </span>

        {% elsif product.compare_at_price > product.price %}

          <span class="custom-slider-product-card__badge">
            Sale
          </span>

        {% endif %}

      {% endif %}


      {%- comment -%}
      WISHLIST
      {%- endcomment -%}

      {% if show_wishlist %}

        <button
          type="button"
          class="custom-slider-product-card__wishlist"
          aria-label="Add {{ product.title | escape }} to wishlist"
          data-wishlist-product="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

      {% endif %}

    </div>

  {% endif %}


  {%- comment -%}
  =========================================================
  PRODUCT CONTENT
  =========================================================
  {%- endcomment -%}

  <div class="custom-slider-product-card__content">


    {% if show_vendor and product.vendor != blank %}

      <div class="custom-slider-product-card__vendor">
        {{ product.vendor }}
      </div>

    {% endif %}


    {% if show_title %}

      <h3 class="custom-slider-product-card__title">

        <a href="{{ product.url }}">
          {{ product.title }}
        </a>

      </h3>

    {% endif %}


    {% if show_description and product.description != blank %}

      <div class="custom-slider-product-card__description">
        {{ product.description | strip_html | truncate: 120 }}
      </div>

    {% endif %}


    {% if show_price %}

      <div class="custom-slider-product-card__price">
        <span
          class="custom-slider-product-card__price-current"
          data-card-price
        >
          {% if product.price_varies %}
            From {{ product.price_min | money }}
          {% else %}
            {{ current_variant.price | money }}
          {% endif %}
        </span>

        <span
          class="custom-slider-product-card__price-compare"
          data-card-compare-price
          {% unless current_variant.compare_at_price > current_variant.price %}
            hidden
          {% endunless %}
        >
          {% if current_variant.compare_at_price > current_variant.price %}
            {{ current_variant.compare_at_price | money }}
          {% endif %}
        </span>
      </div>

    {% endif %}


    {% if show_button %}

      {% if product.available %}

        <a
          href="{{ product.url }}"
          class="custom-slider-product-card__button custom-slider-product-card__button--{{ button_style }}"
        >
          {{ button_text }}
        </a>

      {% else %}

        <span
          class="custom-slider-product-card__button custom-slider-product-card__button--disabled"
        >
          Sold Out
        </span>

      {% endif %}

    {% endif %}

  </div>

</article>

<style>

.custom-slider-product-card {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;

  border-radius: var(--slider-card-radius, 12px);
  overflow: hidden;

  background: {{ block.settings.card_background | default: '#ffffff' }};
}


.custom-slider-product-card__media {
  position: relative;
  width: 100%;

  aspect-ratio: var(
    --child-aspect-ratio,
    var(--slider-aspect-ratio, 1 / 1)
  );

  overflow: hidden;

  border-radius: var(
    --child-image-radius,
    var(--slider-image-radius, 12px)
  );
  isolation: isolate;
}


.custom-slider-product-card__image-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}


.custom-slider-product-card__image {
  width: 100%;
  height: 100%;

  aspect-ratio: var(
    --child-aspect-ratio,
    var(--slider-aspect-ratio, 1 / 1)
  );

  object-fit: var(
    --child-image-fit,
    var(--slider-image-fit, cover)
  );
  object-position: center;
  border-radius: var(
    --child-image-radius,
    var(--slider-image-radius, 12px)
  );

  display: block;

  transition:
    opacity .35s ease,
    transform .4s ease;
}

.custom-slider-product-card__image--primary {
  opacity: 1;
}

.custom-slider-product-card__image--secondary {
  position: absolute;
  inset: 0;

  opacity: 0;
}

@media (hover: hover) and (pointer: fine) {
  .custom-slider-product-card__media:hover
  .custom-slider-product-card__image--primary {
    opacity: 0;
  }

  .custom-slider-product-card__media:hover
  .custom-slider-product-card__image--secondary {
    opacity: 1;
  }
}

.custom-slider-product-card__media:hover
.custom-slider-product-card__image--primary {

  {% if show_hover_image and second_image != blank %}
    opacity: 0;
  {% endif %}

}


.custom-slider-product-card__media:hover
.custom-slider-product-card__image--secondary {

  {% if show_hover_image and second_image != blank %}
    opacity: 1;
  {% endif %}

}


.custom-slider-product-card__image-link {
  display: block;
  width: 100%;
  height: 100%;
}


.custom-slider-product-card__image-placeholder {
  width: 100%;
  height: 100%;

  aspect-ratio: var(
    --child-aspect-ratio,
    var(--slider-aspect-ratio, 1 / 1)
  );

  overflow: hidden;
}


.custom-slider-product-card__image-placeholder svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* =============  BADGES =================== */

.custom-slider-product-card__media {
  position: relative;
  isolation: isolate;
}

.custom-slider-product-card__swatches {
  position: absolute;
  z-index: 7;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  max-width: calc(100% - 20px);
  padding: 5px;
  border-radius: 20px;
  background: rgb(255 255 255 / 85%);
}

.custom-slider-product-card__swatch {
  display: block;
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  padding: 2px;
  overflow: hidden;
  border: 1px solid #c8c8c8;
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
}

.custom-slider-product-card__swatches--top-left {
  top: 12px;
  left: 12px;
   bottom: auto;
}

.custom-slider-product-card__swatches--top-right {
  top: 12px;
  right: 12px;
}

.custom-slider-product-card__swatches--bottom-left {
  bottom: 12px;
  left: 12px;
}

.custom-slider-product-card__swatches--bottom-right {
  right: 12px;
  bottom: 12px;
}



.custom-slider-product-card__swatch--square,
.custom-slider-product-card__swatches--square .custom-slider-product-card__swatch {
  border-radius: 4px;
}

.custom-slider-product-card__swatch.is-active {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.custom-slider-product-card__swatch.is-unavailable {
  opacity: 0.4;
  cursor: not-allowed;
}

.custom-slider-product-card__swatch-color,
.custom-slider-product-card__swatch-image,
.custom-slider-product-card__swatch img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.custom-slider-product-card__swatch-color {
  background: var(--card-swatch-color, #ddd);
}

.custom-slider-product-card__swatch-image,
.custom-slider-product-card__swatch img {
  object-fit: cover;
}

/* =====================================================
   BADGES
===================================================== */

.custom-slider-product-card__badges {
  position: absolute;

  top: 12px;
  left: 12px;

  display: flex;
  flex-direction: column;
  gap: 6px;

  z-index: 5;
}


.custom-slider-product-card__badge {
  display: inline-flex;
  align-items: center;

  width: fit-content;

  padding: 5px 9px;

  font-size: 12px;
  line-height: 1;

  border-radius: 4px;

  background: {{ block.settings.badge_background | default: '#000000' }};
  color: {{ block.settings.badge_color | default: '#ffffff' }};
}


.custom-slider-product-card__badge--sale {
  background: {{ block.settings.sale_badge_background | default: '#d32f2f' }};
}


.custom-slider-product-card__badge--sold-out {
  background: {{ block.settings.sold_out_badge_background | default: '#555555' }};
}


/* =====================================================
   WISHLIST
===================================================== */

.custom-slider-product-card__wishlist {
  position: absolute;

  top: 12px;
  right: 12px;

  z-index: 6;

  width: 38px;
  height: 38px;

  padding: 8px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 0;
  border-radius: 50%;

  cursor: pointer;

  background: {{ block.settings.wishlist_background | default: '#ffffff' }};
  color: {{ block.settings.wishlist_color | default: '#111111' }};

  transition:
    background .25s ease,
    color .25s ease,
    transform .25s ease;
}


.custom-slider-product-card__wishlist:hover {
  background: {{ block.settings.wishlist_hover_background | default: '#111111' }};
  color: {{ block.settings.wishlist_hover_color | default: '#ffffff' }};

  transform: scale(1.05);
}


.custom-slider-product-card__wishlist.is-active {
  background: {{ block.settings.wishlist_active_background | default: '#111111' }};
  color: {{ block.settings.wishlist_active_color | default: '#ffffff' }};
}


.custom-slider-product-card__wishlist-icon {
  width: 100%;
  height: 100%;
  display: block;
}


/* =====================================================
   QUICK BUTTON
===================================================== */

.custom-slider-product-card__quick-button {
  position: absolute;

  left: 12px;
  right: 12px;
  bottom: 12px;

  z-index: 5;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 10px 14px;

  text-decoration: none;

  font-size: 13px;
  line-height: 1.2;

  background: {{ block.settings.quick_button_background | default: '#ffffff' }};
  color: {{ block.settings.quick_button_color | default: '#111111' }};

  border-radius: 6px;

  opacity: 0;
  transform: translateY(8px);

  transition:
    opacity .25s ease,
    transform .25s ease;
}


.custom-slider-product-card__media:hover
.custom-slider-product-card__quick-button {
  opacity: 1;
  transform: translateY(0);
}


/* =====================================================
   CONTENT
===================================================== */

.custom-slider-product-card__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  padding: {{ block.settings.card_content_spacing | default: 16 }}px;
}


.custom-slider-product-card__vendor {
  margin-bottom: 6px;

  font-size: 12px;
  line-height: 1.3;

  color: {{ block.settings.vendor_color | default: '#777777' }};
}


.custom-slider-product-card__title {
  margin: 0 0 8px;

  font-size: {{ block.settings.title_size | default: 18 }}px;
  line-height: 1.3;

  font-weight: 600;
}


.custom-slider-product-card__title a {
  color: inherit;
  text-decoration: none;
}


.custom-slider-product-card__title a:hover {
  text-decoration: underline;
}


.custom-slider-product-card__description {
  margin-bottom: 10px;

  font-size: 14px;
  line-height: 1.5;

  color: {{ block.settings.description_color | default: '#666666' }};
}


.custom-slider-product-card__price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;

  margin-bottom: 14px;

  line-height: 1.3;
}


.custom-slider-product-card__current-price {
  font-size: {{ block.settings.price_size | default: 17 }}px;
  font-weight: 600;

  color: {{ block.settings.price_color | default: '#111111' }};
}


.custom-slider-product-card__compare-price {
  font-size: 14px;

  color: {{ block.settings.compare_price_color | default: '#888888' }};

  text-decoration: line-through;
}


/* =====================================================
   ADD TO CART
===================================================== */

.custom-slider-product-card__actions {
  width: 100%;
}


.custom-slider-product-card__product-form,
.custom-slider-product-card__form {
  width: 100%;
}


.custom-slider-product-card__button {
  width: 100%;

  min-height: 44px;

  padding: 10px 16px;

  border: 0;
  border-radius: {{ block.settings.button_radius | default: 6 }}px;

  background: {{ block.settings.button_background | default: '#111111' }};
  color: {{ block.settings.button_color | default: '#ffffff' }};

  font-size: 14px;
  line-height: 1.2;
  font-weight: 600;

  cursor: pointer;

  transition:
    background .25s ease,
    color .25s ease;
}


.custom-slider-product-card__button:hover {
  background: {{ block.settings.button_hover_background | default: '#333333' }};
  color: {{ block.settings.button_hover_color | default: '#ffffff' }};
}


.custom-slider-product-card__button--disabled {
  opacity: .55;
  cursor: not-allowed;
}


/* =====================================================
   INVENTORY
===================================================== */

.custom-slider-product-card__inventory {
  width: 100%;

  margin-top: 8px;

  font-size: 12px;
  line-height: 1.3;

  color: {{ block.settings.inventory_color | default: '#4a7c59' }};
}


/* =====================================================
   ACCESSIBILITY
===================================================== */

.custom-slider-product-card .visually-hidden {
  position: absolute !important;

  width: 1px !important;
  height: 1px !important;

  padding: 0 !important;
  margin: -1px !important;

  overflow: hidden !important;

  clip: rect(0, 0, 0, 0) !important;

  white-space: nowrap !important;

  border: 0 !important;
}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  .custom-slider-product-card__content {
    padding: {{ block.settings.mobile_content_spacing | default: 12 }}px;
  }

  .custom-slider-product-card__title {
    font-size: {{ block.settings.mobile_title_size | default: 16 }}px;
  }

  .custom-slider-product-card__current-price {
    font-size: {{ block.settings.mobile_price_size | default: 16 }}px;
  }

  .custom-slider-product-card__quick-button {
    opacity: 1;
    transform: none;
  }

}



 @media screen and (max-width: 749px) {

 /* Mobile: reposition product color swatches */
  /*.custom-slider-product-card__media {
    position: relative;
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__swatches {
    position: absolute !important;

    top: auto !important;
    right: auto !important;
    bottom: 8px !important;
    left: 8px !important;

    z-index: 7;
    display: flex;
    align-items: center;
    gap: 5px;

    max-width: calc(100% - 60px);
    padding: 4px;
    margin: 0;

    box-sizing: border-box;
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__swatch {
    flex: 0 0 21px;
    width: 21px;
    height: 21px;
  }*/

  .custom-slider-product-card__media
  .custom-slider-product-card__swatches {
    top: 5px !important;
    left: 5px !important;
    right: auto !important;
    bottom: auto !important;

    gap: 4px;
    padding: 3px;
    max-width: calc(100% - 45px);
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__swatch {
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    padding: 1px;
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__wishlist {
    top: 5px;
    right: 5px;

    width: 28px;
    height: 28px;
    padding: 6px;

    z-index: 8;
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__wishlist svg {
    width: 100%;
    height: 100%;
  }

} 

</style>


<script>
(function() {

  const productCard = document.querySelector(
    '[data-product-id="{{ product.id }}"]'
  );

  if (!productCard) return;

  const wishlistButton = productCard.querySelector(
    '[data-wishlist-button]'
  );

  if (!wishlistButton) return;


  /*
   * ================================================
   * SIMPLE LOCAL STORAGE WISHLIST
   * ================================================
   *
   * This intentionally does not depend on a third-party
   * wishlist app.
   *
   * Later we can replace this with:
   *
   * - Shopify customer account wishlist
   * - Wishlist app integration
   * - Metaobject-based wishlist
   * - Custom AJAX wishlist
   *
   * without changing the product card structure.
   */

  const storageKey = 'custom_slider_wishlist';

  function getWishlist() {

    try {

      return JSON.parse(
        localStorage.getItem(storageKey)
      ) || [];

    } catch (error) {

      return [];

    }

  }


  function saveWishlist(items) {

    try {

      localStorage.setItem(
        storageKey,
        JSON.stringify(items)
      );

    } catch (error) {

      console.warn(
        'Wishlist could not be saved.',
        error
      );

    }

  }


  function updateWishlistState() {

    const wishlist = getWishlist();

    const productId = String(
      wishlistButton.dataset.productId
    );

    const isActive = wishlist.includes(productId);

    wishlistButton.classList.toggle(
      'is-active',
      isActive
    );

    wishlistButton.setAttribute(
      'aria-pressed',
      isActive ? 'true' : 'false'
    );

  }


  wishlistButton.addEventListener(
    'click',
    function() {

      const wishlist = getWishlist();

      const productId = String(
        wishlistButton.dataset.productId
      );

      const existingIndex =
        wishlist.indexOf(productId);


      if (existingIndex === -1) {

        wishlist.push(productId);

      } else {

        wishlist.splice(
          existingIndex,
          1
        );

      }


      saveWishlist(wishlist);

      updateWishlistState();

    }
  );


  updateWishlistState();

})();
</script>