{% liquid
  assign show_product_button = block.settings.show_product_button
  assign button_text = block.settings.button_text | default: 'Add to Cart'
  assign button_style = block.settings.button_style | default: 'solid'
  assign quick_add_option = block.settings.quick_add_option | default: 'normal'

  assign show_image = block.settings.show_image
  assign image_link = block.settings.image_link

  assign show_title = block.settings.show_title
  assign show_description = block.settings.show_description
  assign show_vendor = block.settings.show_vendor

  assign show_badge = block.settings.show_badge
  assign show_wishlist = block.settings.show_wishlist
  assign show_price = block.settings.show_price
  assign show_compare_price = block.settings.show_compare_price

  
  assign button_text = block.settings.button_text
  assign button_style = block.settings.button_style

  assign current_variant = product.selected_or_first_available_variant

  assign show_secondary_image = block.settings.show_secondary_image
  assign second_image = product.images[1]
  assign quick_add_option = block.settings.quick_add_option | default: 'none'
  assign show_button = block.settings.show_add_to_cart

  assign color_option_name = block.settings.color_option_name | default: 'Kleur' | strip | downcase
assign color_option = blank

for option in product.options_with_values
  assign normalized_option_name = option.name | strip | downcase

  if normalized_option_name == color_option_name or normalized_option_name == 'kleur'
    assign color_option = option
    break
  endif
endfor
%}


<article
  class="custom-slider-product-card"
  data-product-id="{{ product.id }}"
  data-selected-variant-id="{{ current_variant.id }}"
  data-product-handle="{{ product.handle }}"
>

  {%- comment -%}===========  PRODUCT MEDIA  ===============  {%- endcomment -%}

  {% if show_image %}

    <div class="custom-slider-product-card__media">

               
      {% if block.settings.show_color_swatches and color_option != blank %}
        <div
          class="custom-slider-product-card__swatches custom-slider-product-card__swatches--{{ block.settings.color_swatch_position }} custom-slider-product-card__swatches--{{ block.settings.color_swatch_shape }}"
          role="group"
          aria-label="{{ color_option.name | escape }} options"
        >
          {% for value in color_option.values %}
            {% liquid
              assign swatch_variant = blank
              assign swatch_fallback_variant = blank

              for variant in product.variants
                assign matches_color = false

                case color_option.position
                  when 1
                    if variant.option1 == value
                      assign matches_color = true
                    endif
                  when 2
                    if variant.option2 == value
                      assign matches_color = true
                    endif
                  when 3
                    if variant.option3 == value
                      assign matches_color = true
                    endif
                endcase

                if matches_color
                  if swatch_fallback_variant == blank
                    assign swatch_fallback_variant = variant
                  endif

                  if variant.available
                    assign swatch_variant = variant
                    break
                  endif
                endif
              endfor

              if swatch_variant == blank
                assign swatch_variant = swatch_fallback_variant
              endif

              assign swatch_color = blank

              capture swatch_color
                render 'custom-variant-swatch-color', swatch_value: value
              endcapture
            %}

            {% if swatch_variant != blank %}
              <button
                type="button"
                class="custom-slider-product-card__swatch{% if color_option.selected_value == value %} is-active{% endif %}{% unless swatch_variant.available %} is-unavailable{% endunless %}"
                data-card-swatch
                data-variant-id="{{ swatch_variant.id }}"
                data-option-value="{{ value | escape }}"
                data-color-option-position="{{ color_option.position }}"
                data-option1="{{ swatch_variant.option1 | escape }}"
                data-option2="{{ swatch_variant.option2 | escape }}"
                data-option3="{{ swatch_variant.option3 | escape }}"
                data-price="{{ swatch_variant.price }}"
                data-price-formatted="{{ swatch_variant.price | money | escape }}"
                data-compare-price="{{ swatch_variant.compare_at_price | default: 0 }}"
                data-compare-price-formatted="{% if swatch_variant.compare_at_price > swatch_variant.price %}{{ swatch_variant.compare_at_price | money | escape }}{% endif %}"
                data-available="{{ swatch_variant.available }}"
                data-inventory-management="{{ swatch_variant.inventory_management | escape }}"
                data-inventory-policy="{{ swatch_variant.inventory_policy | escape }}"
                data-inventory-quantity="{{ swatch_variant.inventory_quantity | default: 0 }}"
                data-image="{% if swatch_variant.featured_image %}{{ swatch_variant.featured_image | image_url: width: 1200 }}{% endif %}"
                aria-label="{{ value | escape }}"
                aria-pressed="{% if color_option.selected_value == value %}true{% else %}false{% endif %}"
                title="{{ value | escape }}"
                {% unless swatch_variant.available %}
                  aria-disabled="true"
                {% endunless %}
              >
                {% if block.settings.color_swatch_type == 'image' %}
                  {% if swatch_variant.featured_image %}
                    {{
                      swatch_variant.featured_image
                      | image_url: width: 100
                      | image_tag:
                        loading: 'lazy',
                        alt: value,
                        class: 'custom-slider-product-card__swatch-image'
                    }}
                  {% else %}
                    {% render 'custom-variant-swatch-image',
                      product: product,
                      swatch_value: value
                    %}
                  {% endif %}
                {% else %}
                  <span
                    class="custom-slider-product-card__swatch-color"
                    style="--card-swatch-color: {{ swatch_color | strip }};"
                    aria-hidden="true"
                  ></span>
                {% endif %}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}




      {% if product.featured_image != blank %}
        {% if image_link %}
          <a
            href="{{ product.url }}"
            class="custom-slider-product-card__image-link"
            aria-label="{{ product.title | escape }}"
          >
        {% endif %}

          {{
            product.featured_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '360, 540, 720, 900, 1200',
              class: 'custom-slider-product-card__image custom-slider-product-card__image--primary',
              alt: product.featured_image.alt | default: product.title
          }}

          {% if show_secondary_image and second_image != blank %}
            {{
              second_image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '360, 540, 720, 900, 1200',
                class: 'custom-slider-product-card__image custom-slider-product-card__image--secondary',
                alt: second_image.alt | default: product.title
            }}
          {% endif %}

        {% if image_link %}
          </a>
        {% endif %}

      {% else %}

        <div class="custom-slider-product-card__image-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>

      {% endif %}


      {%- comment -%}    PRODUCT BADGE  {%- endcomment -%}

      {% if show_badge %}

        {% if product.available == false %}

          <span class="custom-slider-product-card__badge">
            Sold Out
          </span>

        {% elsif product.compare_at_price > product.price %}

          <span class="custom-slider-product-card__badge">
            Sale
          </span>

        {% endif %}

      {% endif %}


      {%- comment -%}     WISHLIST   {%- endcomment -%}

      {% if show_wishlist %}

        <button
          type="button"
          class="custom-slider-product-card__wishlist"
          aria-label="Add {{ product.title | escape }} to wishlist"
          data-wishlist-button
          data-product-id="{{ product.id }}"
          data-wishlist-product="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          aria-pressed="false"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>

      {% endif %}

    </div>

  {% endif %}


  {%- comment -%} ============== PRODUCT CONTENT =============== {%- endcomment -%}

  <div class="custom-slider-product-card__content">

    {% if show_vendor and product.vendor != blank %}

      <div class="custom-slider-product-card__vendor">
        {{ product.vendor }}
      </div>

    {% endif %}

    {% if show_title %}

      <h3 class="custom-slider-product-card__title">
        <a href="{{ product.url }}">
          {{ product.title }}
        </a>
      </h3>

    {% endif %}

    {% if show_description and product.description != blank %}

      <div class="custom-slider-product-card__description">
        {{ product.description | strip_html | truncate: 120 }}
      </div>

    {% endif %}


    {% if show_price %}

      <div class="custom-slider-product-card__price">
        <span class="custom-slider-product-card__price-current"
          data-card-price>
          {% if product.price_varies %}
            From {{ product.price_min | money }}
          {% else %}
            {{ current_variant.price | money }}
          {% endif %}
        </span>

        <span
          class="custom-slider-product-card__price-compare"
          data-card-compare-price
          {% unless current_variant.compare_at_price > current_variant.price %}
            hidden
          {% endunless %}
        >
          {% if current_variant.compare_at_price > current_variant.price %}
            {{ current_variant.compare_at_price | money }}
          {% endif %}
        </span>
      </div>

    {% endif %}

      {% if show_product_button %}
        <div class="custom-slider-product-card__actions">

          {% case quick_add_option %}

            {% when 'normal' %}

              {% if product.available and product.has_only_default_variant %}
                <form
                  action="{{ routes.cart_add_url }}"
                  method="post"
                  accept-charset="UTF-8"
                  class="custom-slider-product-card__form"
                >
                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <input type="hidden" name="quantity" value="1">

                  <button
                    type="submit"
                    class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
                  >
                    {{ button_text | escape }}
                  </button>
                </form>

              {% elsif product.available %}
                <a
                  href="{{ product.url }}"
                  class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
                >
                  Choose Options
                </a>

              {% else %}
                <button
                  type="button"
                  class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
                  disabled
                >
                  Sold Out
                </button>
              {% endif %}


            {% when 'standard' %}

              {% if product.available and product.has_only_default_variant %}
                <form
                  action="{{ routes.cart_add_url }}"
                  method="post"
                  accept-charset="UTF-8"
                  class="custom-slider-product-card__form"
                  data-quick-add-mode="standard"
                >
                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <input type="hidden" name="quantity" value="1">

                  <button
                    type="submit"
                    class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
                  >
                    {{ button_text | escape }}
                  </button>
                </form>

              {% elsif product.available %}
                <a
                  href="{{ product.url }}"
                  class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
                >
                  Choose Options
                </a>

              {% else %}
                <button
                  type="button"
                  class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
                  disabled
                >
                  Sold Out
                </button>
              {% endif %}


            
{% when 'bulk' %}
  {% if product.available %}
    {% assign inline_bulk_controls = block.settings.bulk_quantity_button_inline %}

    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      accept-charset="UTF-8"
      class="custom-slider-product-card__form custom-slider-product-card__form--bulk{% if inline_bulk_controls %} custom-slider-product-card__form--inline{% endif %}"
      data-quick-add-mode="bulk"
      data-product-id="{{ product.id }}"
    >
      <label
        class="custom-slider-product-card__field-label"
        for="SliderVariant-{{ block.id }}-{{ product.id }}"
      >
        Select variant
      </label>

      <select
        id="SliderVariant-{{ block.id }}-{{ product.id }}"
        name="id"
        required
      >
        {% for variant in product.variants %}
          {% if variant.available %}
            <option
              value="{{ variant.id }}"
              {% if variant.id == current_variant.id %}selected{% endif %}
            >
              {{ variant.title | escape }} — {{ variant.price | money }}
            </option>
          {% endif %}
        {% endfor %}
      </select>

      <div class="custom-slider-product-card__bulk-controls">
        <div class="custom-slider-product-card__quantity-control">
          <label
            class="custom-slider-product-card__field-label"
            for="SliderQuantity-{{ block.id }}-{{ product.id }}"
          >
            Quantity
          </label>

          <input
            id="SliderQuantity-{{ block.id }}-{{ product.id }}"
            type="number"
            name="quantity"
            value="1"
            min="1"
            step="1"
            required
          >
        </div>

        <button
          type="submit"
          class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
        >
          <span>{{ button_text | escape }}</span>
          <span class="loading__spinner hidden" aria-hidden="true">
            <svg class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle
                class="path"
                fill="none"
                stroke-width="6"
                cx="33"
                cy="33"
                r="30"
              ></circle>
            </svg>
          </span>
        </button>
      </div>
    </form>
  {% else %}
    <button
      type="button"
      class="custom-slider-button custom-slider-button--{{ button_style }} custom-slider-product-card__button"
      disabled
    >
      Sold Out
    </button>
  {% endif %}


          {% endcase %}
        </div>
      {% endif %}
    
  </div>

</article>

<style>

.custom-slider-product-card {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;

  border-radius: var(--slider-card-radius, 12px);
  overflow: hidden;

  background: {{ block.settings.card_background | default: '#ffffff' }};
}


.custom-slider-product-card__media {
  position: relative;
  width: 100%;
  aspect-ratio: var(
    --child-aspect-ratio,
    var(--slider-aspect-ratio, 1 / 1)
  );
  overflow: hidden;
  border-radius: var(
    --child-image-radius,
    var(--slider-image-radius, 12px)
  );
  isolation: isolate;
}

.custom-slider-product-card__image-link {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.custom-slider-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: var(
    --child-image-fit,
    var(--slider-image-fit, cover)
  );
  object-position: center;
  border-radius: var(
    --child-image-radius,
    var(--slider-image-radius, 12px)
  );
  transition: opacity .35s ease, transform .4s ease;
}

.custom-slider-product-card__image--primary {
  position: relative;
  opacity: 1;
}

.custom-slider-product-card__image--secondary {
  position: absolute;
  inset: 0;
  opacity: 0;
  pointer-events: none;
}

/* Hover image only on devices with a real hover pointer */
@media (hover: hover) and (pointer: fine) {
  .custom-slider-product-card__media:hover
  .custom-slider-product-card__image--primary {
    opacity: 0;
  }

  .custom-slider-product-card__media:hover
  .custom-slider-product-card__image--secondary {
    opacity: 1;
  }
}

.custom-slider-product-card__image-placeholder {
  width: 100%;
  height: 100%;
  overflow: hidden;
  aspect-ratio: var(
    --child-aspect-ratio,
    var(--slider-aspect-ratio, 1 / 1)
  );
}

.custom-slider-product-card__image-placeholder svg {
  display: block;
  width: 100%;
  height: 100%;
}

/* =============  BADGES =================== */

.custom-slider-product-card__media {
  position: relative;
  isolation: isolate;
}

.custom-slider-product-card__swatches {
  position: absolute;
  z-index: 7;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 7px;
  max-width: calc(100% - 20px);
  padding: 5px;
  border-radius: 20px;
  background: rgb(255 255 255 / 85%);
}

.custom-slider-product-card__swatch {
  display: block;
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  padding: 2px;
  overflow: hidden;
  border: 1px solid #c8c8c8;
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
}

.custom-slider-product-card__swatches--top-left {
  top: 12px;
  left: 12px;
   bottom: auto;
}

.custom-slider-product-card__swatches--top-right {
  top: 12px;
  right: 12px;
}

.custom-slider-product-card__swatches--bottom-left {
  bottom: 12px;
  left: 12px;
}

.custom-slider-product-card__swatches--bottom-right {
  right: 12px;
  bottom: 12px;
}



.custom-slider-product-card__swatch--square,
.custom-slider-product-card__swatches--square .custom-slider-product-card__swatch {
  border-radius: 4px;
}

.custom-slider-product-card__swatch.is-active {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.custom-slider-product-card__swatch.is-unavailable {
  opacity: 0.4;
  cursor: not-allowed;
}

.custom-slider-product-card__swatch-color,
.custom-slider-product-card__swatch-image,
.custom-slider-product-card__swatch img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: inherit;
}

.custom-slider-product-card__swatch-color {
  background: var(--card-swatch-color, #ddd);
}

.custom-slider-product-card__swatch-image,
.custom-slider-product-card__swatch img {
  object-fit: cover;
}

/* =====================================================
   PRICE
===================================================== */

.custom-slider-product-card__price-current {
  font-size: {{ block.settings.price_size | default: 17 }}px;
  font-weight: 600;
  color: {{ block.settings.price_color | default: '#111111' }};
}

.custom-slider-product-card__price-compare {
  font-size: 14px;
  color: {{ block.settings.compare_price_color | default: '#888888' }};
  text-decoration: line-through;
}

/* =====================================================
   BADGES
===================================================== */

.custom-slider-product-card__badges {
  position: absolute;

  top: 12px;
  left: 12px;

  display: flex;
  flex-direction: column;
  gap: 6px;

  z-index: 5;
}


.custom-slider-product-card__badge {
  display: inline-flex;
  align-items: center;

  width: fit-content;

  padding: 5px 9px;

  font-size: 12px;
  line-height: 1;

  border-radius: 4px;

  background: {{ block.settings.badge_background | default: '#000000' }};
  color: {{ block.settings.badge_color | default: '#ffffff' }};
}


.custom-slider-product-card__badge--sale {
  background: {{ block.settings.sale_badge_background | default: '#d32f2f' }};
}


.custom-slider-product-card__badge--sold-out {
  background: {{ block.settings.sold_out_badge_background | default: '#555555' }};
}


/* =====================================================
   WISHLIST
===================================================== */

.custom-slider-product-card__wishlist {
  position: absolute;

  top: 12px;
  right: 12px;

  z-index: 6;

  width: 38px;
  height: 38px;

  padding: 8px;

  display: flex;
  align-items: center;
  justify-content: center;

  border: 0;
  border-radius: 50%;

  cursor: pointer;

  background: {{ block.settings.wishlist_background | default: '#ffffff' }};
  color: {{ block.settings.wishlist_color | default: '#111111' }};

  transition: background-color .25s ease, color .25s ease;
}


.custom-slider-product-card__wishlist:hover {
  background: {{ block.settings.wishlist_hover_background | default: '#111111' }};
  color: {{ block.settings.wishlist_hover_color | default: '#ffffff' }};

  transform: scale(1.05);
}


.custom-slider-product-card__wishlist.is-active {
  background: {{ block.settings.wishlist_active_background | default: '#111111' }};
  color: {{ block.settings.wishlist_active_color | default: '#ffffff' }};
}


.custom-slider-product-card__wishlist-icon {
  width: 100%;
  height: 100%;
  display: block;
}


/* =====================================================
   QUICK BUTTON
===================================================== */

.custom-slider-product-card__product-form {
  display: grid;
  gap: 10px;
  width: 100%;
}

.custom-slider-product-card__variant-label,
.custom-slider-product-card__quantity-label {
  display: grid;
  gap: 6px;
  width: 100%;
  font-size: 13px;
}

.custom-slider-product-card__variant-label select,
.custom-slider-product-card__quantity-label input {
  box-sizing: border-box;
  width: 100%;
  min-height: 42px;
  padding: 8px 10px;
  border: 1px solid #d5d5d5;
  border-radius: 6px;
  background: #fff;
  color: #111;
  font: inherit;
}

.custom-slider-product-card__button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  padding: 10px 16px;
  border: 0;
  border-radius: {{ block.settings.button_radius | default: 6 }}px;
  background: {{ block.settings.button_background | default: '#111111' }};
  color: {{ block.settings.button_color | default: '#ffffff' }};
  font-size: 14px;
  line-height: 1.2;
  font-weight: 600;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
}

.custom-slider-product-card__button:hover {
  background: {{ block.settings.button_hover_background | default: '#333333' }};
  color: {{ block.settings.button_hover_color | default: '#ffffff' }};
}

.custom-slider-product-card__button--disabled {
  opacity: .55;
  cursor: not-allowed;
}

/* =====================================================
   CONTENT
===================================================== */

.custom-slider-product-card__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;

  padding: {{ block.settings.card_content_spacing | default: 16 }}px;
}


.custom-slider-product-card__vendor {
  margin-bottom: 6px;

  font-size: 12px;
  line-height: 1.3;

  color: {{ block.settings.vendor_color | default: '#777777' }};
}


.custom-slider-product-card__title {
  margin: 0 0 8px;

  font-size: {{ block.settings.title_size | default: 18 }}px;
  line-height: 1.3;

  font-weight: 600;
}


.custom-slider-product-card__title a {
  color: inherit;
  text-decoration: none;
}


.custom-slider-product-card__title a:hover {
  text-decoration: underline;
}


.custom-slider-product-card__description {
  margin-bottom: 10px;

  font-size: 14px;
  line-height: 1.5;

  color: {{ block.settings.description_color | default: '#666666' }};
}


.custom-slider-product-card__price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;

  margin-bottom: 14px;

  line-height: 1.3;
}

.custom-slider-product-card__current-price {
  font-size: {{ block.settings.price_size | default: 17 }}px;
  font-weight: 600;

  color: {{ block.settings.price_color | default: '#111111' }};
}

.custom-slider-product-card__compare-price {
  font-size: 14px;

  color: {{ block.settings.compare_price_color | default: '#888888' }};

  text-decoration: line-through;
}


/* =====================================================
   ADD TO CART
===================================================== */

.custom-slider-product-card__actions {
  width: 100%;
}


.custom-slider-product-card__product-form,
.custom-slider-product-card__form {
  width: 100%;
}


.custom-slider-product-card__button {
  width: 100%;

  min-height: 44px;

  padding: 10px 16px;

  border: 0;
  border-radius: {{ block.settings.button_radius | default: 6 }}px;

  background: {{ block.settings.button_background | default: '#111111' }};
  color: {{ block.settings.button_color | default: '#ffffff' }};

  font-size: 14px;
  line-height: 1.2;
  font-weight: 600;

  cursor: pointer;

  transition: background-color .25s ease, color .25s ease;
}


.custom-slider-product-card__button:hover {
  background: {{ block.settings.button_hover_background | default: '#333333' }};
  color: {{ block.settings.button_hover_color | default: '#ffffff' }};
}


.custom-slider-product-card__button--disabled {
  opacity: .55;
  cursor: not-allowed;
}


/* =====================================================
   INVENTORY
===================================================== */

.custom-slider-product-card__inventory {
  width: 100%;

  margin-top: 8px;

  font-size: 12px;
  line-height: 1.3;

  color: {{ block.settings.inventory_color | default: '#4a7c59' }};
}


/* =====================================================
   ACCESSIBILITY
===================================================== */

.custom-slider-product-card .visually-hidden {
  position: absolute !important;

  width: 1px !important;
  height: 1px !important;

  padding: 0 !important;
  margin: -1px !important;

  overflow: hidden !important;

  clip: rect(0, 0, 0, 0) !important;

  white-space: nowrap !important;

  border: 0 !important;
}


/* =====================================================
   MOBILE
===================================================== */

@media screen and (max-width: 749px) {

  .custom-slider-product-card__content {
    padding: {{ block.settings.mobile_content_spacing | default: 12 }}px;
  }

  .custom-slider-product-card__title {
    font-size: {{ block.settings.mobile_title_size | default: 16 }}px;
  }

  .custom-slider-product-card__current-price {
    font-size: {{ block.settings.mobile_price_size | default: 16 }}px;
  }

  .custom-slider-product-card__quick-button {
    opacity: 1;
    transform: none;
  }

}



 @media screen and (max-width: 749px) {

  .custom-slider-product-card__media
  .custom-slider-product-card__swatches {
    top: 5px !important;
    left: 5px !important;
    right: auto !important;
    bottom: auto !important;

    gap: 4px;
    padding: 3px;
    max-width: calc(100% - 45px);
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__swatch {
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
    padding: 1px;
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__wishlist {
    top: 5px;
    right: 5px;

    width: 28px;
    height: 28px;
    padding: 6px;

    z-index: 8;
  }

  .custom-slider-product-card__media
  .custom-slider-product-card__wishlist svg {
    width: 100%;
    height: 100%;
  }

} 

</style>


<script>

(function () {
  const cards = document.querySelectorAll('.custom-slider-product-card');

  cards.forEach((card) => {
    if (card.dataset.cardInitialized === 'true') return;
    card.dataset.cardInitialized = 'true';

    const swatches = card.querySelectorAll('[data-card-swatch]');
    const variantSelect = card.querySelector('select[name="id"]');
    const quantityInput = card.querySelector('input[name="quantity"]');
    const primaryImage = card.querySelector(
      '.custom-slider-product-card__image--primary'
    );
    const currentPrice = card.querySelector('[data-card-price]');
    const comparePrice = card.querySelector('[data-card-compare-price]');
    const wishlistButton = card.querySelector('[data-wishlist-button]');

    const storageKey = 'custom_slider_wishlist';

    function getWishlist() {
      try {
        return JSON.parse(localStorage.getItem(storageKey)) || [];
      } catch (error) {
        return [];
      }
    }

    function saveWishlist(items) {
      try {
        localStorage.setItem(storageKey, JSON.stringify(items));
      } catch (error) {
        console.warn('Wishlist could not be saved.', error);
      }
    }

    function updateWishlist() {
      if (!wishlistButton) return;

      const productId = String(wishlistButton.dataset.productId);
      const active = getWishlist().includes(productId);

      wishlistButton.classList.toggle('is-active', active);
      wishlistButton.setAttribute('aria-pressed', String(active));
    }

    if (wishlistButton) {
      wishlistButton.addEventListener('click', () => {
        const wishlist = getWishlist();
        const productId = String(wishlistButton.dataset.productId);
        const index = wishlist.indexOf(productId);

        if (index === -1) {
          wishlist.push(productId);
        } else {
          wishlist.splice(index, 1);
        }

        saveWishlist(wishlist);
        updateWishlist();
      });

      updateWishlist();
    }

    function updateQuantityLimit(variant) {
      if (!quantityInput || !variant) return;

      const tracked =
        variant.dataset.inventoryManagement === 'shopify';

      const denyOverselling =
        variant.dataset.inventoryPolicy === 'deny';

      const inventory = Number(variant.dataset.inventoryQuantity);

      if (tracked && denyOverselling) {
        const max = Math.max(0, inventory);

        quantityInput.max = String(max);

        if (max > 0 && Number(quantityInput.value) > max) {
          quantityInput.value = String(max);
        }

        if (max === 0) {
          quantityInput.value = '1';
        }
      } else {
        quantityInput.removeAttribute('max');
      }

      quantityInput.min = '1';
    }

    function updatePrice(variant) {
      if (!variant) return;

      if (currentPrice && variant.dataset.priceFormatted) {
        currentPrice.textContent = variant.dataset.priceFormatted;
      }

      if (comparePrice) {
        const formattedCompare = variant.dataset.comparePriceFormatted || '';

        comparePrice.textContent = formattedCompare;
        comparePrice.hidden = !formattedCompare;
      }
    }

    function updateImage(variant) {
      if (!primaryImage || !variant) return;

      const image = variant.dataset.image;
      if (image) {
        primaryImage.src = image;
      }
    }

    function updateActiveSwatch(variant) {
      if (!variant || !swatches.length) return;

      const optionPosition = Number(variant.dataset.colorOptionPosition);
      const optionValue = variant.dataset[`option${optionPosition}`];

      swatches.forEach((swatch) => {
        const active =
          swatch.dataset.optionValue === optionValue;

        swatch.classList.toggle('is-active', active);
        swatch.setAttribute('aria-pressed', String(active));
      });
    }

    function updateVariant(variant) {
      if (!variant) return;

      card.dataset.selectedVariantId = variant.value;

      updatePrice(variant);
      updateImage(variant);
      updateQuantityLimit(variant);
      updateActiveSwatch(variant);
    }

    if (variantSelect) {
      variantSelect.addEventListener('change', () => {
        const variant = variantSelect.selectedOptions[0];
        updateVariant(variant);
      });

      if (variantSelect.selectedOptions.length) {
        updateVariant(variantSelect.selectedOptions[0]);
      }
    }

    swatches.forEach((swatch) => {
      swatch.addEventListener('click', () => {
        if (swatch.dataset.available !== 'true') return;

        const variantId = swatch.dataset.variantId;

        if (variantSelect) {
          const matchingOption = Array.from(variantSelect.options).find(
            (option) => option.value === variantId
          );

          if (matchingOption) {
            variantSelect.value = variantId;
            updateVariant(matchingOption);
            return;
          }
        }

        // Swatch-only cards without a variant selector.
        card.dataset.selectedVariantId = variantId;

        if (currentPrice && swatch.dataset.priceFormatted) {
          currentPrice.textContent = swatch.dataset.priceFormatted;
        }

        if (comparePrice) {
          const formattedCompare =
            swatch.dataset.comparePriceFormatted || '';

          comparePrice.textContent = formattedCompare;
          comparePrice.hidden = !formattedCompare;
        }

        if (primaryImage && swatch.dataset.image) {
          primaryImage.src = swatch.dataset.image;
        }
      });
    });

    if (quantityInput) {
      quantityInput.addEventListener('change', () => {
        let quantity = Math.max(1, Math.floor(Number(quantityInput.value) || 1));

        if (quantityInput.max !== '') {
          quantity = Math.min(quantity, Number(quantityInput.max));
        }

        quantityInput.value = String(quantity);
      });
    }
  });
})();


</script>