{% liquid

  assign variant = product.selected_or_first_available_variant

  assign current_price = variant.price | default: 0
  assign compare_price = variant.compare_at_price | default: 0

  
  if block.settings.round_price == true
    assign current_price = current_price | divided_by: 100.0 | round | times: 100
    assign compare_price =  compare_price | divided_by: 100.0 | round | times: 100
  endif

    assign on_sale = false
  if compare_price > current_price
    assign on_sale = true 
  endif
  

  assign savings_amount = 0
  assign savings_percentage = 0

  if on_sale
    assign savings_amount = compare_price | minus: current_price

    if compare_price > 0
      assign savings_percentage = savings_amount | times: 100.0 | divided_by: compare_price | round
    endif
  endif


  assign show_current_price = block.settings.show_current_price
  assign show_compare_price = block.settings.show_compare_price
  assign hide_compare_without_discount = block.settings.hide_compare_without_discount
  assign compare_position = block.settings.compare_position
  assign large_price = block.settings.large_price
  assign price_format = block.settings.price_format
  assign compare_full_width = block.settings.compare_full_width
 
%}

{% capture current_price_html %}

{% case price_format %}

  {% when 'money_with_currency' %}
    {{ current_price | money_with_currency }}

  {% when 'money_without_currency' %}
    {{ current_price | money_without_currency }}

  {% when 'money_without_trailing_zeros' %}
    {{ current_price | money_without_trailing_zeros }}

  {% else %}
    {{ current_price | money }}

{% endcase %}

{% endcapture %}


{% capture compare_price_html %} 

    {%  case price_format %} 
    {%  when 'money_with_currency' %}
        {{ compare_price |  money_with_currency }}
    {%  when 'money_without_currency' %}
        {{ compare_price |  money_without_currency }}
    {%  when 'money_without_trailing_zeros' %}
        {{ compare_price |  money_without_trailing_zeros }}
    {%  else %}
        {{ compare_price |  money }}
    {% endcase %}
       
{% endcapture %}


           <div class="custom-price"
                data-product-price-scope data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}"
                data-round-price="{{ block.settings.round_price }}" data-price-format="{{ price_format }}"
                data-show-current-price="{{ show_current_price }}" data-show-compare-price="{{ show_compare_price }}"
                data-hide-compare-without-discount="{{ hide_compare_without_discount }}">

                    {% if show_current_price %}
                        <span class="custom-price__current{% if large_price %} custom-price__current--large{% endif %}"
                        data-product-price>
                            {{ current_price_html }}
                        </span>
                    {% endif %}

                    {% if show_compare_price %} 
                        
                        <span class="custom-price__compare{% if compare_full_width %} compare_full_width{% endif %}"
                        data-compare-price {% if on_sale or hide_compare_without_discount == false %}hidden {% endif %}>
                            {{ compare_price_html }}
                        </span>
            
                    {% endif %}

                    {% comment %}======SAVINGS AMOUNT======== {% endcomment %}
                        <span class="custom-price__savings" data-savings-amount {% unless on_sale %} hidden {% endunless %}>
                            {% if on_sale %}
                                Save {{ savings_amount | money }}
                            {% endif %}
                        </span>

                    {% comment %}======SAVINGS PERCENTAGE======== {% endcomment %}
                         <span class="custom-price__savings-percentage" data-savings-percentage
                            {% unless on_sale %} hidden {% endunless %}>
                                {% if on_sale %}
                                    {{ savings_percentage }}% OFF
                                {% endif %}
                        </span>

                    {% comment %}==== VARIANT DATA This JSON belongs ONLY to this product.
                        JavaScript can therefore find the correct variant without touching another product. {% endcomment %}

                    <script type="application/json" data-product-variants>
                        {{ product.variants | json }}
                    </script>

                </div>


<style>

    .custom-price{
    display:flex;
    align-items:center;
    gap:.6rem;
    flex-wrap:wrap;
}

{% if compare_position %}
.custom-price{
    flex-direction:row-reverse;
    justify-content: flex-end;
}
{% endif %}

.custom-price__current{
    font-size:2.8rem;
    font-weight:700;
    line-height:1.1;
    color:rgb(var(--color-foreground));
}

.custom-price__current--large{
    font-size:3.8rem;
}

.custom-price__compare{
    font-size:1.6rem;
    color:rgba(var(--color-foreground),0.55);
    text-decoration:line-through;
}
.compare_full_width{
    width: 100%;
}

</style>