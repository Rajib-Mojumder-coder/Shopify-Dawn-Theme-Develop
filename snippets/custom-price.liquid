{% if compare_position %}
.custom-price{
    flex-direction: row-reverse;
    justify-content: flex-end;
}
{% endif %}


[data-product-price-scope][data-on-sale="false"] [data-savings-amount],
[data-product-price-scope][data-on-sale="false"] [data-savings-percentage] {
  display: none;
}
</style> {% endcomment %}