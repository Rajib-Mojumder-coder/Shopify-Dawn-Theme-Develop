{% liquid
   
    assign show_navigation_desktop = section.settings.show_navigation_desktop
    assign show_navigation_mobile = section.settings.show_navigation_mobile
    assign icon_type = section.settings.icon_type
    assign prev_icon = section.settings.prev_icon
    assign next_icon = section.settings.next_icon
   %}



{% if show_navigation_desktop or show_navigation_mobile %}

<div class="slider-navigation slider-navigation-{{ section.id }}
    {% unless show_navigation_desktop %}nav-hide-desktop{% endunless %}
    {% unless show_navigation_mobile %}nav-hide-mobile{% endunless %}">


    <div class="swiper-button-next slider-next-{{ section.id }}">

        {% case icon_type %}

                  {% when 'theme_arrow' %}
                    <svg class="nav-icon" viewBox="0 0 24 24"  fill="none" stroke="currentColor"
                      stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18L15 12L9 6"/>
                    </svg>

                  {% when 'image' %}
                    {% if next_icon != blank %}
                      {{ next_icon | image_url: width: 100 | image_tag: class: 'nav-image', loading: 'lazy'}}
                    {% endif %}

                  {% when 'svg_code' %}
                    <div class="nav-svg">
                      {{ section.settings.next_svg }}
                    </div>

                {% endcase %}

    </div>

</div>

{% endif %}

<style>

/* ================================
   CUSTOM NAVIGATION WRAPPER
================================ */

.slider-navigation-{{ section.id }} {

    display:flex;
    align-items:center;
    gap: {{ section.settings.nav_gap }}px;

    z-index:20;

}


/* ================================
   SWIPER DEFAULT ARROW REMOVE
================================ */

.slider-prev-{{ section.id }}::after,
.slider-next-{{ section.id }}::after {

    display:none;

}


/* ================================
   NAVIGATION BUTTON
================================ */

.slider-prev-{{ section.id }},
.slider-next-{{ section.id }} {

    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;

    padding:6px;

    display:flex;
    align-items:center;
    justify-content:center;

    /* background:{{ section.settings.bg_color }};
    color:{{ section.settings.icon_color }}; */

    border-radius:{{ section.settings.border_radius }}px;

    transition:all .3s ease;

}


/* ================================
   HOVER
================================ */

.slider-prev-{{ section.id }}:hover,
.slider-next-{{ section.id }}:hover {

    background:{{ section.settings.hover_bg_color }};
    color:{{ section.settings.hover_icon_color }};

}


/* ================================
   THEME ARROW SVG
================================ */

.slider-prev-{{ section.id }} .nav-icon,
.slider-next-{{ section.id }} .nav-icon {

    width:{{ section.settings.icon_size }}px;
    height:{{ section.settings.icon_size }}px;

    stroke-width:{{ section.settings.stroke_width }};

}


/* ================================
   CUSTOM SVG
================================ */

.slider-prev-{{ section.id }} .nav-svg svg,
.slider-next-{{ section.id }} .nav-svg svg {

    width:{{ section.settings.icon_size }}px;
    height:{{ section.settings.icon_size }}px;

    fill:{{ section.settings.bg_color }};
    stroke: {{ section.settings.icon_color }};

}


.slider-prev-{{ section.id }} .nav-svg svg {

    rotate:180deg;

} 


/* ================================
   IMAGE ICON
================================ */

.slider-prev-{{ section.id }} .nav-image,
.slider-next-{{ section.id }} .nav-image {

    width:{{ section.settings.icon_size }}px;
    height:{{ section.settings.icon_size }}px;

    object-fit:contain;

}


/* ================================
   DESKTOP / MOBILE CONTROL
================================ */


@media(min-width:750px){

    .nav-hide-desktop {

        display:none !important;

    }

}


@media(max-width:749px){

    .nav-hide-mobile {

        display:none !important;

    }

}


</style>


