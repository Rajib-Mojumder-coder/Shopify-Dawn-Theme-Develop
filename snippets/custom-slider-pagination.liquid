{% liquid
    assign show_pagination_desktop = section.settings.show_pagination_desktop
    assign show_pagination_mobile = section.settings.show_pagination_mobile
%}

{% if show_pagination_desktop or show_pagination_mobile %}
<div class="slider-pagination-wrapper
    {% unless show_pagination_desktop %}pagination-hide-desktop{% endunless %}
    {% unless show_pagination_mobile %}pagination-hide-mobile{% endunless %}">

    <div class="swiper-pagination slider-pagination-{{ section.id }}"></div>

</div>
{% endif %}

<style>

/* ================================
   PAGINATION WRAPPER
================================ */

.slider-pagination-wrapper-{{ section.id }} {

    z-index:20;

}


/* ================================
   SWIPER PAGINATION
================================ */

.slider-pagination-{{ section.id }} {

    position:relative;

}


/* ================================
   PAGINATION BULLET
================================ */

.slider-pagination-{{ section.id }} .swiper-pagination-bullet {

    background:
    {{ section.settings.pagination_color }};

    opacity:
    {{ section.settings.pagination_opacity }};

}


/* ACTIVE BULLET
================================ */

.slider-pagination-{{ section.id }} .swiper-pagination-bullet-active {

    background:
    {{ section.settings.pagination_active_color }};

}


/* ================================
   DESKTOP / MOBILE CONTROL
================================ */


@media(min-width:750px){

    .pagination-hide-desktop {

        display:none !important;

    }

}


@media(max-width:749px){

    .pagination-hide-mobile {

        display:none !important;

    }

}


</style>

