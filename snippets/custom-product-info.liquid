<div class="custom-product-info">

  <div class="custom-product-info__sku" data-product-sku
    {% if product.selected_or_first_available_variant.sku == blank %} hidden {% endif %}>

    <span class="custom-product-info__sku-label">  SKU: </span>

    <span class="custom-product-info__sku-value" data-product-sku-value>
      {{ product.selected_or_first_available_variant.sku }}
    </span>
    
  </div>

</div>

<style>
    /*=============Product SKU==================*/

.custom-product-sku{
    display:flex;
    align-items:center;
    gap:8px;
}

.custom-product-sku__label{
    font-weight:600;
}

.custom-product-sku__value{
    font-weight:400;
}
</style>