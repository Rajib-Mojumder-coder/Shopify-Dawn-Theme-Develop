{% liquid
  assign swatch_image = blank
  assign normalized_value = swatch_value | downcase | strip

  for media in product.media

    assign media_alt = media.alt | default: '' | downcase | strip

    if media_alt == normalized_value

      assign swatch_image = media.preview_image
      break

    endif

  endfor
%}

{% if swatch_image %}

  {{
    swatch_image
    | image_url: width: 120
    | image_tag:
      loading: 'lazy',
      widths: '60, 90, 120',
      sizes: '60px',
      class: 'custom-product-variant__swatch-image',
      alt: swatch_value
  }}

{% else %}

  <span
    class="custom-product-variant__swatch-image custom-product-variant__swatch-image--fallback"
    aria-hidden="true"
  >
    {{ swatch_value | slice: 0 }}
  </span>

{% endif %}