{% liquid
  assign swatch_image = blank
  for variant in product.variants
    if variant.featured_image and variant.options contains swatch_value
      assign swatch_image = variant.featured_image
      break
    endif
  endfor
%}
{% if swatch_image %}
  {{
    swatch_image
    | image_url: width: 120
    | image_tag:
      loading: 'lazy',
      widths: '60, 90, 120',
      sizes: '60px',
      class: 'custom-product-variant__swatch-image',
      alt: swatch_value
  }}
{% else %}
  <span
    class="custom-product-variant__swatch-image custom-product-variant__swatch-image--fallback"
    aria-hidden="true"
  >
    {{ swatch_value | slice: 0 }}
  </span>
{% endif %}