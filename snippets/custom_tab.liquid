{% liquid
  assign enable_color_scheme = custom_tab_block.settings.enable_color_scheme
  assign color_scheme = custom_tab_block.settings.color_scheme
  assign custom_tab_width = custom_tab_block.settings.custom_tab_width

  assign tab_1_title = custom_tab_block.settings.tab_1_title
  assign tab_1_heading = custom_tab_block.settings.tab_1_heading
  assign tab_1_description = custom_tab_block.settings.tab_1_description

  assign tab_2_title = custom_tab_block.settings.tab_2_title
  assign tab_2_heading = custom_tab_block.settings.tab_2_heading
%}

<div
  class="custom-tab custom-tab-{{ custom_tab_block.id }} custom-tab-{{ custom_tab_width }} color-{{ color_scheme }}"
  {% if custom_tab_block.shopify_attributes %}
    {{ custom_tab_block.shopify_attributes }}
  {% endif %}
>

  <!-- Tab Navigation -->
  <div class="tabs" role="tablist">

    <input
        type="radio"
        name="custom-tabs-{{ custom_tab_block.id }}"
        id="tab1-{{ custom_tab_block.id }}"
        checked
        >

    <label
      for="tab1-{{ custom_tab_block.id }}"
      role="tab"
      aria-selected="true"
      aria-controls="tab-content1-{{ custom_tab_block.id }}"
    >
      {{ tab_1_title }}
    </label>


    <input
        type="radio"
        name="custom-tabs-{{ custom_tab_block.id }}"
        id="tab2-{{ custom_tab_block.id }}"
    >

    <label
      for="tab2-{{ custom_tab_block.id }}"
      role="tab"
      aria-selected="false"
      aria-controls="tab-content2-{{ custom_tab_block.id }}"
    >
      {{ tab_2_title }}
    </label>

  </div>


  <!-- ==========================================
       TAB 1 - DESCRIPTION
       ========================================== -->

  <div
    id="tab-content1-{{ custom_tab_block.id }}"
    class="tab-content tab-content-1"
    role="tabpanel"
  >

      {% if tab_1_heading != blank %}
        <h2 class="custom-tab-heading">
          {{ tab_1_heading }}
        </h2>
      {% elsif product.title != blank %}
        <h2 class="custom-tab-heading">
          {{ product.title }}
        </h2>
      {% endif %}


      {% if tab_1_description != blank %}
        <div class="custom-tab-description rte">
          {{ tab_1_description }}
        </div>
      {% elsif product.description != blank %}
        <div class="custom-tab-description rte">
          {{ product.description }}
        </div>
      {% endif %}

  </div>


  <!-- ==========================================
       TAB 2 - SPECIFICATIONS
       ========================================== -->

  <div
    id="tab-content2-{{ custom_tab_block.id }}"
    class="tab-content tab-content-2"
    role="tabpanel"
  >

      {% if tab_2_heading != blank %}
        <h2 class="custom-tab-heading">
          {{ tab_2_heading }}
        </h2>
      {% elsif product.title != blank %}
        <h2 class="custom-tab-heading">
          {{ product.title }}
        </h2>
      {% endif %}
    

    
             {{ product.metafields.custom.frame_material }}
             {{ product.metafields.custom.modeljaar }}
             {{ product.metafields.custom.merk }}

            {% for option in product.options %}
                {{ option.name }}
                {{ option.value }}
            {% endfor %}

{% comment %} <div class="product-specifications">

  <div class="product-spec-column">

    {% if product.metafields.custom.productnummer != blank %}
      <div class="product-spec-row">
