        <span class="product-spec-value">
          {{ product.metafields.custom.gewicht }}
        </span>
      </div>
    {% endif %}

    {% if product.metafields.custom.modeljaar_seizoen != blank %}
      <div class="product-spec-row">
        <span class="product-spec-label">Modeljaar / Seizoen</span>
        <span class="product-spec-value">
          {{ product.metafields.custom.modeljaar_seizoen }}
        </span>
      </div>
    {% endif %}

    {% if product.metafields.custom.wielmaat != blank %}
      <div class="product-spec-row">
        <span class="product-spec-label">Wielmaat</span>
        <span class="product-spec-value">
          {{ product.metafields.custom.wielmaat }}
        </span>
      </div>
    {% endif %}

  </div>

</div> {% endcomment %}







  </div>

</div>

