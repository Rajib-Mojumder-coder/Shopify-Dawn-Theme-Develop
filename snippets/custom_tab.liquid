

<div
  class="custom-tab custom-tab-{{ custom_tab_block.id }} custom-tab-{{ custom_tab_width }} color-{{ color_scheme }}"
  {% if custom_tab_block.shopify_attributes %}
    {{ custom_tab_block.shopify_attributes }}
  {% endif %}
>

  <!-- Tab Navigation -->
  <div class="tabs" role="tablist">

    <input
        type="radio"
        name="custom-tabs-{{ custom_tab_block.id }}"
        id="tab1-{{ custom_tab_block.id }}"
        checked
        >

    <label
      for="tab1-{{ custom_tab_block.id }}"
      role="tab"
      aria-selected="true"
      aria-controls="tab-content1-{{ custom_tab_block.id }}"
    >
      {{ tab_1_title }}
    </label>


    <input
        type="radio"
        name="custom-tabs-{{ custom_tab_block.id }}"
        id="tab2-{{ custom_tab_block.id }}"
    >

    <label
      for="tab2-{{ custom_tab_block.id }}"
      role="tab"
      aria-selected="false"
      aria-controls="tab-content2-{{ custom_tab_block.id }}"
    >
      {{ tab_2_title }}
    </label>

  </div>


  <!-- ==========================================
       TAB 1 - DESCRIPTION
       ========================================== -->

  <div
    id="tab-content1-{{ custom_tab_block.id }}"
    class="tab-content tab-content-1"
    role="tabpanel"
  >

    {% if tab_1_heading != blank %}
      <h2 class="custom-tab-heading">
        {{ tab_1_heading }}
      </h2>
    {% endif %}

    {% if tab_1_description != blank %}
      <div class="custom-tab-description rte">
        {{ tab_1_description }}
      </div>
    {% endif %}

  </div>


  <!-- ==========================================
       TAB 2 - SPECIFICATIONS
       ========================================== -->

  <div
    id="tab-content2-{{ custom_tab_block.id }}"
    class="tab-content tab-content-2"
    role="tabpanel"
  >

    {% comment %} {% if tab_2_heading != blank %}
      <h2 class="custom-tab-heading custom-tab-spec-heading">
        {{ tab_2_heading }}
      </h2>
    {% endif %} {% endcomment %}

    {{ product.title }}
    <div class="product-specifications">

      <!-- LEFT COLUMN -->
      <div class="product-spec-column">

        <div class="product-spec-row">
          <span class="product-spec-label">Productnummer:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.productnummer | default: product.id }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Type:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.type }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Merk:</span>
          <span class="product-spec-value">
            {{ product.vendor }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Maat:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.maat }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Accucapaciteit:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.accucapaciteit }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Kleur:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.kleur }}
          </span>
        </div>


      </div>


      <!-- RIGHT COLUMN -->
      <div class="product-spec-column">

        <div class="product-spec-row">
          <span class="product-spec-label">Versnellingen:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.versnellingen }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Model versnellingsysteem:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.model_versnellingsysteem }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Frame materiaal:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.frame_materiaal }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Gewicht:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.gewicht }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Modeljaar / Seizoen:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.modeljaar_seizoen }}
          </span>
        </div>

        <div class="product-spec-row">
          <span class="product-spec-label">Wielmaat:</span>
          <span class="product-spec-value">
            {{ product.metafields.custom.wielmaat }}
          </span>
        </div>

      </div>

    </div>

  </div>

</div>