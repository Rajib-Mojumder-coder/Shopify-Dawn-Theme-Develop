{%  liquid 
    assign enable_color_scheme = custom_tab_block.settings.enable_color_scheme
    assign color_scheme = custom_tab_block.settings.color_scheme
    assign custom_tab_width = custom_tab_block.settings.custom_tab_width
%}


<div class="custom-tab custom-tab-{{ custom_tab_block.id }} custom-tab-{{ custom_tab_width }} advisor-card--button-{{advisor_button_width }}" {% if custom_tab_block.shopify_attributes %} {{ custom_tab_block.shopify_attributes }} {% endif %}
    
  style=" --advisor-heading-max-width: {{ heading_max_width }}px; --advisor-button-width: {{ advisor_button_width }};
    --advisor-bg: {% if advisor_card_bg %} {{ card_bg_color }} {% else %} transparent {% endif %};
    --advisor-image-bg: {% if transparant_img_bg %} {{ transparant_img_bg_color }} {% else %} transparent {% endif %};
    --advisor-image-offset: {{ advisor_img_y_offset }}px;">

</div>