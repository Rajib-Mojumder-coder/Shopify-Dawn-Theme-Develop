{{ 'custom_tab.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-tab.js' | asset_url }}" defer></script>

{% render 'custom_tab',
    custom_tab_block: block
%}


{% schema %}
{
  "name": "Custom Tab",
  "tag": null,
  "settings": [
      {
        "type": "checkbox",
        "id": "enable_color_scheme",
        "label": "Enable Custom Color Schema",
        "default": false
      },
      {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-5",
      "visible_if": "{{ block.settings.enable_color_scheme }}"
    },
      {
        "type": "select",
        "id": "custom_tab_width",
        "label": "Tab Width",
        "default": "100",
        "options": [
          {
            "value": "100",
            "label": "100%"
          },
          {
            "value": "75",
            "label": "75%"
          },
          {
            "value": "66",
            "label": "66.66%"
          },
          {
            "value": "50",
            "label": "50%"
          },
          {
            "value": "33",
            "label": "33.33%"
          },
          {
            "value": "25",
            "label": "25%"
          }
        ]
    },
    {
        "type": "text",
        "id": "tab_1_title",
        "label": "Tab 1 title",
        "default": "Description"
    },
    {
        "type": "text",
        "id": "tab_1_heading",
        "label": "Tab 1 heading",
        "default": "Product description"
    },
    {
        "type": "richtext",
        "id": "tab_1_description",
        "label": "Tab 1 description"
    },
    {
        "type": "text",
        "id": "tab_2_title",
        "label": "Tab 2 title",
        "default": "Specification"
    },
    {
        "type": "text",
        "id": "tab_2_heading",
        "label": "Tab 2 heading",
        "default": "Product specifications"
    }
    
  ],
  "presets": [
    {
      "name": "Custom Tab"
    }
  ]
}
{% endschema %}

