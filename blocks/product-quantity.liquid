{%- liquid
  assign product_form_id = 'product-form-' | append: section.id

  assign quantity_type = block.settings.quantity_type

  assign min_quantity = block.settings.min_quantity | default: 1
  assign max_quantity = block.settings.max_quantity | default: 10
  assign quantity_step = block.settings.quantity_step | default: 1

  if max_quantity < min_quantity
    assign max_quantity = min_quantity
  endif

  assign current_product_variant = product.selected_or_first_available_variant
-%}

<div
  id="ProductQuantity-{{ block.id }}"
  class="
    product-quantity
    product-quantity--{{ block.id }}
    product-quantity--{{ quantity_type }}

    product-quantity--stepper-size-{{ block.settings.stepper_size }}
    product-quantity--stepper-align-{{ block.settings.stepper_alignment }}

    product-quantity--dropdown-size-{{ block.settings.dropdown_size }}
    product-quantity--dropdown-align-{{ block.settings.dropdown_alignment }}

    product-quantity--presets-size-{{ block.settings.presets_size }}
    product-quantity--presets-align-{{ block.settings.presets_alignment }}
  "
  data-product-quantity
  data-quantity-type="{{ quantity_type }}"
  data-min="{{ min_quantity }}"
  data-max="{{ max_quantity }}"
  data-step="{{ quantity_step }}"
  {{ block.shopify_attributes }}
>

  <style>
    #ProductQuantity-{{ block.id }} {

      --bundle-gap:
        {{ block.settings.bundle_gap }}px;

      --bundle-radius:
        {{ block.settings.bundle_radius }}px;

      --bundle-padding:
        {{ block.settings.bundle_padding }}px;


      {% if block.settings.bundle_use_custom_colors %}

        --bundle-background:
          {% if block.settings.bundle_enable_gradient %}
            linear-gradient(
              135deg,
              {{ block.settings.bundle_background }},
              {{ block.settings.bundle_background_gradient }}
            );
          {% else %}
            {{ block.settings.bundle_background }};
          {% endif %}

        --bundle-text:
          {{ block.settings.bundle_text_color }};

        --bundle-border:
          {{ block.settings.bundle_border_color }};

        --bundle-active-background:
          {{ block.settings.bundle_active_background }};

        --bundle-active-text:
          {{ block.settings.bundle_active_text }};

        --bundle-active-border:
          {{ block.settings.bundle_active_border }};

        --bundle-badge-background:
          {{ block.settings.bundle_badge_background }};

        --bundle-badge-text:
          {{ block.settings.bundle_badge_text }};

        --bundle-active-badge-background:
          {{ block.settings.bundle_active_badge_background }};

        --bundle-active-badge-text:
          {{ block.settings.bundle_active_badge_text }};

      {% else %}

        --bundle-background:
          rgb(var(--color-background));

        --bundle-text:
          rgb(var(--color-foreground));

        --bundle-border:
          rgba(var(--color-foreground), 0.25);

        --bundle-active-background:
          rgb(var(--color-foreground));

        --bundle-active-text:
          rgb(var(--color-background));

        --bundle-active-border:
          rgb(var(--color-foreground));

        --bundle-badge-background:
          rgb(var(--color-foreground));

        --bundle-badge-text:
          rgb(var(--color-background));

        --bundle-active-badge-background:
          rgb(var(--color-background));

        --bundle-active-badge-text:
          rgb(var(--color-foreground));

      {% endif %}
    }
  </style>


  {% if block.settings.show_label %}

    <label
      class="product-quantity__label"
      for="ProductQuantityInput-{{ block.id }}"
    >
      {{ block.settings.label }}
    </label>

  {% endif %}


  {%- comment -%}
  ==========================================================
  STANDARD QUANTITY SELECTOR
  ==========================================================
  ==========================================================
  Existing functionality preserved.
  ==========================================================
  {%- endcomment -%}

  {% if quantity_type == 'stepper' %}

    <div class="product-quantity__stepper">

      <button
        type="button"
        class="
          product-quantity__button
          product-quantity__button--minus
        "
        data-quantity-decrease
        aria-label="Decrease quantity"
      >
        <span aria-hidden="true">−</span>
      </button>


      <input
        id="ProductQuantityInput-{{ block.id }}"
        class="
          product-quantity__input
          custom-product-form__quantity
        "
        type="number"
        name="quantity"
        value="{{ min_quantity }}"
        min="{{ min_quantity }}"
        max="{{ max_quantity }}"
        step="{{ quantity_step }}"
        inputmode="numeric"
        form="{{ product_form_id }}"
        data-quantity-input
        aria-label="{{ block.settings.label }}"
      >


      <button
        type="button"
        class="
          product-quantity__button
          product-quantity__button--plus
        "
        data-quantity-increase
        aria-label="Increase quantity"
      >
        <span aria-hidden="true">+</span>
      </button>

    </div>


  {%- comment -%}
  ==========================================================
  DROPDOWN
  ==========================================================
  {%- endcomment -%}

  {% elsif quantity_type == 'dropdown' %}

    <div class="product-quantity__dropdown">

      <select
        id="ProductQuantityInput-{{ block.id }}"
        class="
          product-quantity__select
          custom-product-form__quantity
        "
        name="quantity"
        form="{{ product_form_id }}"
        data-quantity-input
        aria-label="{{ block.settings.label }}"
      >

        {% for quantity in (1..100) %}

          {% if quantity >= min_quantity
            and quantity <= max_quantity
          %}

            {% assign relative_quantity =
              quantity | minus: min_quantity
            %}

            {% assign remainder =
              relative_quantity | modulo: quantity_step
            %}

            {% if remainder == 0 %}

              <option
                value="{{ quantity }}"
                {% if quantity == min_quantity %}
                  selected
                {% endif %}
              >
                {{ quantity }}
              </option>

            {% endif %}

          {% endif %}

        {% endfor %}

      </select>

    </div>


  {%- comment -%}
  ==========================================================
  PRESETS
  ==========================================================
  {%- endcomment -%}

  {% elsif quantity_type == 'presets' %}

    <div
      class="product-quantity__presets"
      role="group"
      aria-label="{{ block.settings.label }}"
    >

      {% if block.settings.preset_1_quantity >= min_quantity
        and block.settings.preset_1_quantity <= max_quantity
      %}

        <button
          type="button"
          class="product-quantity__preset is-active"
          data-quantity-preset="{{ block.settings.preset_1_quantity }}"
          aria-pressed="true"
        >
          {{ block.settings.preset_1_label }}
        </button>

      {% endif %}


      {% if block.settings.preset_2_quantity >= min_quantity
        and block.settings.preset_2_quantity <= max_quantity
      %}

        <button
          type="button"
          class="product-quantity__preset"
          data-quantity-preset="{{ block.settings.preset_2_quantity }}"
          aria-pressed="false"
        >
          {{ block.settings.preset_2_label }}
        </button>

      {% endif %}


      {% if block.settings.preset_3_quantity >= min_quantity
        and block.settings.preset_3_quantity <= max_quantity
      %}

        <button
          type="button"
          class="product-quantity__preset"
          data-quantity-preset="{{ block.settings.preset_3_quantity }}"
          aria-pressed="false"
        >
          {{ block.settings.preset_3_label }}
        </button>

      {% endif %}

    </div>


    <input
      id="ProductQuantityInput-{{ block.id }}"
      class="custom-product-form__quantity"
      type="hidden"
      name="quantity"
      value="{{ block.settings.preset_1_quantity }}"
      form="{{ product_form_id }}"
      data-quantity-input
    >


  {%- comment -%}
  ==========================================================
  BUNDLE & SAVE
  ==========================================================
  ==========================================================
  Existing bundle functionality preserved.

  Pricing below is DISPLAY ONLY.
  Actual discount remains controlled by Shopify.
  ==========================================================
  {%- endcomment -%}

  {% elsif quantity_type == 'bundle' %}

    <div
      class="
        product-quantity__bundles
        product-quantity__bundles--{{ block.settings.bundle_layout }}
      "
      role="radiogroup"
      aria-label="{{ block.settings.bundle_label }}"
    >


      {%- comment -%}
      ========================================================
      BUNDLE 1
      ========================================================
      {%- endcomment -%}

      {% if block.settings.bundle_1_enabled %}

        {%- liquid
          assign bundle_1_quantity = block.settings.bundle_1_quantity | default: 1
          assign bundle_1_discount = block.settings.bundle_1_discount_percent | default: 0
          assign bundle_1_unit_regular = current_product_variant.price
          assign bundle_1_unit_discount = bundle_1_unit_regular | times: bundle_1_discount | divided_by: 100
          assign bundle_1_unit_offer = bundle_1_unit_regular | minus: bundle_1_unit_discount
          assign bundle_1_total_regular =  bundle_1_unit_regular | times: bundle_1_quantity
          assign bundle_1_total_offer =  bundle_1_unit_offer | times: bundle_1_quantity
        -%}


        <button
          type="button"
          class="
            product-quantity__bundle
            is-active
          "
          data-bundle-option
          data-bundle-quantity="{{ bundle_1_quantity }}"
          data-bundle-discount-code="{{ block.settings.bundle_1_discount_code | strip | escape }}"
          aria-pressed="true"
        >

          {% if block.settings.bundle_1_badge != blank %}

            <span class="product-quantity__bundle-badge">
              {{ block.settings.bundle_1_badge }}
            </span>

          {% endif %}


          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>


          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_1_label }}
            </span>


            {% if block.settings.bundle_1_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_1_description }}
              </span>

            {% endif %}


            {% if block.settings.show_bundle_pricing %}

              <span class="product-quantity__bundle-pricing">

                {% if block.settings.show_bundle_unit_price %}

                  <span class="product-quantity__bundle-unit-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_1_discount > 0
                    %}

                      <s>
                        {{ bundle_1_unit_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_1_unit_offer | money }}
                    </strong>

                    <small>
                      / pc
                    </small>

                  </span>

                {% endif %}


                {% if block.settings.show_bundle_total_price %}

                  <span class="product-quantity__bundle-total-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_1_discount > 0
                    %}

                      <s>
                        {{ bundle_1_total_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_1_total_offer | money }}
                    </strong>

                    <small>
                      / {{ bundle_1_quantity }} pcs
                    </small>

                  </span>

                {% endif %}

              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_1_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_1_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}


      {%- comment -%}
      ========================================================
      BUNDLE 2
      ========================================================
      {%- endcomment -%}

      {% if block.settings.bundle_2_enabled %}

        {%- liquid
          assign bundle_2_quantity = block.settings.bundle_2_quantity | default: 2
          assign bundle_2_discount = block.settings.bundle_2_discount_percent | default: 5
          assign bundle_2_unit_regular = current_product_variant.price
          assign bundle_2_unit_discount = bundle_2_unit_regular | times: bundle_2_discount | divided_by: 100
          assign bundle_2_unit_offer = bundle_2_unit_regular | minus: bundle_2_unit_discount 
          assign bundle_2_total_regular = bundle_2_unit_regular | times: bundle_2_quantity
          assign bundle_2_total_offer =  bundle_2_unit_offer | times: bundle_2_quantity
        -%}


        <button
          type="button"
          class="product-quantity__bundle"
          data-bundle-option
          data-bundle-quantity="{{ bundle_2_quantity }}"
          data-bundle-discount-code="{{ block.settings.bundle_2_discount_code | strip | escape }}"
          aria-pressed="false"
        >

          {% if block.settings.bundle_2_badge != blank %}

            <span class="product-quantity__bundle-badge">
              {{ block.settings.bundle_2_badge }}
            </span>

          {% endif %}


          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>


          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_2_label }}
            </span>


            {% if block.settings.bundle_2_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_2_description }}
              </span>

            {% endif %}


            {% if block.settings.show_bundle_pricing %}

              <span class="product-quantity__bundle-pricing">

                {% if block.settings.show_bundle_unit_price %}

                  <span class="product-quantity__bundle-unit-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_2_discount > 0
                    %}

                      <s>
                        {{ bundle_2_unit_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_2_unit_offer | money }}
                    </strong>

                    <small>
                      / pc
                    </small>

                  </span>

                {% endif %}


                {% if block.settings.show_bundle_total_price %}

                  <span class="product-quantity__bundle-total-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_2_discount > 0
                    %}

                      <s>
                        {{ bundle_2_total_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_2_total_offer | money }}
                    </strong>

                    <small>
                      / {{ bundle_2_quantity }} pcs
                    </small>

                  </span>

                {% endif %}

              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_2_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_2_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}


      {%- comment -%}
      ========================================================
      BUNDLE 3
      ========================================================
      {%- endcomment -%}

      {% if block.settings.bundle_3_enabled %}

        {%- liquid
          assign bundle_3_quantity =  block.settings.bundle_3_quantity | default: 3
          assign bundle_3_discount =  block.settings.bundle_3_discount_percent | default: 10
          assign bundle_3_unit_regular =  current_product_variant.price
          assign bundle_3_unit_discount =  bundle_3_unit_regular | times: bundle_3_discount | divided_by: 100
          assign bundle_3_unit_offer = bundle_3_unit_regular | minus: bundle_3_unit_discount
          assign bundle_3_total_regular = bundle_3_unit_regular | times: bundle_3_quantity
          assign bundle_3_total_offer =  bundle_3_unit_offer | times: bundle_3_quantity
        -%}


        <button
          type="button"
          class="product-quantity__bundle"
          data-bundle-option
          data-bundle-quantity="{{ bundle_3_quantity }}"
          data-bundle-discount-code="{{ block.settings.bundle_3_discount_code | strip | escape }}"
          aria-pressed="false"
        >

          {% if block.settings.bundle_3_badge != blank %}

            <span class="product-quantity__bundle-badge">
              {{ block.settings.bundle_3_badge }}
            </span>

          {% endif %}


          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>


          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_3_label }}
            </span>


            {% if block.settings.bundle_3_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_3_description }}
              </span>

            {% endif %}


            {% if block.settings.show_bundle_pricing %}

              <span class="product-quantity__bundle-pricing">

                {% if block.settings.show_bundle_unit_price %}

                  <span class="product-quantity__bundle-unit-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_3_discount > 0
                    %}

                      <s>
                        {{ bundle_3_unit_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_3_unit_offer | money }}
                    </strong>

                    <small>
                      / pc
                    </small>

                  </span>

                {% endif %}


                {% if block.settings.show_bundle_total_price %}

                  <span class="product-quantity__bundle-total-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_3_discount > 0
                    %}

                      <s>
                        {{ bundle_3_total_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_3_total_offer | money }}
                    </strong>

                    <small>
                      / {{ bundle_3_quantity }} pcs
                    </small>

                  </span>

                {% endif %}

              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_3_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_3_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}


      {%- comment -%}
      ========================================================
      BUNDLE 4
      ========================================================
      {%- endcomment -%}

      {% if block.settings.bundle_4_enabled %}

        {%- liquid
          assign bundle_4_quantity =  block.settings.bundle_4_quantity | default: 5
          assign bundle_4_discount =  block.settings.bundle_4_discount_percent | default: 15
          assign bundle_4_unit_regular = current_product_variant.price
          assign bundle_4_unit_discount = bundle_4_unit_regular | times: bundle_4_discount | divided_by: 100
          assign bundle_4_unit_offer = bundle_4_unit_regular | minus: bundle_4_unit_discount
          assign bundle_4_total_regular = bundle_4_unit_regular | times: bundle_4_quantity
          assign bundle_4_total_offer = bundle_4_unit_offer | times: bundle_4_quantity
        -%}


        <button
          type="button"
          class="product-quantity__bundle"
          data-bundle-option
          data-bundle-quantity="{{ bundle_4_quantity }}"
          data-bundle-discount-code="{{ block.settings.bundle_4_discount_code | strip | escape }}"
          aria-pressed="false"
        >

          {% if block.settings.bundle_4_badge != blank %}

            <span class="product-quantity__bundle-badge">
              {{ block.settings.bundle_4_badge }}
            </span>

          {% endif %}


          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>


          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_4_label }}
            </span>


            {% if block.settings.bundle_4_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_4_description }}
              </span>

            {% endif %}


            {% if block.settings.show_bundle_pricing %}

              <span class="product-quantity__bundle-pricing">

                {% if block.settings.show_bundle_unit_price %}

                  <span class="product-quantity__bundle-unit-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_4_discount > 0
                    %}

                      <s>
                        {{ bundle_4_unit_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_4_unit_offer | money }}
                    </strong>

                    <small>
                      / pc
                    </small>

                  </span>

                {% endif %}


                {% if block.settings.show_bundle_total_price %}

                  <span class="product-quantity__bundle-total-price">

                    {% if block.settings.show_bundle_regular_price
                      and bundle_4_discount > 0
                    %}

                      <s>
                        {{ bundle_4_total_regular | money }}
                      </s>

                    {% endif %}

                    <strong>
                      {{ bundle_4_total_offer | money }}
                    </strong>

                    <small>
                      / {{ bundle_4_quantity }} pcs
                    </small>

                  </span>

                {% endif %}

              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_4_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_4_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}

    </div>


    {%- liquid
      assign first_bundle_quantity = block.settings.bundle_1_quantity | default: 1

      if first_bundle_quantity < min_quantity
        assign first_bundle_quantity = min_quantity
      endif

      if first_bundle_quantity > max_quantity
        assign first_bundle_quantity = min_quantity
      endif
    -%}


    <input
      id="ProductQuantityInput-{{ block.id }}"
      class="custom-product-form__quantity"
      type="hidden"
      name="quantity"
      value="{{ first_bundle_quantity }}"
      form="{{ product_form_id }}"
      data-quantity-input
    >

  {% endif %}

</div>


{% schema %}

{
  "name": "Product quantity",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Quantity"
    },

    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Quantity"
    },

    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },

    {
      "type": "select",
      "id": "quantity_type",
      "label": "Display type",
      "options": [
        {
          "value": "stepper",
          "label": "Quantity selector"
        },
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "presets",
          "label": "Quantity presets"
        },
        {
          "value": "bundle",
          "label": "Bundle & save"
        }
      ],
      "default": "stepper"
    },


    {
      "type": "header",
      "content": "Quantity selector",
      "visible_if": "{{ block.settings.quantity_type == 'stepper' }}"
    },

    {
      "type": "select",
      "id": "stepper_size",
      "label": "Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ block.settings.quantity_type == 'stepper' }}"
    },

    {
      "type": "select",
      "id": "stepper_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.quantity_type == 'stepper' }}"
    },


    {
      "type": "header",
      "content": "Dropdown",
      "visible_if": "{{ block.settings.quantity_type == 'dropdown' }}"
    },

    {
      "type": "select",
      "id": "dropdown_size",
      "label": "Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ block.settings.quantity_type == 'dropdown' }}"
    },

    {
      "type": "select",
      "id": "dropdown_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "visible_if": "{{ block.settings.quantity_type == 'dropdown' }}"
    },


    {
      "type": "header",
      "content": "Quantity presets",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "select",
      "id": "presets_size",
      "label": "Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "select",
      "id": "presets_alignment",
      "label": "Alignment",
      "options": [
