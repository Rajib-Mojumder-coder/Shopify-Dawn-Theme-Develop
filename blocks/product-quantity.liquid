{%- liquid
  assign product_form_id = 'product-form-' | append: section.id

  assign quantity_type = block.settings.quantity_type

  assign min_quantity = block.settings.min_quantity | default: 1
  assign max_quantity = block.settings.max_quantity | default: 10
  assign quantity_step = block.settings.quantity_step | default: 1

  if max_quantity < min_quantity
    assign max_quantity = min_quantity
  endif
-%}

<div id="ProductQuantity-{{ block.id }}"
  class="product-quantity product-quantity--{{ block.id }} product-quantity--{{ quantity_type }}"
  data-product-quantity data-quantity-type="{{ quantity_type }}"
  data-min="{{ min_quantity }}" data-max="{{ max_quantity }}" data-step="{{ quantity_step }}" {{ block.shopify_attributes }}
>
<style>
  #ProductQuantity-{{ block.id }}{
    --bundle-gap: {{ block.settings.bundle_gap }}px;
  --bundle-radius: {{ block.settings.bundle_radius }}px;
  --bundle-padding: {{ block.settings.bundle_padding }}px;

  {% if block.settings.bundle_use_custom_colors %}

    --bundle-background:
      {% if block.settings.bundle_enable_gradient %}
        linear-gradient(
          135deg,
          {{ block.settings.bundle_background }},
          {{ block.settings.bundle_background_gradient }}
        );
      {% else %}
        {{ block.settings.bundle_background }};
      {% endif %}

    --bundle-text: {{ block.settings.bundle_text_color }};
    --bundle-border: {{ block.settings.bundle_border_color }};
    --bundle-active-background: {{ block.settings.bundle_active_background }};
    --bundle-active-text: {{ block.settings.bundle_active_text }};
    --bundle-active-border: {{ block.settings.bundle_active_border }};

  {% else %}

    --bundle-background: transparent;
    --bundle-text: inherit;
    --bundle-border: currentColor;
    --bundle-active-background: inherit;
    --bundle-active-text: #ffffff;
    --bundle-active-border: currentColor;

  {% endif %}
  }
</style>

  {% if block.settings.show_label %}

    <label
      class="product-quantity__label"
      for="ProductQuantityInput-{{ block.id }}"
    >
      {{ block.settings.label }}
    </label>

  {% endif %}


  {%- comment -%}
  ==========================================================
  STANDARD QUANTITY SELECTOR
  ==========================================================
  {%- endcomment -%}

  {% if quantity_type == 'stepper' %}

    <div class="product-quantity__stepper">

      <button
        type="button"
        class="
          product-quantity__button
          product-quantity__button--minus
        "
        data-quantity-decrease
        aria-label="Decrease quantity"
      >
        <span aria-hidden="true">−</span>
      </button>

      <input
        id="ProductQuantityInput-{{ block.id }}"
        class="
          product-quantity__input
          custom-product-form__quantity
        "
        type="number"
        name="quantity"
        value="{{ min_quantity }}"
        min="{{ min_quantity }}"
        max="{{ max_quantity }}"
        step="{{ quantity_step }}"
        inputmode="numeric"
        form="{{ product_form_id }}"
        data-quantity-input
        aria-label="{{ block.settings.label }}"
      >

      <button
        type="button"
        class="
          product-quantity__button
          product-quantity__button--plus
        "
        data-quantity-increase
        aria-label="Increase quantity"
      >
        <span aria-hidden="true">+</span>
      </button>

    </div>


  {%- comment -%}
  ==========================================================
  DROPDOWN
  ==========================================================
  {%- endcomment -%}

  {% elsif quantity_type == 'dropdown' %}

    <div class="product-quantity__dropdown">

      <select
        id="ProductQuantityInput-{{ block.id }}"
        class="
          product-quantity__select
          custom-product-form__quantity
        "
        name="quantity"
        form="{{ product_form_id }}"
        data-quantity-input
        aria-label="{{ block.settings.label }}"
      >

        {% for quantity in (1..100) %}

          {% if quantity >= min_quantity
            and quantity <= max_quantity
          %}

            {% assign relative_quantity =
              quantity | minus: min_quantity
            %}

            {% assign remainder =
              relative_quantity | modulo: quantity_step
            %}

            {% if remainder == 0 %}

              <option
                value="{{ quantity }}"
                {% if quantity == min_quantity %}
                  selected
                {% endif %}
              >
                {{ quantity }}
              </option>

            {% endif %}

          {% endif %}

        {% endfor %}

      </select>

    </div>


  {%- comment -%}
  ==========================================================
  PRESETS
  ==========================================================
  {%- endcomment -%}

  {% elsif quantity_type == 'presets' %}

    <div
      class="product-quantity__presets"
      role="group"
      aria-label="{{ block.settings.label }}"
    >

      {% if block.settings.preset_1_quantity >= min_quantity
        and block.settings.preset_1_quantity <= max_quantity
      %}

        <button
          type="button"
          class="product-quantity__preset is-active"
          data-quantity-preset="{{ block.settings.preset_1_quantity }}"
          aria-pressed="true"
        >
          {{ block.settings.preset_1_label }}
        </button>

      {% endif %}


      {% if block.settings.preset_2_quantity >= min_quantity
        and block.settings.preset_2_quantity <= max_quantity
      %}

        <button
          type="button"
          class="product-quantity__preset"
          data-quantity-preset="{{ block.settings.preset_2_quantity }}"
          aria-pressed="false"
        >
          {{ block.settings.preset_2_label }}
        </button>

      {% endif %}


      {% if block.settings.preset_3_quantity >= min_quantity
        and block.settings.preset_3_quantity <= max_quantity
      %}

        <button
          type="button"
          class="product-quantity__preset"
          data-quantity-preset="{{ block.settings.preset_3_quantity }}"
          aria-pressed="false"
        >
          {{ block.settings.preset_3_label }}
        </button>

      {% endif %}

    </div>


    <input
      id="ProductQuantityInput-{{ block.id }}"
      class="custom-product-form__quantity"
      type="hidden"
      name="quantity"
      value="{{ block.settings.preset_1_quantity }}"
      form="{{ product_form_id }}"
      data-quantity-input
    >


  {%- comment -%}
  ==========================================================
  BUNDLE & SAVE
  ==========================================================
  ==========================================================
  IMPORTANT:
  This UI changes quantity.

  The configured savings text is promotional display only.
  Actual discounting must be configured in Shopify's
  discount system / Shopify Function.
  ==========================================================
  {%- endcomment -%}

  {% elsif quantity_type == 'bundle' %}

    <div class="product-quantity__bundles product-quantity__bundles--{{ block.settings.bundle_layout }}"
      role="radiogroup" aria-label="{{ block.settings.bundle_label }}">

      {% if block.settings.bundle_1_enabled %}

        <button type="button" class="product-quantity__bundle is-active"
          data-bundle-option data-bundle-quantity="{{ block.settings.bundle_1_quantity }}"
          aria-pressed="true">

           {% if block.settings.bundle_1_badge != blank %}
            <span class="product-quantity__bundle-badge">
              {{ block.settings.bundle_1_badge }}
            </span>
          {% endif %}

          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_1_label }}
            </span>

            {% if block.settings.bundle_1_description != blank %}
              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_1_description }}
              </span>
            {% endif %}

          </span>

          {% if block.settings.bundle_1_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_1_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}


      {% if block.settings.bundle_2_enabled %}

        <button
          type="button"
          class="product-quantity__bundle"
          data-bundle-option
          data-bundle-quantity="{{ block.settings.bundle_2_quantity }}"
          aria-pressed="false"
        >

           {% if block.settings.bundle_2_badge != blank %}
            <span class="product-quantity__bundle-badge">
              {{ block.settings.bundle_2_badge }}
            </span>
          {% endif %}

          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_2_label }}
            </span>

            {% if block.settings.bundle_2_description != blank %}
              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_2_description }}
              </span>
            {% endif %}

          </span>

          {% if block.settings.bundle_2_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_2_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}


      {% if block.settings.bundle_3_enabled %}

        <button
          type="button"
          class="product-quantity__bundle"
          data-bundle-option
          data-bundle-quantity="{{ block.settings.bundle_3_quantity }}"
          aria-pressed="false"
        >

        {% if block.settings.bundle_3_badge != blank %}
          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_3_badge }}
          </span>
        {% endif %}

          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_3_label }}
            </span>

            {% if block.settings.bundle_3_description != blank %}
              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_3_description }}
              </span>
            {% endif %}

          </span>

          {% if block.settings.bundle_3_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_3_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}


      {% if block.settings.bundle_4_enabled %}

        <button
          type="button"
          class="product-quantity__bundle"
          data-bundle-option
          data-bundle-quantity="{{ block.settings.bundle_4_quantity }}"
          aria-pressed="false"
        >

        {% if block.settings.bundle_4_badge != blank %}
          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_4_badge }}
          </span>
        {% endif %}

          <span class="product-quantity__bundle-radio">
            <span class="product-quantity__bundle-radio-dot"></span>
          </span>

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_4_label }}
            </span>

            {% if block.settings.bundle_4_description != blank %}
              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_4_description }}
              </span>
            {% endif %}

          </span>

          {% if block.settings.bundle_4_savings != blank %}

            <span class="product-quantity__bundle-savings">
              {{ block.settings.bundle_4_savings }}
            </span>

          {% endif %}

        </button>

      {% endif %}

    </div>


    {%- liquid
      assign first_bundle_quantity = block.settings.bundle_1_quantity | default: 1

      if first_bundle_quantity < min_quantity
        assign first_bundle_quantity = min_quantity
      endif

      if first_bundle_quantity > max_quantity
        assign first_bundle_quantity = min_quantity
      endif
    -%}

    <input
      id="ProductQuantityInput-{{ block.id }}"
      class="custom-product-form__quantity"
      type="hidden"
      name="quantity"
      value="{{ first_bundle_quantity }}"
      form="{{ product_form_id }}"
      data-quantity-input
    >

  {% endif %}

</div>


{% schema %}
{
  "name": "Product quantity",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Quantity"
    },

    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Quantity"
    },

    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },

    {
      "type": "select",
      "id": "quantity_type",
      "label": "Display type",
      "options": [
        {
          "value": "stepper",
          "label": "Quantity selector"
        },
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "presets",
          "label": "Quantity presets"
        },
        {
          "value": "bundle",
          "label": "Bundle & save"
        }
      ],
      "default": "stepper"
    },


    {
      "type": "header",
      "content": "Quantity limits"
    },

    {
      "type": "range",
      "id": "min_quantity",
      "label": "Minimum quantity",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 1
    },

    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10
    },

    {
      "type": "range",
      "id": "quantity_step",
      "label": "Quantity step",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },


    {
      "type": "header",
      "content": "Preset 1",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "range",
      "id": "preset_1_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "text",
      "id": "preset_1_label",
      "label": "Label",
      "default": "1 item",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },


    {
      "type": "header",
      "content": "Preset 2",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "range",
      "id": "preset_2_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 2,
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "text",
      "id": "preset_2_label",
      "label": "Label",
      "default": "2 items",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },


    {
      "type": "header",
      "content": "Preset 3",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "range",
      "id": "preset_3_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "text",
      "id": "preset_3_label",
      "label": "Label",
      "default": "3 items",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },


    {
      "type": "header",
      "content": "Bundle & save",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "text",
      "id": "bundle_label",
      "label": "Section label",
      "default": "Choose your quantity",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "select",
      "id": "bundle_layout",
      "label": "Offer layout",
      "options": [
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "grid",
          "label": "2-column cards"
        },
        {
          "value": "featured",
          "label": "Featured first"
        }
      ],
      "default": "featured",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "header",
      "content": "Offer card design",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "range",
      "id": "bundle_gap",
      "label": "Card gap",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "range",
      "id": "bundle_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "range",
      "id": "bundle_padding",
      "label": "Card padding",
      "min": 8,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "checkbox",
      "id": "bundle_use_custom_colors",
      "label": "Use custom colors",
      "default": false,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "color",
      "id": "bundle_background",
      "label": "Background",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "color",
      "id": "bundle_background_gradient",
      "label": "Gradient end color",
      "default": "#F3F5F7",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "checkbox",
      "id": "bundle_enable_gradient",
      "label": "Use gradient",
      "default": false,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "color",
      "id": "bundle_text_color",
      "label": "Text color",
      "default": "#06123D",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "color",
      "id": "bundle_border_color",
      "label": "Border color",
      "default": "#D9DDE3",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "color",
      "id": "bundle_active_background",
      "label": "Active background",
      "default": "#06123D",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "color",
      "id": "bundle_active_text",
      "label": "Active text",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "color",
      "id": "bundle_active_border",
      "label": "Active border",
      "default": "#06123D",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_use_custom_colors }}"
    },
    {
      "type": "header",
      "content": "Bundle 1",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "checkbox",
      "id": "bundle_1_enabled",
      "label": "Enable bundle 1",
      "default": true,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "range",
      "id": "bundle_1_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_1_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_1_label",
      "label": "Title",
      "default": "Buy 1",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_1_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_1_description",
      "label": "Description",
      "default": "Single item",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_1_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_1_savings",
      "label": "Savings text",
      "default": "save",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_1_enabled }}"
    },
    {
      "type": "text",
      "id": "bundle_1_badge",
      "label": "Badge",
      "default": "Most Popular",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_1_enabled }}"
    },
    {
      "type": "header",
      "content": "Bundle 2",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "checkbox",
      "id": "bundle_2_enabled",
      "label": "Enable bundle 2",
      "default": true,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "range",
      "id": "bundle_2_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 2,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_2_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_2_label",
      "label": "Title",
      "default": "Buy 2",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_2_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_2_description",
      "label": "Description",
      "default": "Save more",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_2_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_2_savings",
      "label": "Savings text",
      "default": "Save 5%",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_2_enabled }}"
    },
    {
      "type": "text",
      "id": "bundle_2_badge",
      "label": "Badge",
      "default": "Most popular",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_2_enabled }}"
    },
    {
      "type": "header",
      "content": "Bundle 3",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },
    {
      "type": "checkbox",
      "id": "bundle_3_enabled",
      "label": "Enable bundle 3",
      "default": true,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "range",
      "id": "bundle_3_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_3_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_3_label",
      "label": "Title",
      "default": "Buy 3",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_3_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_3_description",
      "label": "Description",
      "default": "Best value",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_3_enabled }}"
    },

    {
      "type": "text",
      "id": "bundle_3_savings",
      "label": "Savings text",
      "default": "Save 10%",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_3_enabled }}"
    },
    {
      "type": "text",
      "id": "bundle_3_badge",
      "label": "Badge",
      "default": "Best value",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' and block.settings.bundle_3_enabled }}"
    },    
    {
      "type": "header",
      "content": "Bundle 4",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "checkbox",
