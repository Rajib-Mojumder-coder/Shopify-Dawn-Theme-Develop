{%- liquid
  assign product_form_id = 'product-form-' | append: section.id

  assign quantity_type = block.settings.quantity_type

  assign min_quantity = block.settings.min_quantity | default: 1
  assign max_quantity = block.settings.max_quantity | default: 10
  assign quantity_step = block.settings.quantity_step | default: 1

  if max_quantity < min_quantity
    assign max_quantity = min_quantity
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign current_price = current_variant.price
  assign current_compare_price = current_variant.compare_at_price
-%}

<div
  id="ProductQuantity-{{ block.id }}"
  class="
    product-quantity
    product-quantity--{{ block.id }}
    product-quantity--{{ quantity_type }}
  "
  data-product-quantity
  data-quantity-type="{{ quantity_type }}"
  data-min="{{ min_quantity }}"
  data-max="{{ max_quantity }}"
  data-step="{{ quantity_step }}"
  {{ block.shopify_attributes }}
>

<style>
  #ProductQuantity-{{ block.id }} {

    /* =====================================================
       GLOBAL QUANTITY COLORS
       ===================================================== */

    {% if block.settings.use_custom_colors %}

      --product-quantity-background:
        {{ block.settings.background_color }};

      --product-quantity-text:
        {{ block.settings.text_color }};

      --product-quantity-border:
        {{ block.settings.border_color }};

      --product-quantity-active-background:
        {{ block.settings.active_background }};

      --product-quantity-active-text:
        {{ block.settings.active_text }};

      --product-quantity-active-border:
        {{ block.settings.active_border }};

      --product-quantity-button-background:
        {{ block.settings.button_background }};

      --product-quantity-button-text:
        {{ block.settings.button_text_color }};

      --product-quantity-badge-background:
        {{ block.settings.badge_background }};

      --product-quantity-badge-text:
        {{ block.settings.badge_text_color }};

    {% else %}

      --product-quantity-background:
        rgb(var(--color-background));

      --product-quantity-text:
        rgb(var(--color-foreground));

      --product-quantity-border:
        rgba(var(--color-foreground), 0.25);

      --product-quantity-active-background:
        rgb(var(--color-foreground));

      --product-quantity-active-text:
        rgb(var(--color-background));

      --product-quantity-active-border:
        rgb(var(--color-foreground));

      --product-quantity-button-background:
        transparent;

      --product-quantity-button-text:
        rgb(var(--color-foreground));

      --product-quantity-badge-background:
        rgb(var(--color-foreground));

      --product-quantity-badge-text:
        rgb(var(--color-background));

    {% endif %}


    /* =====================================================
       BUNDLE DESIGN
       ===================================================== */

    --bundle-gap:
      {{ block.settings.bundle_gap }}px;

    --bundle-radius:
      {{ block.settings.bundle_radius }}px;

    --bundle-padding:
      {{ block.settings.bundle_padding }}px;

  }


  /* =====================================================
     STANDARD QUANTITY SIZE
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--small {

    min-height: 40px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--medium {

    min-height: 46px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--large {

    min-height: 54px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--small
  .product-quantity__button {

    width: 38px;
    height: 38px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--medium
  .product-quantity__button {

    width: 44px;
    height: 44px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--large
  .product-quantity__button {

    width: 52px;
    height: 52px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--small
  .product-quantity__input {

    width: 48px;
    height: 38px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--medium
  .product-quantity__input {

    width: 56px;
    height: 44px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper--large
  .product-quantity__input {

    width: 68px;
    height: 52px;

  }


  /* =====================================================
     STANDARD QUANTITY ALIGNMENT
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__control--left {

    margin-left: 0;
    margin-right: auto;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__control--center {

    margin-left: auto;
    margin-right: auto;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__control--right {

    margin-left: auto;
    margin-right: 0;

  }


  /* =====================================================
     DROPDOWN SIZE
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__dropdown--small {

    max-width: 180px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__dropdown--medium {

    max-width: 260px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__dropdown--large {

    max-width: 360px;

  }


  /* =====================================================
     PRESET SIZE
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__presets--small
  .product-quantity__preset {

    min-height: 38px;
    padding: 0.55em 0.9em;
    font-size: 13px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__presets--medium
  .product-quantity__preset {

    min-height: 44px;
    padding: 0.7em 1.1em;
    font-size: 14px;

  }

  #ProductQuantity-{{ block.id }}
  .product-quantity__presets--large
  .product-quantity__preset {

    min-height: 52px;
    padding: 0.8em 1.25em;
    font-size: 15px;

  }


  /* =====================================================
     BUNDLE
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__bundles {

    width: 100%;

  }


  /* =====================================================
     BUNDLE IMAGE
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-image {

    flex: 0 0 auto;

    overflow: hidden;

    border-radius:
      calc(var(--bundle-radius) * 0.7);

    background:
      rgba(0, 0, 0, 0.04);

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-image--small {

    width: 48px;
    height: 48px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-image--medium {

    width: 64px;
    height: 64px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-image--large {

    width: 82px;
    height: 82px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-image img {

    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

  }


  /* =====================================================
     BUNDLE IMAGE TOP
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle--image-top {

    flex-direction: column;

    align-items: stretch;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle--image-top
  .product-quantity__bundle-image {

    align-self: center;

    margin-bottom: 10px;

  }


  /* =====================================================
     BUNDLE PRODUCT INFO
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-product-info {

    display: flex;

    flex-direction: column;

    min-width: 0;

    flex: 1;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-pricing {

    display: flex;

    flex-direction: column;

    gap: 3px;

    margin-top: 7px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-price-row {

    display: flex;

    align-items: baseline;

    gap: 7px;

    flex-wrap: wrap;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-price-label {

    font-size: 11px;

    opacity: .68;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-price {

    font-size: 13px;

    font-weight: 700;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-compare-price {

    font-size: 12px;

    opacity: .55;

    text-decoration: line-through;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-total {

    display: flex;

    align-items: baseline;

    gap: 7px;

    margin-top: 3px;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-total-label {

    font-size: 11px;

    opacity: .68;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-total-price {

    font-size: 14px;

    font-weight: 700;

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__bundle-total-compare {

    font-size: 12px;

    opacity: .55;

    text-decoration: line-through;

  }


  /* =====================================================
     THEME-CONSISTENT NON-BUNDLE CONTROLS
     ===================================================== */

  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper,
  #ProductQuantity-{{ block.id }}
  .product-quantity__select,
  #ProductQuantity-{{ block.id }}
  .product-quantity__preset {

    color:
      var(--product-quantity-text);

    border-color:
      var(--product-quantity-border);

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__stepper {

    background:
      var(--product-quantity-background);

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__select {

    background-color:
      var(--product-quantity-background);

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__preset.is-active {

    background:
      var(--product-quantity-active-background);

    color:
      var(--product-quantity-active-text);

    border-color:
      var(--product-quantity-active-border);

  }


  #ProductQuantity-{{ block.id }}
  .product-quantity__button {

    color:
      var(--product-quantity-button-text);

  }

</style>


{% if block.settings.show_label %}

  <label
    class="product-quantity__label"
    for="ProductQuantityInput-{{ block.id }}"
  >
    {{ block.settings.label }}
  </label>

{% endif %}


{%- comment -%}
==========================================================
STANDARD QUANTITY SELECTOR
==========================================================
{%- endcomment -%}

{% if quantity_type == 'stepper' %}

  <div
    class="
      product-quantity__control
      product-quantity__control--{{ block.settings.stepper_alignment }}
    "
  >

    <div
      class="
        product-quantity__stepper
        product-quantity__stepper--{{ block.settings.stepper_size }}
      "
    >

      <button
        type="button"
        class="
          product-quantity__button
          product-quantity__button--minus
        "
        data-quantity-decrease
        aria-label="Decrease quantity"
      >
        <span aria-hidden="true">−</span>
      </button>


      <input
        id="ProductQuantityInput-{{ block.id }}"
        class="
          product-quantity__input
          custom-product-form__quantity
        "
        type="number"
        name="quantity"
        value="{{ min_quantity }}"
        min="{{ min_quantity }}"
        max="{{ max_quantity }}"
        step="{{ quantity_step }}"
        inputmode="numeric"
        form="{{ product_form_id }}"
        data-quantity-input
        aria-label="{{ block.settings.label }}"
      >


      <button
        type="button"
        class="
          product-quantity__button
          product-quantity__button--plus
        "
        data-quantity-increase
        aria-label="Increase quantity"
      >
        <span aria-hidden="true">+</span>
      </button>

    </div>

  </div>


{% elsif quantity_type == 'dropdown' %}


  <div
    class="
      product-quantity__dropdown
      product-quantity__dropdown--{{ block.settings.dropdown_size }}
      product-quantity__control--{{ block.settings.dropdown_alignment }}
    "
  >

    <select
      id="ProductQuantityInput-{{ block.id }}"
      class="
        product-quantity__select
        custom-product-form__quantity
      "
      name="quantity"
      form="{{ product_form_id }}"
      data-quantity-input
      aria-label="{{ block.settings.label }}"
    >

      {% for quantity in (1..100) %}

        {% if quantity >= min_quantity
          and quantity <= max_quantity
        %}

          {% assign relative_quantity =
            quantity | minus: min_quantity
          %}

          {% assign remainder =
            relative_quantity | modulo: quantity_step
          %}

          {% if remainder == 0 %}

            <option
              value="{{ quantity }}"
              {% if quantity == min_quantity %}
                selected
              {% endif %}
            >
              {{ quantity }}
            </option>

          {% endif %}

        {% endif %}

      {% endfor %}

    </select>

  </div>


{% elsif quantity_type == 'presets' %}


  <div
    class="
      product-quantity__presets
      product-quantity__presets--{{ block.settings.presets_size }}
      product-quantity__control--{{ block.settings.presets_alignment }}
    "
    role="group"
    aria-label="{{ block.settings.label }}"
  >

    {% if block.settings.preset_1_quantity >= min_quantity
      and block.settings.preset_1_quantity <= max_quantity %}

      <button
        type="button"
        class="product-quantity__preset is-active"
        data-quantity-preset="{{ block.settings.preset_1_quantity }}"
        aria-pressed="true"
      >
        {{ block.settings.preset_1_label }}
      </button>

    {% endif %}


    {% if block.settings.preset_2_quantity >= min_quantity
      and block.settings.preset_2_quantity <= max_quantity %}

      <button
        type="button"
        class="product-quantity__preset"
        data-quantity-preset="{{ block.settings.preset_2_quantity }}"
        aria-pressed="false"
      >
        {{ block.settings.preset_2_label }}
      </button>

    {% endif %}


    {% if block.settings.preset_3_quantity >= min_quantity
      and block.settings.preset_3_quantity <= max_quantity %}

      <button
        type="button"
        class="product-quantity__preset"
        data-quantity-preset="{{ block.settings.preset_3_quantity }}"
        aria-pressed="false"
      >
        {{ block.settings.preset_3_label }}
      </button>

    {% endif %}

  </div>


  <input
    id="ProductQuantityInput-{{ block.id }}"
    class="custom-product-form__quantity"
    type="hidden"
    name="quantity"
    value="{{ block.settings.preset_1_quantity }}"
    form="{{ product_form_id }}"
    data-quantity-input
  >


{% elsif quantity_type == 'bundle' %}


  <div
    class="
      product-quantity__bundles
      product-quantity__bundles--{{ block.settings.bundle_layout }}
    "
    role="radiogroup"
    aria-label="{{ block.settings.bundle_label }}"
  >


    {%- comment -%}
    ======================================================
    BUNDLE 1
    ======================================================
    {%- endcomment -%}

    {% if block.settings.bundle_1_enabled %}

      {%- liquid

        assign bundle_quantity = block.settings.bundle_1_quantity | default: 1
        assign bundle_discount = block.settings.bundle_1_discount_percent  | default: 0  | plus: 0
        assign bundle_discount_amount = current_price | times: bundle_discount | divided_by: 100
        assign bundle_sale_unit_price = current_price | minus: bundle_discount_amount
        assign bundle_regular_total = current_price | times: bundle_quantity
        assign bundle_sale_total = bundle_sale_unit_price| times: bundle_quantity

      -%}


      <button
        type="button"
        class="
          product-quantity__bundle
          {% if block.settings.bundle_image_position == 'top' %}
            product-quantity__bundle--image-top
          {% endif %}
          is-active
        "
        data-bundle-option
        data-bundle-quantity="{{ block.settings.bundle_1_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_1_discount_code | strip | escape }}"
        aria-pressed="true"
      >


        {% if block.settings.bundle_show_image
          and product.featured_image %}

          <span
            class="
              product-quantity__bundle-image
              product-quantity__bundle-image--{{ block.settings.bundle_image_size }}
            "
          >

            {{
              product.featured_image
              | image_url: width: 240
              | image_tag:
                loading: 'lazy',
                widths: '80, 120, 160, 240',
                alt: product.title
            }}

          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-product-info">

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_1_label }}
            </span>


            {% if block.settings.bundle_1_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_1_description }}
              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_show_pricing %}

            <span class="product-quantity__bundle-pricing">


              {% if block.settings.bundle_show_unit_price %}

                <span class="product-quantity__bundle-price-row">

                  <span class="product-quantity__bundle-price-label">
                    {{ block.settings.bundle_unit_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-price">
                    {{ bundle_sale_unit_price | money }}
                  </strong>

                  {% if block.settings.bundle_show_unit_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-compare-price">
                      {{ current_price | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}


              {% if block.settings.bundle_show_total_price %}

                <span class="product-quantity__bundle-total">

                  <span class="product-quantity__bundle-total-label">
                    {{ block.settings.bundle_total_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-total-price">
                    {{ bundle_sale_total | money }}
                  </strong>

                  {% if block.settings.bundle_show_total_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-total-compare">
                      {{ bundle_regular_total | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}


            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_1_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_1_savings }}
          </span>

        {% endif %}


        {% if block.settings.bundle_1_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_1_badge }}
          </span>

        {% endif %}

      </button>

    {% endif %}



    {%- comment -%}
    ======================================================
    BUNDLE 2
    ======================================================
    {%- endcomment -%}

    {% if block.settings.bundle_2_enabled %}

      {%- liquid

        assign bundle_quantity = block.settings.bundle_2_quantity | default: 2
        assign bundle_discount = block.settings.bundle_2_discount_percent | default: 0 | plus: 0
        assign bundle_discount_amount = current_price | times: bundle_discount | divided_by: 100
        assign bundle_sale_unit_price = current_price | minus: bundle_discount_amount
        assign bundle_regular_total =  current_price | times: bundle_quantity
        assign bundle_sale_total = bundle_sale_unit_price | times: bundle_quantity

      -%}


      <button
        type="button"
        class="product-quantity__bundle"
        data-bundle-option
        data-bundle-quantity="{{ block.settings.bundle_2_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_2_discount_code | strip | escape }}"
        aria-pressed="false"
      >


        {% if block.settings.bundle_show_image
          and product.featured_image %}

          <span
            class="
              product-quantity__bundle-image
              product-quantity__bundle-image--{{ block.settings.bundle_image_size }}
            "
          >

            {{
              product.featured_image
              | image_url: width: 240
              | image_tag:
                loading: 'lazy',
                widths: '80, 120, 160, 240',
                alt: product.title
            }}

          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-product-info">

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_2_label }}
            </span>

            {% if block.settings.bundle_2_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_2_description }}
              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_show_pricing %}

            <span class="product-quantity__bundle-pricing">

              {% if block.settings.bundle_show_unit_price %}

                <span class="product-quantity__bundle-price-row">

                  <span class="product-quantity__bundle-price-label">
                    {{ block.settings.bundle_unit_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-price">
                    {{ bundle_sale_unit_price | money }}
                  </strong>

                  {% if block.settings.bundle_show_unit_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-compare-price">
                      {{ current_price | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}


              {% if block.settings.bundle_show_total_price %}

                <span class="product-quantity__bundle-total">

                  <span class="product-quantity__bundle-total-label">
                    {{ block.settings.bundle_total_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-total-price">
                    {{ bundle_sale_total | money }}
                  </strong>

                  {% if block.settings.bundle_show_total_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-total-compare">
                      {{ bundle_regular_total | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_2_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_2_savings }}
          </span>

        {% endif %}


        {% if block.settings.bundle_2_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_2_badge }}
          </span>

        {% endif %}

      </button>

    {% endif %}



    {%- comment -%}
    ======================================================
    BUNDLE 3
    ======================================================
    {%- endcomment -%}

    {% if block.settings.bundle_3_enabled %}

      {%- liquid
        assign bundle_quantity = block.settings.bundle_3_quantity | default: 3
        assign bundle_discount = block.settings.bundle_3_discount_percent | default: 0 | plus: 0
        assign bundle_discount_amount = current_price | times: bundle_discount | divided_by: 100
        assign bundle_sale_unit_price = current_price | minus: bundle_discount_amount
        assign bundle_regular_total = current_price | times: bundle_quantity
        assign bundle_sale_total = bundle_sale_unit_price | times: bundle_quantity
      -%}


      <button
        type="button"
        class="product-quantity__bundle"
        data-bundle-option
        data-bundle-quantity="{{ block.settings.bundle_3_quantity }}"
        aria-pressed="false"
      >


        {% if block.settings.bundle_show_image
          and product.featured_image %}

          <span
            class="
              product-quantity__bundle-image
              product-quantity__bundle-image--{{ block.settings.bundle_image_size }}
            "
          >

            {{
              product.featured_image
              | image_url: width: 240
              | image_tag:
                loading: 'lazy',
                widths: '80, 120, 160, 240',
                alt: product.title
            }}

          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-product-info">

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_3_label }}
            </span>

            {% if block.settings.bundle_3_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_3_description }}
              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_show_pricing %}

            <span class="product-quantity__bundle-pricing">

              {% if block.settings.bundle_show_unit_price %}

                <span class="product-quantity__bundle-price-row">

                  <span class="product-quantity__bundle-price-label">
                    {{ block.settings.bundle_unit_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-price">
                    {{ bundle_sale_unit_price | money }}
                  </strong>

                  {% if block.settings.bundle_show_unit_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-compare-price">
                      {{ current_price | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}


              {% if block.settings.bundle_show_total_price %}

                <span class="product-quantity__bundle-total">

                  <span class="product-quantity__bundle-total-label">
                    {{ block.settings.bundle_total_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-total-price">
                    {{ bundle_sale_total | money }}
                  </strong>

                  {% if block.settings.bundle_show_total_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-total-compare">
                      {{ bundle_regular_total | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_3_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_3_savings }}
          </span>

        {% endif %}


        {% if block.settings.bundle_3_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_3_badge }}
          </span>

        {% endif %}

      </button>

    {% endif %}



    {%- comment -%}
    ======================================================
    BUNDLE 4
    ======================================================
    {%- endcomment -%}

    {% if block.settings.bundle_4_enabled %}

      {%- liquid

        assign bundle_quantity = block.settings.bundle_4_quantity | default: 5
        assign bundle_discount = block.settings.bundle_4_discount_percent | default: 0 | plus: 0
        assign bundle_discount_amount = current_price | times: bundle_discount | divided_by: 100
        assign bundle_sale_unit_price = current_price | minus: bundle_discount_amount
        assign bundle_regular_total = current_price | times: bundle_quantity
        assign bundle_sale_total = bundle_sale_unit_price | times: bundle_quantity

      -%}


      <button
        type="button"
        class="product-quantity__bundle"
        data-bundle-option
        data-bundle-quantity="{{ block.settings.bundle_4_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_4_discount_code | strip | escape }}"
        aria-pressed="false"
      >


        {% if block.settings.bundle_show_image
          and product.featured_image %}

          <span
            class="
              product-quantity__bundle-image
              product-quantity__bundle-image--{{ block.settings.bundle_image_size }}
            "
          >

            {{
              product.featured_image
              | image_url: width: 240
              | image_tag:
                loading: 'lazy',
                widths: '80, 120, 160, 240',
                alt: product.title
            }}

          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-product-info">

          <span class="product-quantity__bundle-content">

            <span class="product-quantity__bundle-title">
              {{ block.settings.bundle_4_label }}
            </span>

            {% if block.settings.bundle_4_description != blank %}

              <span class="product-quantity__bundle-description">
                {{ block.settings.bundle_4_description }}
              </span>

            {% endif %}

          </span>


          {% if block.settings.bundle_show_pricing %}

            <span class="product-quantity__bundle-pricing">

              {% if block.settings.bundle_show_unit_price %}

                <span class="product-quantity__bundle-price-row">

                  <span class="product-quantity__bundle-price-label">
                    {{ block.settings.bundle_unit_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-price">
                    {{ bundle_sale_unit_price | money }}
                  </strong>

                  {% if block.settings.bundle_show_unit_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-compare-price">
                      {{ current_price | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}


              {% if block.settings.bundle_show_total_price %}

                <span class="product-quantity__bundle-total">

                  <span class="product-quantity__bundle-total-label">
                    {{ block.settings.bundle_total_price_label }}
                  </span>

                  <strong class="product-quantity__bundle-total-price">
                    {{ bundle_sale_total | money }}
                  </strong>

                  {% if block.settings.bundle_show_total_regular_price
                    and bundle_discount > 0 %}

                    <span class="product-quantity__bundle-total-compare">
                      {{ bundle_regular_total | money }}
                    </span>

                  {% endif %}

                </span>

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_4_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_4_savings }}
          </span>

        {% endif %}


        {% if block.settings.bundle_4_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_4_badge }}
          </span>

        {% endif %}

      </button>

    {% endif %}

  </div>


  {%- liquid
    assign first_bundle_quantity = block.settings.bundle_1_quantity | default: 1

    if first_bundle_quantity < min_quantity
      assign first_bundle_quantity = min_quantity
    endif

    if first_bundle_quantity > max_quantity
      assign first_bundle_quantity = min_quantity
    endif
  -%}


  <input
    id="ProductQuantityInput-{{ block.id }}"
    class="custom-product-form__quantity"
    type="hidden"
    name="quantity"
    value="{{ first_bundle_quantity }}"
    form="{{ product_form_id }}"
    data-quantity-input
  >

{% endif %}

</div>


