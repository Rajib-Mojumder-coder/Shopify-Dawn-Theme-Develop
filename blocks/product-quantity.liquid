{%- liquid
  assign product_form_id = 'product-form-' | append: section.id

  assign quantity_type = block.settings.quantity_type

  assign min_quantity = block.settings.min_quantity | default: 1
  assign max_quantity = block.settings.max_quantity | default: 10
  assign quantity_step = block.settings.quantity_step | default: 1

  if max_quantity < min_quantity
    assign max_quantity = min_quantity
  endif

  assign current_variant = product.selected_or_first_available_variant
-%}

<div
  id="ProductQuantity-{{ block.id }}"
  class="
    product-quantity
    product-quantity--{{ block.id }}
    product-quantity--{{ quantity_type }}
  "
  data-product-quantity
  data-quantity-type="{{ quantity_type }}"
  data-min="{{ min_quantity }}"
  data-max="{{ max_quantity }}"
  data-step="{{ quantity_step }}"
  {{ block.shopify_attributes }}
>

<style>
  #ProductQuantity-{{ block.id }} {

    --bundle-gap:
      {{ block.settings.bundle_gap }}px;

    --bundle-radius:
      {{ block.settings.bundle_radius }}px;

    --bundle-padding:
      {{ block.settings.bundle_padding }}px;


    /*
     * =====================================================
     * GLOBAL PRODUCT QUANTITY COLORS
     *
     * Default:
     * Uses the section color scheme.
     *
     * Custom:
     * Uses Product Quantity block colors.
     * =====================================================
     */

    {% if block.settings.use_custom_colors %}

      --quantity-background:
        {{ block.settings.background_color }};

      --quantity-text:
        {{ block.settings.text_color }};

      --quantity-border:
        {{ block.settings.border_color }};

      --quantity-active-background:
        {{ block.settings.active_background }};

      --quantity-active-text:
        {{ block.settings.active_text }};

      --quantity-active-border:
        {{ block.settings.active_border }};

      --quantity-badge-background:
        {{ block.settings.badge_background }};

      --quantity-badge-text:
        {{ block.settings.badge_text }};

      --quantity-active-badge-background:
        {{ block.settings.active_badge_background }};

      --quantity-active-badge-text:
        {{ block.settings.active_badge_text }};

    {% else %}

      /*
       * Section color scheme
       */
      --quantity-background:
        rgb(var(--color-background));

      --quantity-text:
        rgb(var(--color-foreground));

      --quantity-border:
        rgba(var(--color-foreground), 0.25);

      --quantity-active-background:
        rgb(var(--color-foreground));

      --quantity-active-text:
        rgb(var(--color-background));

      --quantity-active-border:
        rgb(var(--color-foreground));

      --quantity-badge-background:
        rgb(var(--color-foreground));

      --quantity-badge-text:
        rgb(var(--color-background));

      --quantity-active-badge-background:
        rgb(var(--color-background));

      --quantity-active-badge-text:
        rgb(var(--color-foreground));

    {% endif %}

  }
</style>


{% if block.settings.show_label %}

  <label
    class="product-quantity__label"
    for="ProductQuantityInput-{{ block.id }}"
  >
    {{ block.settings.label }}
  </label>

{% endif %}


{%- comment -%}
==========================================================
STANDARD QUANTITY SELECTOR
==========================================================
{%- endcomment -%}

{% if quantity_type == 'stepper' %}

  <div class="product-quantity__stepper">

    <button
      type="button"
      class="
        product-quantity__button
        product-quantity__button--minus
      "
      data-quantity-decrease
      aria-label="Decrease quantity"
    >
      <span aria-hidden="true">−</span>
    </button>

    <input
      id="ProductQuantityInput-{{ block.id }}"
      class="
        product-quantity__input
        custom-product-form__quantity
      "
      type="number"
      name="quantity"
      value="{{ min_quantity }}"
      min="{{ min_quantity }}"
      max="{{ max_quantity }}"
      step="{{ quantity_step }}"
      inputmode="numeric"
      form="{{ product_form_id }}"
      data-quantity-input
      aria-label="{{ block.settings.label }}"
    >

    <button
      type="button"
      class="
        product-quantity__button
        product-quantity__button--plus
      "
      data-quantity-increase
      aria-label="Increase quantity"
    >
      <span aria-hidden="true">+</span>
    </button>

  </div>


{%- comment -%}
==========================================================
DROPDOWN
==========================================================
{%- endcomment -%}

{% elsif quantity_type == 'dropdown' %}

  <div class="product-quantity__dropdown">

    <select
      id="ProductQuantityInput-{{ block.id }}"
      class="
        product-quantity__select
        custom-product-form__quantity
      "
      name="quantity"
      form="{{ product_form_id }}"
      data-quantity-input
      aria-label="{{ block.settings.label }}"
    >

      {% for quantity in (1..100) %}

        {% if quantity >= min_quantity
          and quantity <= max_quantity
        %}

          {% assign relative_quantity =
            quantity | minus: min_quantity
          %}

          {% assign remainder =
            relative_quantity | modulo: quantity_step
          %}

          {% if remainder == 0 %}

            <option
              value="{{ quantity }}"
              {% if quantity == min_quantity %}
                selected
              {% endif %}
            >
              {{ quantity }}
            </option>

          {% endif %}

        {% endif %}

      {% endfor %}

    </select>

  </div>


{%- comment -%}
==========================================================
PRESETS
==========================================================
{%- endcomment -%}

{% elsif quantity_type == 'presets' %}

  <div
    class="product-quantity__presets"
    role="group"
    aria-label="{{ block.settings.label }}"
  >

    {% if block.settings.preset_1_quantity >= min_quantity
      and block.settings.preset_1_quantity <= max_quantity
    %}

      <button
        type="button"
        class="product-quantity__preset is-active"
        data-quantity-preset="{{ block.settings.preset_1_quantity }}"
        aria-pressed="true"
      >
        {{ block.settings.preset_1_label }}
      </button>

    {% endif %}


    {% if block.settings.preset_2_quantity >= min_quantity
      and block.settings.preset_2_quantity <= max_quantity
    %}

      <button
        type="button"
        class="product-quantity__preset"
        data-quantity-preset="{{ block.settings.preset_2_quantity }}"
        aria-pressed="false"
      >
        {{ block.settings.preset_2_label }}
      </button>

    {% endif %}


    {% if block.settings.preset_3_quantity >= min_quantity
      and block.settings.preset_3_quantity <= max_quantity
    %}

      <button
        type="button"
        class="product-quantity__preset"
        data-quantity-preset="{{ block.settings.preset_3_quantity }}"
        aria-pressed="false"
      >
        {{ block.settings.preset_3_label }}
      </button>

    {% endif %}

  </div>


  <input
    id="ProductQuantityInput-{{ block.id }}"
    class="custom-product-form__quantity"
    type="hidden"
    name="quantity"
    value="{{ block.settings.preset_1_quantity }}"
    form="{{ product_form_id }}"
    data-quantity-input
  >


{%- comment -%}
==========================================================
BUNDLE & SAVE
==========================================================
UI ONLY.

Actual discounting remains controlled by Shopify.
==========================================================
{%- endcomment -%}

{% elsif quantity_type == 'bundle' %}

  <div
    class="
      product-quantity__bundles
      product-quantity__bundles--{{ block.settings.bundle_layout }}
    "
    role="radiogroup"
    aria-label="{{ block.settings.bundle_label }}"
  >


    {% if block.settings.bundle_1_enabled %}

      {%- liquid
        assign bundle_quantity = block.settings.bundle_1_quantity | default: 1
        assign discount_percent = block.settings.bundle_1_discount_percent | default: 0

        assign regular_total = current_variant.price | times: bundle_quantity
        assign discount_amount = regular_total | times: discount_percent | divided_by: 100
        assign discounted_total = regular_total | minus: discount_amount 
        assign discounted_unit_price = discounted_total | divided_by: bundle_quantity
      -%}

      <button
        type="button"
        class="product-quantity__bundle is-active"
        data-bundle-option
        data-bundle-quantity="{{ bundle_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_1_discount_code | strip | escape }}"
        aria-pressed="true"
      >

        {% if block.settings.bundle_1_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_1_badge }}
          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-content">

          <span class="product-quantity__bundle-title">
            {{ block.settings.bundle_1_label }}
          </span>

          {% if block.settings.bundle_1_description != blank %}

            <span class="product-quantity__bundle-description">
              {{ block.settings.bundle_1_description }}
            </span>

          {% endif %}


          {% if block.settings.bundle_show_price %}

            <span class="product-quantity__bundle-price">

              {% if discount_percent > 0 %}

                <span class="product-quantity__bundle-price-current">
                  {{ discounted_unit_price | money }}
                  / item
                </span>

                <span class="product-quantity__bundle-price-original">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% else %}

                <span class="product-quantity__bundle-price-current">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% endif %}

            </span>


            <span class="product-quantity__bundle-total">

              {% if discount_percent > 0 %}

                {{ discounted_total | money }}

                {% if block.settings.bundle_show_original_total %}

                  <del>
                    {{ regular_total | money }}
                  </del>

                {% endif %}

              {% else %}

                {{ regular_total | money }}

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_1_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_1_savings }}
          </span>

        {% endif %}

      </button>

    {% endif %}



    {% if block.settings.bundle_2_enabled %}

      {%- liquid
        assign bundle_quantity = block.settings.bundle_2_quantity | default: 2
        assign discount_percent = block.settings.bundle_2_discount_percent | default: 0
        assign regular_total = current_variant.price | times: bundle_quantity
        assign discount_amount = regular_total | times: discount_percent | divided_by: 100
        assign discounted_total = regular_total | minus: discount_amount
        assign discounted_unit_price = discounted_total | divided_by: bundle_quantity
      -%}

      <button
        type="button"
        class="product-quantity__bundle"
        data-bundle-option
        data-bundle-quantity="{{ bundle_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_2_discount_code | strip | escape }}"
        aria-pressed="false"
      >

        {% if block.settings.bundle_2_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_2_badge }}
          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-content">

          <span class="product-quantity__bundle-title">
            {{ block.settings.bundle_2_label }}
          </span>

          {% if block.settings.bundle_2_description != blank %}

            <span class="product-quantity__bundle-description">
              {{ block.settings.bundle_2_description }}
            </span>

          {% endif %}


          {% if block.settings.bundle_show_price %}

            <span class="product-quantity__bundle-price">

              {% if discount_percent > 0 %}

                <span class="product-quantity__bundle-price-current">
                  {{ discounted_unit_price | money }}
                  / item
                </span>

                <span class="product-quantity__bundle-price-original">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% else %}

                <span class="product-quantity__bundle-price-current">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% endif %}

            </span>


            <span class="product-quantity__bundle-total">

              {% if discount_percent > 0 %}

                {{ discounted_total | money }}

                {% if block.settings.bundle_show_original_total %}

                  <del>
                    {{ regular_total | money }}
                  </del>

                {% endif %}

              {% else %}

                {{ regular_total | money }}

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_2_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_2_savings }}
          </span>

        {% endif %}

      </button>

    {% endif %}



    {% if block.settings.bundle_3_enabled %}

      {%- liquid
        assign bundle_quantity = block.settings.bundle_3_quantity | default: 3
        assign discount_percent = block.settings.bundle_3_discount_percent | default: 0

        assign regular_total = current_variant.price | times: bundle_quantity
        assign discount_amount = regular_total | times: discount_percent | divided_by: 100
        assign discounted_total = regular_total | minus: discount_amount
        assign discounted_unit_price = discounted_total | divided_by: bundle_quantity
      -%}

      <button
        type="button"
        class="product-quantity__bundle"
        data-bundle-option
        data-bundle-quantity="{{ bundle_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_3_discount_code | strip | escape }}"
        aria-pressed="false"
      >

        {% if block.settings.bundle_3_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_3_badge }}
          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-content">

          <span class="product-quantity__bundle-title">
            {{ block.settings.bundle_3_label }}
          </span>

          {% if block.settings.bundle_3_description != blank %}

            <span class="product-quantity__bundle-description">
              {{ block.settings.bundle_3_description }}
            </span>

          {% endif %}


          {% if block.settings.bundle_show_price %}

            <span class="product-quantity__bundle-price">

              {% if discount_percent > 0 %}

                <span class="product-quantity__bundle-price-current">
                  {{ discounted_unit_price | money }}
                  / item
                </span>

                <span class="product-quantity__bundle-price-original">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% else %}

                <span class="product-quantity__bundle-price-current">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% endif %}

            </span>


            <span class="product-quantity__bundle-total">

              {% if discount_percent > 0 %}

                {{ discounted_total | money }}

                {% if block.settings.bundle_show_original_total %}

                  <del>
                    {{ regular_total | money }}
                  </del>

                {% endif %}

              {% else %}

                {{ regular_total | money }}

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_3_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_3_savings }}
          </span>

        {% endif %}

      </button>

    {% endif %}



    {% if block.settings.bundle_4_enabled %}

      {%- liquid
        assign bundle_quantity = block.settings.bundle_4_quantity | default: 5
        assign discount_percent = block.settings.bundle_4_discount_percent | default: 0

        assign regular_total = current_variant.price | times: bundle_quantity

        assign discount_amount = regular_total | times: discount_percent | divided_by: 100
        assign discounted_total = regular_total | minus: discount_amount
        assign discounted_unit_price = discounted_total | divided_by: bundle_quantity
      -%}

      <button
        type="button"
        class="product-quantity__bundle"
        data-bundle-option
        data-bundle-quantity="{{ bundle_quantity }}"
        data-bundle-discount-code="{{ block.settings.bundle_4_discount_code | strip | escape }}"
        aria-pressed="false"
      >

        {% if block.settings.bundle_4_badge != blank %}

          <span class="product-quantity__bundle-badge">
            {{ block.settings.bundle_4_badge }}
          </span>

        {% endif %}


        <span class="product-quantity__bundle-radio">
          <span class="product-quantity__bundle-radio-dot"></span>
        </span>


        <span class="product-quantity__bundle-content">

          <span class="product-quantity__bundle-title">
            {{ block.settings.bundle_4_label }}
          </span>

          {% if block.settings.bundle_4_description != blank %}

            <span class="product-quantity__bundle-description">
              {{ block.settings.bundle_4_description }}
            </span>

          {% endif %}


          {% if block.settings.bundle_show_price %}

            <span class="product-quantity__bundle-price">

              {% if discount_percent > 0 %}

                <span class="product-quantity__bundle-price-current">
                  {{ discounted_unit_price | money }}
                  / item
                </span>

                <span class="product-quantity__bundle-price-original">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% else %}

                <span class="product-quantity__bundle-price-current">
                  {{ current_variant.price | money }}
                  / item
                </span>

              {% endif %}

            </span>


            <span class="product-quantity__bundle-total">

              {% if discount_percent > 0 %}

                {{ discounted_total | money }}

                {% if block.settings.bundle_show_original_total %}

                  <del>
                    {{ regular_total | money }}
                  </del>

                {% endif %}

              {% else %}

                {{ regular_total | money }}

              {% endif %}

            </span>

          {% endif %}

        </span>


        {% if block.settings.bundle_4_savings != blank %}

          <span class="product-quantity__bundle-savings">
            {{ block.settings.bundle_4_savings }}
          </span>

        {% endif %}

      </button>

    {% endif %}

  </div>


  {%- liquid
    assign first_bundle_quantity =  block.settings.bundle_1_quantity | default: 1

    if first_bundle_quantity < min_quantity
      assign first_bundle_quantity = min_quantity
    endif

    if first_bundle_quantity > max_quantity
      assign first_bundle_quantity = min_quantity
    endif
  -%}

  <input
    id="ProductQuantityInput-{{ block.id }}"
    class="custom-product-form__quantity"
    type="hidden"
    name="quantity"
    value="{{ first_bundle_quantity }}"
    form="{{ product_form_id }}"
    data-quantity-input
  >

{% endif %}

</div>


{% schema %}

{
  "name": "Product quantity",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Quantity"
    },

    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Quantity"
    },

    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label",
      "default": true
    },

    {
      "type": "select",
      "id": "quantity_type",
      "label": "Display type",
      "options": [
        {
          "value": "stepper",
          "label": "Quantity selector"
        },
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "presets",
          "label": "Quantity presets"
        },
        {
          "value": "bundle",
          "label": "Bundle & save"
        }
      ],
      "default": "stepper"
    },


    {
      "type": "header",
      "content": "Quantity limits"
    },

    {
      "type": "range",
      "id": "min_quantity",
      "label": "Minimum quantity",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 1
    },

    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 10
    },

    {
      "type": "range",
      "id": "quantity_step",
      "label": "Quantity step",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 1
    },


    {
      "type": "header",
      "content": "Design"
    },

    {
      "type": "paragraph",
      "content": "By default, this block uses the color scheme of the Product Information section. Enable custom colors to override it for this block."
    },

    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "label": "Use custom colors",
      "default": false
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D9DDE3",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "active_background",
      "label": "Active background",
      "default": "#111111",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "active_text",
      "label": "Active text",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "active_border",
      "label": "Active border",
      "default": "#111111",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#111111",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "active_badge_background",
      "label": "Active badge background",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "active_badge_text",
      "label": "Active badge text",
      "default": "#111111",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },


    {
      "type": "header",
      "content": "Preset 1",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "range",
      "id": "preset_1_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 1,
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "text",
      "id": "preset_1_label",
      "label": "Label",
      "default": "1 item",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },


    {
      "type": "header",
      "content": "Preset 2",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "range",
      "id": "preset_2_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 2,
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "text",
      "id": "preset_2_label",
      "label": "Label",
      "default": "2 items",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },


    {
      "type": "header",
      "content": "Preset 3",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "range",
      "id": "preset_3_quantity",
      "label": "Quantity",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },

    {
      "type": "text",
      "id": "preset_3_label",
      "label": "Label",
      "default": "3 items",
      "visible_if": "{{ block.settings.quantity_type == 'presets' }}"
    },


    {
      "type": "header",
      "content": "Bundle & save",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "text",
      "id": "bundle_label",
      "label": "Section label",
      "default": "Choose your quantity",
      "visible_if": "{{ block.settings.quantity_type == 'bundle' }}"
    },

    {
      "type": "select",
      "id": "bundle_layout",
      "label": "Offer layout",
