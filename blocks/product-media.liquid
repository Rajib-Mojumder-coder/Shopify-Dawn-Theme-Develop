{%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'-%}

<div
  class="product-final__media"
  id="ProductMedia-{{ block.id }}"
  {{ block.shopify_attributes }}
>

  <div class="product-final__media-inner">

    {% render 'product-media-gallery-global',
      product: product, section: section, block: block, variant_images: variant_images
    %}
    {% comment %} {% render 'product-media-gallery-final',
      variant_images: variant_images,
      block: block
    %} {% endcomment %}

  </div>

</div>

{% schema %}
{
  "name": "Product Media",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "info": "Carousel is always used on mobile",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Grid",
      "visible_if": "{{ block.settings.gallery_layout == 'grid' }}"
    },
     {
      "type": "select",
      "id": "grid_column",
      "label": "Columns",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" }
      ],
      "default": "2",
      "visible_if": "{{ block.settings.gallery_layout == 'grid' }}"
    },
    {
      "type": "range",
      "id": "grid_column_gap",
      "label": "Gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.gallery_layout == 'grid' }}"
    },
    {
      "type": "checkbox",
      "id": "full_width_first_image",
      "label": "Full width first image",
      "default": false,
      "visible_if": "{{ block.settings.gallery_layout == 'grid' and block.settings.grid_column == '2' }}"
    },
    {
      "type": "header",
      "content": "Carousel",
      "visible_if": "{{ block.settings.gallery_layout == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "carosel_icon",
      "label": "Icons",
      "options": [
        { "label": "Arrows", "value": "arrows" },
        { "label": "Cheverons", "value": "cheverons" },
        { "label": "Large Arrows", "value": "large_arrows" },
        { "label": "Large Cheverons", "value": "large_cheverons" },
        { "label": "Custom", "value": "custom_svg_code" }
      ],
      "default": "arrows",
      "visible_if": "{{ block.settings.gallery_layout == 'carousel' }}"
    },
     {
      "type": "select",
      "id": "carousel_slides",
      "label": "Desktop slides",
      "info": "Use 1.33 for one full image plus approximately one-third of the next image.",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "1.25",
          "value": "1.25"
        },
        {
          "label": "1.33",
          "value": "1.33"
        },
        {
          "label": "1.5",
          "value": "1.5"
        },
        {
          "label": "2",
          "value": "2"
        }
      ],
      "default": "1"
    },
     {
      "type": "select",
      "id": "mobile_slides",
      "label": "Mobile slides",
      "options": [
        {
          "label": "1",
          "value": "1"
        },
        {
          "label": "1.1",
          "value": "1.1"
        },
        {
          "label": "1.25",
          "value": "1.25"
        },
        {
          "label": "1.33",
          "value": "1.33"
        }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "desktop_pagination",
      "label": "Desktop Pagination",
      "default": false,
      "visible_if": "{{ block.settings.gallery_layout == 'carousel'}}"
    },
    {
      "type": "select",
      "id": "desktop_pagination_type",
      "label": "Desktop Pagination Type",
      "options": [
        { "label": "Thumbnails", "value": "thumbnails" },
        { "label": "Dots", "value": "dots" },
        { "label": "Counter", "value": "counter" }
      ],
      "default": "thumbnails",
      "visible_if": "{{ block.settings.gallery_layout == 'carousel' and block.settings.desktop_pagination }}"
    },
    {
      "type": "checkbox",
      "id": "mobile_pagination",
      "label": "Mobile Pagination",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_pagination_type",
      "label": "Mobile Pagination Type",
      "options": [
        { "label": "Thumbnails", "value": "thumbnails" },
        { "label": "Dots", "value": "dots" },
        { "label": "Counter", "value": "counter" },
        { "label": "Hint", "value": "hint" }
      ],
      "default": "thumbnails",
      "visible_if": "{{ block.settings.mobile_pagination }}"
    },
    {
      "type": "header",
      "content": "Thumbnails"
    },
    {
      "type": "select",
      "id": "thumbnail_desktop_position",
      "label": "Desktop Position",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Bottom", "value": "bottom" },
        { "label": "Right", "value": "right" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "thumbnail_desktop_width",
      "label": "Desktop Width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "thumbnail_mobile_width",
      "label": "Mobile Width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "thumbnail_corner_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Aspect Ratio",
      "options": [
        { "label": "Auto", "value": "auto" },
        { "label": "Portrait", "value": "portrait" },
        { "label": "Square", "value": "square" },
        { "label": "Landscape", "value": "landscape" }
      ],
      "default": "auto"
    },
   {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        { "value": "contain", "label": "Contain" },
        { "value": "cover", "label": "Cover" }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "constrain_to_screen_height",
      "label": "Constrain to screen height",
      "default": true
    },
    {
      "type": "range",
      "id": "media_corner_radius",
      "label": "Corner Radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "extent_media_to_screen_edge",
      "label": "Extend media to screen edge",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_media_zoom",
      "label": "Enable Zoom",
      "default": false
    },
    {
      "type": "select",
      "id": "image_zoom",
      "label": "Image zoom",
      "options": [
        { "value": "lightbox", "label": "Open lightbox" },
        { "value": "hover", "label": "Zoom on hover" }
      ],
      "default": "lightbox",
      "visible_if": "{{ block.settings.enable_media_zoom }}"
    },
    {
      "type": "header",
      "content": "Variant media"
    },
    {
      "type": "checkbox",
      "id": "hide_variants",
      "label": "Hide variant media",
      "default": false
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "video looping",
      "default": false
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "checkbox",
      "id": "media_padding",
      "label": "Padding",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.media_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.media_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.media_padding == true }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.media_padding == true }}"
    }
  ]
}
{% endschema %}