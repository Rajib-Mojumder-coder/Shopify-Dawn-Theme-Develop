{%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'-%}

<div
  class="product-final__media"
  {{ block.shopify_attributes }}
>

  <div class="product-final__media-inner">

    {% render 'custom-product-media-gallery',
      variant_images: variant_images
    %}

  </div>

</div>

{% schema %}
{
  "name": "Product Media",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "info": "Carousel is always used on mobile",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Grid",
      "visible_if": "{{ block.settings.gallery_layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "grid_column",
      "label": "Colums",
      "options": [
        { "label": "1", "value": "1" },
        { "label": "2", "value": "2" }
      ]
    },
    {
      "type": "range",
      "id": "grid_column_gap",
      "label": "Gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.gallery_layout == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "label": "Mobile layout",
      "options": [
        {
          "value": "columns",
          "label": "2 columns"
        },
        {
          "value": "show",
          "label": "Show thumbnails"
        },
        {
          "value": "hide",
          "label": "Hide thumbnails"
        }
      ],
      "default": "hide"
    },

    {
      "type": "select",
      "id": "image_zoom",
      "label": "Image zoom",
      "options": [
        {
          "value": "lightbox",
          "label": "Open lightbox"
        },
        {
          "value": "hover",
          "label": "Zoom on hover"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "lightbox"
    },

    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ],
      "default": "contain"
    },

    {
      "type": "checkbox",
      "id": "constrain_to_viewport",
      "label": "Constrain media to viewport",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "hide_variants",
      "label": "Hide variant media",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Enable video looping",
      "default": false
    }

  ]
}
{% endschema %}