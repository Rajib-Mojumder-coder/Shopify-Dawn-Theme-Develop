{%- liquid
  assign product_form_id = 'product-form-' | append: section.id

  assign selected_variant = product.selected_or_first_available_variant

  assign use_custom_colors = block.settings.use_custom_colors

  if use_custom_colors

    assign button_background = block.settings.button_background
    assign button_text_color = block.settings.button_text_color
    assign button_border_color = block.settings.button_border_color

    assign button_hover_background = block.settings.button_hover_background
    assign button_hover_text = block.settings.button_hover_text

    assign button_disabled_background = block.settings.button_disabled_background
    assign button_disabled_text = block.settings.button_disabled_text

  else

    assign button_background = 'rgb(var(--color-button))'
    assign button_text_color = 'rgb(var(--color-button-text))'
    assign button_border_color = 'rgb(var(--color-button))'

    assign button_hover_background = 'rgb(var(--color-button-text))'
    assign button_hover_text = 'rgb(var(--color-button))'

    assign button_disabled_background = 'rgba(var(--color-foreground), 0.12)'
    assign button_disabled_text = 'rgba(var(--color-foreground), 0.5)'

  endif
-%}


<div
  id="ProductBuyButtons-{{ block.id }}"
  class="
    product-buy-buttons
    product-buy-buttons--{{ block.id }}
    product-buy-buttons--width-{{ block.settings.button_width }}
    product-buy-buttons--align-{{ block.settings.button_alignment }}
  "
  data-product-buy-buttons
  data-product-id="{{ product.id }}"
  data-product-form-id="{{ product_form_id }}"
  data-available-text="{{ block.settings.add_to_cart_text | escape }}"
  data-sold-out-text="{{ block.settings.sold_out_text | escape }}"
  {{ block.shopify_attributes }}

  style="
    --buy-button-radius: {{ block.settings.button_radius }}px;
    --buy-button-border-width: {{ block.settings.button_border_width }}px;

    --buy-button-background: {{ button_background }};
    --buy-button-text: {{ button_text_color }};
    --buy-button-border: {{ button_border_color }};

    --buy-button-hover-background: {{ button_hover_background }};
    --buy-button-hover-text: {{ button_hover_text }};

    --buy-button-disabled-background: {{ button_disabled_background }};
    --buy-button-disabled-text: {{ button_disabled_text }};
  "
>


  {% if block.settings.show_add_to_cart %}

    <button
      id="ProductSubmitButton-{{ block.id }}"
      type="submit"
      name="add"

      class="
        product-buy-buttons__add
        product-buy-buttons__add--{{ block.settings.button_size }}
      "

      form="{{ product_form_id }}"

      {% unless selected_variant.available %}
        disabled
      {% endunless %}

      aria-live="polite"
    >

      <span class="product-buy-buttons__text">

        {% if selected_variant.available %}

          {{ block.settings.add_to_cart_text }}

        {% else %}

          {{ block.settings.sold_out_text }}

        {% endif %}

      </span>


      {% if block.settings.show_cart_icon %}

        <span
          class="product-buy-buttons__icon"
          aria-hidden="true"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 8h12l-1 12H7L6 8Z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>

        </span>

      {% endif %}


      {%- comment -%}
        IMPORTANT:
        Dawn's product-form.js expects this exact
        loading spinner class.
      {%- endcomment -%}

      <span
        class="loading__spinner hidden"
        aria-hidden="true"
      >
        <svg
          aria-hidden="true"
          focusable="false"
          class="spinner"
          viewBox="0 0 66 66"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            class="path"
            fill="none"
            stroke-width="6"
            cx="33"
            cy="33"
            r="30"
          ></circle>
        </svg>
      </span>

    </button>

  {% endif %}


  {% if block.settings.show_dynamic_checkout %}

    <div class="product-buy-buttons__dynamic">

      {{ form | payment_button }}

    </div>

  {% endif %}

</div>


<style>

  /* =====================================================
     OUTER
     ===================================================== */

  .product-buy-buttons--{{ block.id }} {
    display: flex;
    flex-direction: column;

    width: 100%;

    gap: 10px;
  }


  /* =====================================================
     ALIGNMENT
     ===================================================== */

  .product-buy-buttons--align-left {
    align-items: flex-start;
  }

  .product-buy-buttons--align-center {
    align-items: center;
  }

  .product-buy-buttons--align-right {
    align-items: flex-end;
  }


  /* =====================================================
     WIDTH
     ===================================================== */

  .product-buy-buttons--width-full
  .product-buy-buttons__add,
  .product-buy-buttons--width-full
  .product-buy-buttons__dynamic {
    width: 100%;
  }


  .product-buy-buttons--width-75
  .product-buy-buttons__add,
  .product-buy-buttons--width-75
  .product-buy-buttons__dynamic {
    width: 75%;
  }


  .product-buy-buttons--width-50
  .product-buy-buttons__add,
  .product-buy-buttons--width-50
  .product-buy-buttons__dynamic {
    width: 50%;
  }


  .product-buy-buttons--width-auto
  .product-buy-buttons__add,
  .product-buy-buttons--width-auto
  .product-buy-buttons__dynamic {
    width: auto;
  }


  /* =====================================================
     ADD TO CART BUTTON
     ===================================================== */

  .product-buy-buttons--{{ block.id }}
  .product-buy-buttons__add {

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    min-width: 0;

    padding:
      0
      20px;

    border:
      var(--buy-button-border-width)
      solid
      var(--buy-button-border);

    border-radius:
      var(--buy-button-radius);

    background:
      var(--buy-button-background);

    color:
      var(--buy-button-text);

    font: inherit;

    font-weight: 600;

    line-height: 1;

    cursor: pointer;

    appearance: none;
    -webkit-appearance: none;

    transition:
      background-color 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      opacity 180ms ease;
  }


  /* =====================================================
     BUTTON SIZE
     ===================================================== */

  .product-buy-buttons__add--small {
    min-height: 42px;

    font-size: 14px;
  }


  .product-buy-buttons__add--medium {
    min-height: 48px;

    font-size: 15px;
  }


  .product-buy-buttons__add--large {
    min-height: 56px;

    font-size: 16px;
  }


  /* =====================================================
     HOVER
     ===================================================== */

  @media (hover: hover) {

    .product-buy-buttons--{{ block.id }}
    .product-buy-buttons__add:hover:not(:disabled) {

      background:
        var(--buy-button-hover-background);

      color:
        var(--buy-button-hover-text);

      border-color:
        var(--buy-button-hover-background);

      transform:
        translateY(-1px);
    }

  }


  /* =====================================================
     DISABLED
     ===================================================== */

  .product-buy-buttons--{{ block.id }}
  .product-buy-buttons__add:disabled {

    background:
      var(--buy-button-disabled-background);

    color:
      var(--buy-button-disabled-text);

    border-color:
      var(--buy-button-disabled-background);

    cursor: not-allowed;

    opacity: 0.7;
  }


  /* =====================================================
     TEXT
     ===================================================== */

  .product-buy-buttons__text {
    display: inline-flex;

    align-items: center;
    justify-content: center;
  }


  /* =====================================================
     CART ICON
     Right of text
     ===================================================== */

  .product-buy-buttons__icon {

    display: inline-flex;

    align-items: center;
    justify-content: center;

    flex: 0 0 18px;

    width: 18px;
    height: 18px;
  }


  .product-buy-buttons__icon svg {

    display: block;

    width: 100%;
    height: 100%;
  }


  /* =====================================================
     SHOPIFY LOADING SPINNER
     ===================================================== */

  .product-buy-buttons__add
  .loading__spinner {

    width: 18px;
    height: 18px;

    position: absolute;

    left: 50%;
    top: 50%;

    transform:
      translate(-50%, -50%);
  }


  .product-buy-buttons__add
  .loading__spinner svg {

    width: 100%;
    height: 100%;
  }


  .product-buy-buttons__add
  .loading__spinner.hidden {

    display: none;
  }


  /* =====================================================
     DYNAMIC CHECKOUT
     ===================================================== */

  .product-buy-buttons__dynamic {
    max-width: 100%;
  }


  .product-buy-buttons__dynamic
  .shopify-payment-button {

    width: 100%;
  }


  .product-buy-buttons__dynamic
  .shopify-payment-button__button {

    width: 100%;

    min-height: 48px;

    border-radius:
      var(--buy-button-radius);
  }


  /* =====================================================
     MOBILE
     ===================================================== */

  @media screen and (max-width: 749px) {

    .product-buy-buttons--width-75
    .product-buy-buttons__add,
    .product-buy-buttons--width-75
    .product-buy-buttons__dynamic {

      width: 100%;
    }


    .product-buy-buttons--width-50
    .product-buy-buttons__add,
    .product-buy-buttons--width-50
    .product-buy-buttons__dynamic {

      width: 100%;
    }


    .product-buy-buttons--width-auto
    .product-buy-buttons__add {

      width: auto;
      max-width: 100%;
    }

  }

</style>


{% schema %}
{
  "name": "Product buy buttons",

  "settings": [

    {
      "type": "header",
      "content": "Add to cart"
    },

    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to cart",
      "default": true
    },

    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Button text",
      "default": "Add to cart",
      "visible_if": "{{ block.settings.show_add_to_cart }}"
    },

    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out text",
      "default": "Sold out",
      "visible_if": "{{ block.settings.show_add_to_cart }}"
    },

    {
      "type": "checkbox",
      "id": "show_cart_icon",
      "label": "Show cart icon",
      "default": false,
      "visible_if": "{{ block.settings.show_add_to_cart }}"
    },


    {
      "type": "header",
      "content": "Accelerated checkout"
    },

    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout",
      "info": "Uses the accelerated payment methods available for the store.",
      "default": false
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "button_width",
      "label": "Button width",
      "options": [
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "75",
          "label": "75%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "auto",
          "label": "Auto"
        }
      ],
      "default": "full"
    },

    {
      "type": "select",
      "id": "button_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },


    {
      "type": "header",
      "content": "Style"
    },

    {
      "type": "range",
      "id": "button_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 8
    },

    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },

    {
      "type": "checkbox",
      "id": "use_custom_colors",
      "label": "Use custom colors",
      "default": false
    },

    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#06123D",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color",
      "default": "#06123D",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#1A2C5C",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "button_hover_text",
      "label": "Hover text color",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "button_disabled_background",
      "label": "Disabled background",
      "default": "#E5E7EB",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    },

    {
      "type": "color",
      "id": "button_disabled_text",
      "label": "Disabled text color",
      "default": "#6B7280",
      "visible_if": "{{ block.settings.use_custom_colors }}"
    }

  ],

  "presets": [
    {
      "name": "Product buy buttons"
    }
  ]
}
{% endschema %}