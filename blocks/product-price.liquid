{%- liquid
  assign variant = product.selected_or_first_available_variant

  assign current_price = variant.price
  assign compare_price = variant.compare_at_price

  assign on_sale = false

  if compare_price > current_price
    assign on_sale = true
  endif

  assign show_current_price = block.settings.show_current_price
  assign show_compare_price = block.settings.show_compare_price
  assign hide_compare_without_discount = block.settings.hide_compare_without_discount

  assign price_format = block.settings.price_format
  assign round_price = block.settings.round_price

  assign content_width = block.settings.content_width
  assign text_alignment = block.settings.text_alignment

  assign current_price_mobile = block.settings.current_price_mobile
  assign current_price_desktop = block.settings.current_price_desktop

  assign compare_price_mobile = block.settings.compare_price_mobile
  assign compare_price_desktop = block.settings.compare_price_desktop

  assign current_price_weight = block.settings.current_price_weight
  assign compare_price_weight = block.settings.compare_price_weight

  assign sale_badge_enabled = block.settings.show_sale_badge
  assign sale_badge_type = block.settings.sale_badge_type
  assign sale_badge_position = block.settings.sale_badge_position

  assign padding_top = block.settings.padding_top
  assign padding_bottom = block.settings.padding_bottom
  assign padding_left = block.settings.padding_left
  assign padding_right = block.settings.padding_right

  if round_price
    assign current_price = current_price | divided_by: 100.0 | round | times: 100

    if compare_price
      assign compare_price = compare_price | divided_by: 100.0 | round | times: 100
    endif
  endif

  if compare_price and compare_price > current_price
    assign on_sale = true
  endif
-%}


{%- capture current_price_html -%}
  {%- case price_format -%}
    {%- when 'money_with_currency' -%}
      {{ current_price | money_with_currency }}

    {%- when 'money_without_currency' -%}
      {{ current_price | money_without_currency }}

    {%- when 'money_without_trailing_zeros' -%}
      {{ current_price | money_without_trailing_zeros }}

    {%- else -%}
      {{ current_price | money }}
  {%- endcase -%}
{%- endcapture -%}


{%- capture compare_price_html -%}
  {%- case price_format -%}
    {%- when 'money_with_currency' -%}
      {{ compare_price | money_with_currency }}

    {%- when 'money_without_currency' -%}
      {{ compare_price | money_without_currency }}

    {%- when 'money_without_trailing_zeros' -%}
      {{ compare_price | money_without_trailing_zeros }}

    {%- else -%}
      {{ compare_price | money }}
  {%- endcase -%}
{%- endcapture -%}


<div
  id="ProductPrice-{{ block.id }}"
  class="product-price product-price--{{ block.id }}"
  data-product-price-scope
  data-product-id="{{ product.id }}"
  data-variant-id="{{ variant.id }}"
  data-round-price="{{ round_price }}"
  data-price-format="{{ price_format }}"
  data-hide-compare-without-discount="{{ hide_compare_without_discount }}"
  {{ block.shopify_attributes }}
>

  <div class="product-price__inner">

    <div
      class="
        product-price__display
        product-price__display--{{ text_alignment }}
      "
      data-price-display
    >

      {%- if show_current_price -%}

        <span
          class="product-price__current"
          data-product-price
        >
          {{ current_price_html }}
        </span>

      {%- endif -%}


      {%- if show_compare_price -%}

        <span
          class="product-price__compare"
          data-compare-price
          {% unless on_sale %}
            hidden
          {% endunless %}
        >
          {{ compare_price_html }}
        </span>

      {%- endif -%}


      {%- if sale_badge_enabled and on_sale -%}

        {%- assign savings_amount = compare_price | minus: current_price -%}

        {%- assign savings_percentage = savings_amount
          | times: 100
          | divided_by: compare_price
          | round
        -%}

        <span
          class="
            product-price__badge
            product-price__badge--{{ sale_badge_position }}
          "
          data-sale-badge
        >

          {%- case sale_badge_type -%}

            {%- when 'percentage' -%}
              {{ savings_percentage }}% OFF

            {%- when 'amount' -%}
              Save {{ savings_amount | money }}

            {%- else -%}
              SALE

          {%- endcase -%}

        </span>

      {%- endif -%}

    </div>

  </div>


  {%- comment -%}
  ==========================================================
  PRE-RENDERED VARIANT PRICE DATA

  Your existing custom-product-price.js can use these
  templates when the selected variant changes.
  ==========================================================
  {%- endcomment -%}

  <div
    class="product-price__variant-data"
    hidden
    aria-hidden="true"
  >

    {%- for product_variant in product.variants -%}

      {%- liquid
        assign variant_price = product_variant.price
        assign variant_compare_price = product_variant.compare_at_price

        assign variant_on_sale = false

        if variant_compare_price and variant_compare_price > variant_price
          assign variant_on_sale = true
        endif

        if round_price
          assign variant_price = variant_price | divided_by: 100.0 | round | times: 100
          if variant_compare_price
            assign variant_compare_price = variant_compare_price | divided_by: 100.0 | round | times: 100
          endif
        endif
      -%}


      <template
        data-variant-price-template="{{ product_variant.id }}"
      >

        <div class="product-price__display">

          {%- if show_current_price -%}

            <span
              class="product-price__current"
              data-product-price
            >

              {%- case price_format -%}

                {%- when 'money_with_currency' -%}
                  {{ variant_price | money_with_currency }}

                {%- when 'money_without_currency' -%}
                  {{ variant_price | money_without_currency }}

                {%- when 'money_without_trailing_zeros' -%}
                  {{ variant_price | money_without_trailing_zeros }}

                {%- else -%}
                  {{ variant_price | money }}

              {%- endcase -%}

            </span>

          {%- endif -%}


          {%- if show_compare_price -%}

            <span
              class="product-price__compare"
              data-compare-price
              {% unless variant_on_sale %}
                hidden
              {% endunless %}
            >

              {%- if variant_compare_price -%}

                {%- case price_format -%}

                  {%- when 'money_with_currency' -%}
                    {{ variant_compare_price | money_with_currency }}

                  {%- when 'money_without_currency' -%}
                    {{ variant_compare_price | money_without_currency }}

                  {%- when 'money_without_trailing_zeros' -%}
                    {{ variant_compare_price | money_without_trailing_zeros }}

                  {%- else -%}
                    {{ variant_compare_price | money }}

                {%- endcase -%}

              {%- endif -%}

            </span>

          {%- endif -%}


          {%- if sale_badge_enabled and variant_on_sale -%}

            {%- assign variant_savings_amount =
              variant_compare_price
              | minus: variant_price
            -%}

            {%- assign variant_savings_percentage =
              variant_savings_amount
              | times: 100
              | divided_by: variant_compare_price
              | round
            -%}

            <span
              class="
                product-price__badge
                product-price__badge--{{ sale_badge_position }}
              "
              data-sale-badge
            >

              {%- case sale_badge_type -%}

                {%- when 'percentage' -%}
                  {{ variant_savings_percentage }}% OFF

                {%- when 'amount' -%}
                  Save {{ variant_savings_amount | money }}

                {%- else -%}
                  SALE

              {%- endcase -%}

            </span>

          {%- endif -%}

        </div>

      </template>

    {%- endfor -%}

  </div>

</div>


<style>

  /* ==========================================================
   PRODUCT PRICE
   ========================================================== */

.product-price {
  position: relative;
  width: 100%;
  color: rgb(var(--color-foreground));
}

.product-price__display {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}


/* ==========================================================
   CURRENT PRICE
   ========================================================== */

.product-price__current {
  display: inline-block;

  font-size: clamp(17px, 2.5vw, 20px);
  font-weight: 700;
  line-height: 1.2;

  color: rgb(var(--color-foreground));
}

.product-price__current--large {
  font-size: clamp(22px, 3vw, 30px);
}


/* ==========================================================
   COMPARE-AT PRICE
   ========================================================== */

.product-price__compare {
  display: inline-block;

  font-size: clamp(14px, 2vw, 16px);
  line-height: 1.2;

  color: rgba(var(--color-foreground), 0.55);

  text-decoration: line-through;
}

.product-price__compare--full {
  width: 100%;
}


/* ==========================================================
   COMPARE PRICE BEFORE CURRENT PRICE
   ========================================================== */

.product-price--compare-before
.product-price__display {
  flex-direction: row;
}


/*
   Because the markup already places compare price first,
   normal mode needs CSS order adjustment.
*/

.product-price:not(.product-price--compare-before)
.product-price__current {
  order: 1;
}

.product-price:not(.product-price--compare-before)
.product-price__compare {
  order: 2;
}

.product-price--compare-before
.product-price__compare {
  order: 1;
}

.product-price--compare-before
.product-price__current {
  order: 2;
}


/* ==========================================================
   SALE BADGE
   ========================================================== */

.product-price__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 5px 12px;

  border-radius: 4px;

  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;

  letter-spacing: 0.3px;
  white-space: nowrap;

  background: #ff0000;
  color: #ffffff;

  transition: transform 0.2s ease;
}


/* Inline */

.product-price__badge--inline {
  position: static;
}


/* Top right */

.product-price__badge--top-right {
  position: absolute;

  top: -12px;
  right: 0;

  z-index: 2;
}


/* Top left */

.product-price__badge--top-left {
  position: absolute;

  top: -12px;
  left: 0;

  z-index: 2;
}


/* ==========================================================
   BADGE HOVER
   ========================================================== */

.product-price__badge:hover {
  transform: scale(1.05);
}


/* ==========================================================
   MOBILE
   ========================================================== */

@media screen and (max-width: 749px) {

  .product-price__current {
    font-size: clamp(17px, 4vw, 20px);
  }

  .product-price__current--large {
    font-size: clamp(21px, 5vw, 26px);
  }

  .product-price__compare {
    font-size: 14px;
  }

  .product-price__badge {
    padding: 4px 9px;
    font-size: 11px;
  }

  .product-price__badge--top-right,
  .product-price__badge--top-left {
    top: -8px;
  }

}

</style>


{% schema %}
{
  "name": "Product price",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Current price"
    },

    {
      "type": "checkbox",
      "id": "show_current_price",
      "label": "Show current price",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "large_price",
      "label": "Large price",
      "default": false,
      "visible_if": "{{ block.settings.show_current_price }}"
    },

    {
      "type": "select",
      "id": "price_format",
      "label": "Money format",
      "default": "money",
      "options": [
        {
          "label": "Money",
          "value": "money"
        },
        {
          "label": "Money with currency",
          "value": "money_with_currency"
        },
        {
          "label": "Money without currency",
          "value": "money_without_currency"
        },
        {
          "label": "Money without trailing zeros",
          "value": "money_without_trailing_zeros"
        }
      ],
      "visible_if": "{{ block.settings.show_current_price }}"
    },

    {
      "type": "checkbox",
      "id": "round_price",
      "label": "Round price",
      "default": false,
      "visible_if": "{{ block.settings.show_current_price }}"
    },


    {
      "type": "header",
      "content": "Compare-at price"
    },

    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "hide_compare_without_discount",
      "label": "Hide when no discount",
      "default": true,
      "visible_if": "{{ block.settings.show_compare_price }}"
    },

    {
      "type": "checkbox",
      "id": "compare_price_before",
      "label": "Show compare-at price first",
      "default": false,
      "visible_if": "{{ block.settings.show_compare_price }}"
    },

    {
      "type": "checkbox",
      "id": "compare_full_width",
      "label": "Full width",
      "default": false,
      "visible_if": "{{ block.settings.show_compare_price }}"
    },


    {
      "type": "header",
      "content": "Sale badge"
    },

    {
      "type": "checkbox",
      "id": "show_custom_sale_badge",
      "label": "Show sale badge",
      "default": true
    },

    {
      "type": "select",
      "id": "sale_badge_type",
      "label": "Badge display type",
      "default": "percentage",

      "options": [
        {
          "value": "text",
          "label": "Text (SALE)"
        },
        {
          "value": "percentage",
          "label": "Percentage (33% OFF)"
        },
        {
          "value": "amount",
          "label": "Amount (Save $100)"
        }
      ],

      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    },

    {
      "type": "select",
      "id": "sale_badge_position",
      "label": "Badge position",
      "default": "inline",

      "options": [
        {
          "value": "inline",
          "label": "Inline with price"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "top-left",
          "label": "Top left"
        }
      ],

      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    },

    {
      "type": "color",
      "id": "sale_badge_bg_color",
      "label": "Badge background",
      "default": "#FF0000",
      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    },

    {
      "type": "color",
      "id": "sale_badge_text_color",
      "label": "Badge text color",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    }

  ],

  "presets": [
    {
      "name": "Product price"
    }
  ]
}
{% endschema %}