{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign current_price = current_variant.price
  assign compare_price = current_variant.compare_at_price

  assign has_discount = false

  if compare_price > current_price
    assign has_discount = true
  endif

  assign sale_percentage = 0
  assign sale_amount = 0

  if has_discount
    assign sale_amount = compare_price | minus: current_price
    assign sale_percentage = sale_amount | times: 100 | divided_by: compare_price
  endif

  assign current_price_format = block.settings.price_format

  if block.settings.round_price
    assign current_price = current_price | divided_by: 100 | round | times: 100
  endif
-%}

<div
  id="ProductPrice-{{ block.id }}"
  class="
    product-price
    product-price--{{ block.id }}
    {% if block.settings.compare_price_before %}
      product-price--compare-before
    {% endif %}
  "
  {{ block.shopify_attributes }}
>

  <div class="product-price__display">

    {%- comment -%}
      ==========================================================
      COMPARE-AT PRICE
      ==========================================================
    {%- endcomment -%}

    {% if block.settings.show_compare_price and has_discount %}

      <span
        class="
          product-price__compare
          {% if block.settings.compare_full_width %}
            product-price__compare--full
          {% endif %}
        "
        data-product-compare-price
      >
        {{ compare_price | money }}
      </span>

    {% elsif block.settings.show_compare_price
      and block.settings.hide_compare_without_discount == false
      and compare_price > 0
    %}

      <span
        class="
          product-price__compare
          {% if block.settings.compare_full_width %}
            product-price__compare--full
          {% endif %}
        "
        data-product-compare-price
      >
        {{ compare_price | money }}
      </span>

    {% endif %}


    {%- comment -%}
      ==========================================================
      CURRENT PRICE
      ==========================================================
    {%- endcomment -%}

    {% if block.settings.show_current_price %}

      <span
        class="
          product-price__current
          {% if block.settings.large_price %}
            product-price__current--large
          {% endif %}
        "
        data-product-current-price
      >

        {% case current_price_format %}

          {% when 'money_with_currency' %}
            {{ current_price | money_with_currency }}

          {% when 'money_without_currency' %}
            {{ current_price | money_without_currency }}

          {% when 'money_without_trailing_zeros' %}
            {{ current_price | money_without_trailing_zeros }}

          {% else %}
            {{ current_price | money }}

        {% endcase %}

      </span>

    {% endif %}


    {%- comment -%}
      ==========================================================
      SALE BADGE
      ==========================================================
    {%- endcomment -%}

    {% if block.settings.show_custom_sale_badge and has_discount %}

      <span
        class="
          product-price__badge

          {% if block.settings.sale_badge_position == 'inline' %}
            product-price__badge--inline
          {% elsif block.settings.sale_badge_position == 'top-right' %}
            product-price__badge--top-right
          {% elsif block.settings.sale_badge_position == 'top-left' %}
            product-price__badge--top-left
          {% endif %}
        "
        data-product-sale-badge
      >

        {% case block.settings.sale_badge_type %}

          {% when 'text' %}
            SALE

          {% when 'percentage' %}
            {{ sale_percentage }}% OFF

          {% when 'amount' %}
            Save {{ sale_amount | money }}

        {% endcase %}

      </span>

    {% endif %}

  </div>

</div>


<style>

  /* ==========================================================
   PRODUCT PRICE
   ========================================================== */

.product-price {
  position: relative;
  width: 100%;
  color: rgb(var(--color-foreground));
}

.product-price__display {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}


/* ==========================================================
   CURRENT PRICE
   ========================================================== */

.product-price__current {
  display: inline-block;

  font-size: clamp(17px, 2.5vw, 20px);
  font-weight: 700;
  line-height: 1.2;

  color: rgb(var(--color-foreground));
}

.product-price__current--large {
  font-size: clamp(22px, 3vw, 30px);
}


/* ==========================================================
   COMPARE-AT PRICE
   ========================================================== */

.product-price__compare {
  display: inline-block;

  font-size: clamp(14px, 2vw, 16px);
  line-height: 1.2;

  color: rgba(var(--color-foreground), 0.55);

  text-decoration: line-through;
}

.product-price__compare--full {
  width: 100%;
}


/* ==========================================================
   COMPARE PRICE BEFORE CURRENT PRICE
   ========================================================== */

.product-price--compare-before
.product-price__display {
  flex-direction: row;
}


/*
   Because the markup already places compare price first,
   normal mode needs CSS order adjustment.
*/

.product-price:not(.product-price--compare-before)
.product-price__current {
  order: 1;
}

.product-price:not(.product-price--compare-before)
.product-price__compare {
  order: 2;
}

.product-price--compare-before
.product-price__compare {
  order: 1;
}

.product-price--compare-before
.product-price__current {
  order: 2;
}


/* ==========================================================
   SALE BADGE
   ========================================================== */

.product-price__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 5px 12px;

  border-radius: 4px;

  font-size: 13px;
  font-weight: 700;
  line-height: 1.2;

  letter-spacing: 0.3px;
  white-space: nowrap;

  background: #ff0000;
  color: #ffffff;

  transition: transform 0.2s ease;
}


/* Inline */

.product-price__badge--inline {
  position: static;
}


/* Top right */

.product-price__badge--top-right {
  position: absolute;

  top: -12px;
  right: 0;

  z-index: 2;
}


/* Top left */

.product-price__badge--top-left {
  position: absolute;

  top: -12px;
  left: 0;

  z-index: 2;
}


/* ==========================================================
   BADGE HOVER
   ========================================================== */

.product-price__badge:hover {
  transform: scale(1.05);
}


/* ==========================================================
   MOBILE
   ========================================================== */

@media screen and (max-width: 749px) {

  .product-price__current {
    font-size: clamp(17px, 4vw, 20px);
  }

  .product-price__current--large {
    font-size: clamp(21px, 5vw, 26px);
  }

  .product-price__compare {
    font-size: 14px;
  }

  .product-price__badge {
    padding: 4px 9px;
    font-size: 11px;
  }

  .product-price__badge--top-right,
  .product-price__badge--top-left {
    top: -8px;
  }

}

</style>


{% schema %}
{
  "name": "Product price",
  "tag": null,

  "settings": [

    {
      "type": "header",
      "content": "Current price"
    },

    {
      "type": "checkbox",
      "id": "show_current_price",
      "label": "Show current price",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "large_price",
      "label": "Large price",
      "default": false,
      "visible_if": "{{ block.settings.show_current_price }}"
    },

    {
      "type": "select",
      "id": "price_format",
      "label": "Money format",
      "default": "money",
      "options": [
        {
          "label": "Money",
          "value": "money"
        },
        {
          "label": "Money with currency",
          "value": "money_with_currency"
        },
        {
          "label": "Money without currency",
          "value": "money_without_currency"
        },
        {
          "label": "Money without trailing zeros",
          "value": "money_without_trailing_zeros"
        }
      ],
      "visible_if": "{{ block.settings.show_current_price }}"
    },

    {
      "type": "checkbox",
      "id": "round_price",
      "label": "Round price",
      "default": false,
      "visible_if": "{{ block.settings.show_current_price }}"
    },


    {
      "type": "header",
      "content": "Compare-at price"
    },

    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare-at price",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "hide_compare_without_discount",
      "label": "Hide when no discount",
      "default": true,
      "visible_if": "{{ block.settings.show_compare_price }}"
    },

    {
      "type": "checkbox",
      "id": "compare_price_before",
      "label": "Show compare-at price first",
      "default": false,
      "visible_if": "{{ block.settings.show_compare_price }}"
    },

    {
      "type": "checkbox",
      "id": "compare_full_width",
      "label": "Full width",
      "default": false,
      "visible_if": "{{ block.settings.show_compare_price }}"
    },


    {
      "type": "header",
      "content": "Sale badge"
    },

    {
      "type": "checkbox",
      "id": "show_custom_sale_badge",
      "label": "Show sale badge",
      "default": true
    },

    {
      "type": "select",
      "id": "sale_badge_type",
      "label": "Badge display type",
      "default": "percentage",

      "options": [
        {
          "value": "text",
          "label": "Text (SALE)"
        },
        {
          "value": "percentage",
          "label": "Percentage (33% OFF)"
        },
        {
          "value": "amount",
          "label": "Amount (Save $100)"
        }
      ],

      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    },

    {
      "type": "select",
      "id": "sale_badge_position",
      "label": "Badge position",
      "default": "inline",

      "options": [
        {
          "value": "inline",
          "label": "Inline with price"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "top-left",
          "label": "Top left"
        }
      ],

      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    },

    {
      "type": "color",
      "id": "sale_badge_bg_color",
      "label": "Badge background",
      "default": "#FF0000",
      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    },

    {
      "type": "color",
      "id": "sale_badge_text_color",
      "label": "Badge text color",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.show_custom_sale_badge }}"
    }

  ],

  "presets": [
    {
      "name": "Product price"
    }
  ]
}
{% endschema %}