{% liquid

  assign source_type = block.settings.source_type

  assign selected_collection = block.settings.collection
  assign selected_collections = block.settings.collections
  assign selected_products = block.settings.products

  assign product_count = block.settings.product_count

  assign desktop_columns = block.settings.desktop_columns
  assign tablet_columns = block.settings.tablet_columns
  assign mobile_columns = block.settings.mobile_columns

  assign aspect_ratio = block.settings.aspect_ratio
  assign aspect_width = block.settings.aspect_width
  assign aspect_height = block.settings.aspect_height

  assign image_fit = block.settings.image_fit

  assign show_image = block.settings.show_image
  assign show_vendor = block.settings.show_vendor
  assign show_title = block.settings.show_title
  assign show_price = block.settings.show_price
  assign show_compare_price = block.settings.show_compare_price

  assign image_radius = block.settings.image_radius

%}


<div
  class="
    collection-product-slider-block
    collection-product-slider-block-{{ block.id }}
  "
  {{ block.shopify_attributes }}
>

  {% case source_type %}


    {% when 'collection' %}

      
    {% assign selected_collection = block.settings.collection %}
      {% if selected_collection != blank %}

        <div class="collection-product-grid">

          {% for product in selected_collection.products limit: product_count %}

            {% render 'custom-slider-product-card',
              product: product,
              block: block
            %}

          {% endfor %}

        </div>

      {% endif %}


    {% when 'collection_list' %}

      {% if selected_collections != blank %}

        <div class="collection-product-grid">

          {% for collection in selected_collections %}

            {% for product in collection.products limit: product_count %}

              {% render 'custom-slider-product-card',
                product: product,
                block: block
              %}

            {% endfor %}

          {% endfor %}

        </div>

      {% endif %}


    {% when 'products' %}

      {% if selected_products != blank %}

        <div class="collection-product-grid">

          {% for product in selected_products %}

            {% render 'custom-slider-product-card',
              product: product,
              block: block
            %}

          {% endfor %}

        </div>

      {% endif %}


  {% endcase %}

</div>


<style>

.collection-product-slider-block-{{ block.id }} {

  width: 100%;

  --product-columns-desktop:
    {{ desktop_columns }};

  --product-columns-tablet:
    {{ tablet_columns }};

  --product-columns-mobile:
    {{ mobile_columns }};

  --product-image-radius:
    {{ image_radius }}px;

  --product-image-fit:
    {{ image_fit }};

}


/* =========================================================
   PRODUCT GRID
========================================================= */

.collection-product-slider-block-{{ block.id }}
.collection-product-grid {

  display: grid;

  grid-template-columns:
    repeat(
      var(--product-columns-desktop),
      minmax(0, 1fr)
    );

  gap: 24px;

  width: 100%;

}


/* =========================================================
   PRODUCT CARD
========================================================= */

.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card {

  min-width: 0;

  width: 100%;

}


/* =========================================================
   PRODUCT IMAGE
========================================================= */

.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__image {

  display: block;

  width: 100%;

  overflow: hidden;

  border-radius:
    var(--product-image-radius);

  line-height: 0;

  aspect-ratio:
    {{ aspect_width }} / {{ aspect_height }};

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__image img,

.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__image .placeholder-svg {

  display: block;

  width: 100%;
  height: 100%;

  object-fit:
    var(--product-image-fit);

  border-radius:
    var(--product-image-radius);

}


/* =========================================================
   PRODUCT CONTENT
========================================================= */

.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__content {

  padding-top: 12px;

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__vendor {

  margin-bottom: 5px;

  font-size: 12px;

  line-height: 1.3;

  opacity: .65;

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__title {

  margin: 0;

  font-size: 16px;

  line-height: 1.35;

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__title a {

  color: inherit;

  text-decoration: none;

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__price {

  display: flex;

  align-items: center;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 8px;

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__current-price {

  font-size: 15px;

  font-weight: 600;

}


.collection-product-slider-block-{{ block.id }}
.custom-slider-product-card__compare-price {

  font-size: 14px;

  text-decoration: line-through;

  opacity: .55;

}


/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 1023px) {

  .collection-product-slider-block-{{ block.id }}
  .collection-product-grid {

    grid-template-columns:
      repeat(
        var(--product-columns-tablet),
        minmax(0, 1fr)
      );

    gap: 20px;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  .collection-product-slider-block-{{ block.id }}
  .collection-product-grid {

    grid-template-columns:
      repeat(
        var(--product-columns-mobile),
        minmax(0, 1fr)
      );

    gap: 16px;

  }


  .collection-product-slider-block-{{ block.id }}
  .custom-slider-product-card__title {

    font-size: 14px;

  }

}

</style>


{% schema %}

{
  "name": "Collection Product",

  "class": "swiper-slide",

  "settings": [

    {
      "type": "header",
      "content": "Content Source"
    },

    {
      "type": "select",
      "id": "source_type",
      "label": "Source Type",

      "default": "collection",

      "options": [
        {
          "value": "collection",
          "label": "Collection"
        },
        {
          "value": "collection_list",
          "label": "Collection List"
        },
        {
          "value": "products",
          "label": "Products"
        }
      ]
    },


    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },


    {
      "type": "collection_list",
      "id": "collections",
      "label": "Select Collections",

      "limit": 20
    },


    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products",

      "limit": 50
    },


    {
      "type": "range",
      "id": "product_count",
      "label": "Products Per Collection",

      "min": 1,
      "max": 24,
      "step": 1,

      "default": 8,

      "info":
        "Used for Collection and Collection List sources. Product List uses all selected products."
    },


    {
      "type": "header",
      "content": "Product Layout"
    },


    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop Columns",

      "min": 1,
      "max": 6,
      "step": 1,

      "default": 4
    },


    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet Columns",

      "min": 1,
      "max": 4,
      "step": 1,

      "default": 3
    },


    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile Columns",

      "min": 1,
      "max": 3,
      "step": 1,

      "default": 2
    },


    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",

      "min": 0,
      "max": 50,
      "step": 1,

      "unit": "px",

      "default": 24
    },


    {
      "type": "header",
      "content": "Image Aspect Ratio"
    },


    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect Ratio",

      "default": "square",

      "options": [
        {
          "value": "square",
          "label": "Square 1:1"
        },
        {
          "value": "portrait-4-5",
          "label": "Portrait 4:5"
        },
        {
          "value": "portrait-3-4",
          "label": "Portrait 3:4"
        },
        {
          "value": "portrait-2-3",
          "label": "Portrait 2:3"
        },
        {
          "value": "landscape-4-3",
          "label": "Landscape 4:3"
        },
        {
          "value": "landscape-3-2",
          "label": "Landscape 3:2"
        },
        {
          "value": "landscape-16-9",
          "label": "Landscape 16:9"
        },
        {
          "value": "wide-21-9",
          "label": "Wide 21:9"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },


    {
      "type": "range",
      "id": "aspect_width",
      "label": "Custom Ratio Width",

      "min": 1,
      "max": 100,
      "step": 1,

      "default": 1,

      "info":
        "Used for Custom aspect ratio."
    },


    {
      "type": "range",
      "id": "aspect_height",
      "label": "Custom Ratio Height",

      "min": 1,
      "max": 100,
      "step": 1,

      "default": 1,

      "info":
        "Used for Custom aspect ratio."
    },


    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",

      "default": "cover",

      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },


    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Border Radius",

      "min": 0,
      "max": 50,
      "step": 1,

      "unit": "px",

      "default": 12
    },


    {
      "type": "header",
      "content": "Product Information"
    },


    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Product Image",

      "default": true
    },


    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",

      "default": false
    },


    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Product Title",

      "default": true
    },


    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",

      "default": true
    },


    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show Compare Price",

      "default": true
    }

  ],


  "presets": [
    {
      "name": "Collection Product"
    }
  ]
}

{% endschema %}