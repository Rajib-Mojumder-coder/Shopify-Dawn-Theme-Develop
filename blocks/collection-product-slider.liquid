{% liquid
  assign source_type = block.settings.source_type

  assign product_count = block.settings.product_count
  assign desktop_columns = block.settings.desktop_columns
  assign tablet_columns = block.settings.tablet_columns
  assign mobile_columns = block.settings.mobile_columns

  assign image_ratio = block.settings.image_ratio

  assign show_image = block.settings.show_image
  assign show_vendor = block.settings.show_vendor
  assign show_title = block.settings.show_title
  assign show_price = block.settings.show_price
  assign show_compare_price = block.settings.show_compare_price

  assign image_radius = block.settings.image_radius
%}


{% comment %}
  ============================================================
  SINGLE COLLECTION
  One selected collection -> multiple product slides
  ============================================================
{% endcomment %}

{% case block.settings.source_type %}

  {% when 'collection' %}

  {% assign selected_collection = block.settings.collection %}

  {% for product in selected_collection.products limit: product_count %}

    <div
      class="swiper-slide collection-product-slide"
      {% if forloop.first %}{{ block.shopify_attributes }}{% endif %}
    >

      <div
        class="collection-product-card"
        style="--product-image-radius: {{ image_radius }}px;"
      >

        {% if show_image %}
          <a
            href="{{ product.url }}"
            class="collection-product-card__image"
          >

            {% if product.featured_image != blank %}

              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >

            {% else %}

              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}

            {% endif %}

          </a>
        {% endif %}


        <div class="collection-product-card__content">

          {% if show_vendor and product.vendor != blank %}
            <div class="collection-product-card__vendor">
              {{ product.vendor }}
            </div>
          {% endif %}


          {% if show_title %}
            <h3 class="collection-product-card__title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>
          {% endif %}


          {% if show_price %}

            <div class="collection-product-card__price">

              {% if product.compare_at_price > product.price
                and show_compare_price
              %}

                <span class="collection-product-card__compare-price">
                  {{ product.compare_at_price | money }}
                </span>

              {% endif %}

              <span class="collection-product-card__current-price">
                {{ product.price | money }}
              </span>

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  {% endfor %}



 {% comment %}===========  COLLECTION LIST  Multiple collections -> 
 products from each collection ==============={% endcomment %}
 {% when 'collection_list' %}

  {% for selected_collection in block.settings.collections %}

    {% for product in selected_collection.products limit: product_count %}

      <div
        class="swiper-slide collection-product-slide"
        {% if forloop.first and forloop.parentloop.first %}
          {{ block.shopify_attributes }}
        {% endif %}
      >

        <div
          class="collection-product-card"
          style="--product-image-radius: {{ image_radius }}px;"
        >

          {% if show_image %}

            <a
              href="{{ product.url }}"
              class="collection-product-card__image"
            >

              {% if product.featured_image != blank %}

                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >

              {% else %}

                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}

              {% endif %}

            </a>

          {% endif %}


          <div class="collection-product-card__content">

            {% if show_vendor and product.vendor != blank %}
              <div class="collection-product-card__vendor">
                {{ product.vendor }}
              </div>
            {% endif %}


            {% if show_title %}
              <h3 class="collection-product-card__title">
                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>
              </h3>
            {% endif %}


            {% if show_price %}

              <div class="collection-product-card__price">

                {% if product.compare_at_price > product.price
                  and show_compare_price
                %}

                  <span class="collection-product-card__compare-price">
                    {{ product.compare_at_price | money }}
                  </span>

                {% endif %}

                <span class="collection-product-card__current-price">
                  {{ product.price | money }}
                </span>

              </div>

            {% endif %}

          </div>

        </div>

      </div>

    {% endfor %}

  {% endfor %}


{% comment %}================== PRODUCT LIST
  Multiple manually selected products  =============={% endcomment %}
  {% when 'products' %}

  {% for product in block.settings.products %}

    <div
      class="swiper-slide collection-product-slide"
      {% if forloop.first %}{{ block.shopify_attributes }}{% endif %}
    >

      <div
        class="collection-product-card"
        style="--product-image-radius: {{ image_radius }}px;"
      >

        {% if show_image %}

          <a
            href="{{ product.url }}"
            class="collection-product-card__image"
          >

            {% if product.featured_image != blank %}

              <img
                src="{{ product.featured_image | image_url: width: 800 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >

            {% else %}

              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}

            {% endif %}

          </a>

        {% endif %}


        <div class="collection-product-card__content">

          {% if show_vendor and product.vendor != blank %}
            <div class="collection-product-card__vendor">
              {{ product.vendor }}
            </div>
          {% endif %}


          {% if show_title %}
            <h3 class="collection-product-card__title">
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h3>
          {% endif %}


          {% if show_price %}

            <div class="collection-product-card__price">

              {% if product.compare_at_price > product.price
                and show_compare_price
              %}

                <span class="collection-product-card__compare-price">
                  {{ product.compare_at_price | money }}
                </span>

              {% endif %}

              <span class="collection-product-card__current-price">
                {{ product.price | money }}
              </span>

            </div>

          {% endif %}

        </div>

      </div>

    </div>

  {% endfor %}

{% endcase %}


<style>

.collection-product-slide {
  height: auto;
}

.collection-product-card {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.collection-product-card__image {
  display: block;
  width: 100%;
  overflow: hidden;
  border-radius: var(--product-image-radius);
  line-height: 0;
}

.collection-product-card__image img,
.collection-product-card__image .placeholder-svg {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: var(--product-image-radius);
}

.collection-product-card__content {
  padding-top: 14px;
}

.collection-product-card__vendor {
  margin-bottom: 5px;
  font-size: 12px;
  line-height: 1.3;
  opacity: .65;
}

.collection-product-card__title {
  margin: 0;
  font-size: 16px;
  line-height: 1.35;
}

.collection-product-card__title a {
  color: inherit;
  text-decoration: none;
}

.collection-product-card__price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.collection-product-card__current-price {
  font-size: 15px;
  font-weight: 600;
}

.collection-product-card__compare-price {
  font-size: 14px;
  text-decoration: line-through;
  opacity: .55;
}

@media screen and (max-width: 749px) {

  .collection-product-card__content {
    padding-top: 10px;
  }

  .collection-product-card__title {
    font-size: 14px;
  }

}

</style>



{% schema %}
{
  "name": "Collection Product Slider",
  "settings": [
    {
      "type": "select",
      "id": "source_type",
      "label": "Content Source",
      "default": "collection",
      "options": [
        {
          "value": "collection",
          "label": "Single Collection"
        },
        {
          "value": "collection_list",
          "label": "Collection List"
        },
        {
          "value": "products",
          "label": "Products"
        }
      ]
    },

    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },

    {
      "type": "collection_list",
      "id": "collections",
      "label": "Select Collections",
      "limit": 8
    },

    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products",
      "limit": 50
    },

    {
      "type": "range",
      "id": "product_count",
      "label": "Products per Collection",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 8
    },

    {
      "type": "header",
      "content": "Product Layout"
    },

    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop Columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },

    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },

    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },

    {
      "type": "header",
      "content": "Product Content"
    },

    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show Product Image",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": false
    },

    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show Product Title",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show Compare Price",
      "default": true
    },

    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Border Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],

  "presets": [
    {
      "name": "Collection Product Slider"
    }
  ]
}
{% endschema %}
