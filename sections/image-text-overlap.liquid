
{{ 'image-text-overlap.css' | asset_url | stylesheet_tag }}


{% liquid
  assign overlap_image = section.settings.image
  assign image_ratio = 1

  if overlap_image != blank
    assign image_ratio = overlap_image.aspect_ratio
  endif

  assign desktop_offset = section.settings.desktop_offset_px | append: 'px'

  if section.settings.desktop_offset_unit == 'percent'
    assign desktop_offset = section.settings.desktop_offset_percent | append: '%'
  endif

  assign mobile_offset = section.settings.mobile_offset_px | append: 'px'
  assign mobile_visible_ratio = 1

  if section.settings.mobile_offset_unit == 'percent'
    assign mobile_offset = section.settings.mobile_offset_percent | append: '%'
    assign mobile_visible_ratio = 100 | plus: section.settings.mobile_offset_percent
    assign mobile_visible_ratio = mobile_visible_ratio | divided_by: 100.0
  endif

  assign desktop_image_column = 2
  assign desktop_content_column = 1

  if section.settings.desktop_image_side == 'left'
    assign desktop_image_column = 1
    assign desktop_content_column = 2
  endif

  assign mobile_image_left = '0'
  assign mobile_image_right = 'auto'

  if section.settings.mobile_image_alignment == 'right'
    assign mobile_image_left = 'auto'
    assign mobile_image_right = '0'
  endif

  assign mobile_media_height = 'max(0px, calc(92vw / var(--ito-image-ratio) + var(--ito-mobile-offset)))'

  if section.settings.mobile_offset_unit == 'percent'
    assign mobile_media_height = 'calc(92vw / var(--ito-image-ratio) * var(--ito-mobile-visible-ratio))'
  endif

  assign desktop_media_margin_left = '0px'
assign desktop_media_margin_right = 'calc(-1 * max(0px, (100vw - var(--page-width, 120rem)) / 2))'

if section.settings.desktop_image_side == 'left'
  assign desktop_media_margin_left = 'calc(-1 * max(0px, (100vw - var(--page-width, 120rem)) / 2))'
  assign desktop_media_margin_right = '0px'
endif

assign desktop_padding_top = 0
assign desktop_padding_bottom = 0
assign mobile_padding_top = 0
assign mobile_padding_bottom = 0

if section.settings.enable_desktop_padding
  assign desktop_padding_top = section.settings.desktop_section_padding_top
  assign desktop_padding_bottom = section.settings.desktop_section_padding_bottom
endif

if section.settings.enable_mobile_padding
  assign mobile_padding_top = section.settings.mobile_section_padding_top
  assign mobile_padding_bottom = section.settings.mobile_section_padding_bottom
endif
%}


<section
  id="ImageTextOverlap-{{ section.id }}"
  class="image-text-overlap image-text-overlap--{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  style="
      --ito-desktop-image-column: {{ desktop_image_column }};
    --ito-desktop-content-column: {{ desktop_content_column }};

    --ito-mobile-image-left: {{ mobile_image_left }};
    --ito-mobile-image-right: {{ mobile_image_right }};

    --ito-mobile-media-height: {{ mobile_media_height }};
    --ito-desktop-offset: {{ desktop_offset }};
    --ito-mobile-offset: {{ mobile_offset }};
    --ito-mobile-visible-ratio: {{ mobile_visible_ratio }};
    --ito-image-height: {{ section.settings.desktop_image_height }}px;
    --ito-image-ratio: {{ image_ratio }};
    --ito-section-padding-top: {{ desktop_padding_top }}px;
    --ito-section-padding-bottom: {{ desktop_padding_bottom }}px;
    --ito-mobile-padding-top: {{ mobile_padding_top }}px;
    --ito-mobile-padding-bottom: {{ mobile_padding_bottom }}px;
    --ito-content-max-width: {{ section.settings.content_max_width }}px;
    --ito-column-gap: {{ section.settings.column_gap }}px;
    --ito-image-width: {{ section.settings.desktop_image_width }}%;
    --ito-image-fit: {{ section.settings.image_fit }};
    --ito-image-position: {{ section.settings.image_position }};
    --ito-desktop-radius-top-left: {{ section.settings.desktop_radius_top_left }}px;
    --ito-desktop-radius-top-right: {{ section.settings.desktop_radius_top_right }}px;
    --ito-desktop-radius-bottom-right: {{ section.settings.desktop_radius_bottom_right }}px;
    --ito-desktop-radius-bottom-left: {{ section.settings.desktop_radius_bottom_left }}px;

    --ito-mobile-radius-top-left: {{ section.settings.mobile_radius_top_left }}px;
    --ito-mobile-radius-top-right: {{ section.settings.mobile_radius_top_right }}px;
    --ito-mobile-radius-bottom-right: {{ section.settings.mobile_radius_bottom_right }}px;
    --ito-mobile-radius-bottom-left: {{ section.settings.mobile_radius_bottom_left }}px;
    --ito-desktop-margin-left: {{ desktop_media_margin_left }};
    --ito-desktop-margin-right: {{ desktop_media_margin_right }};
  "
>
  {% if overlap_image != blank %}
    <div class="image-text-overlap__media">
      {{
        overlap_image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '375,550,750,990,1200,1500,1800,2000,2400',
          sizes: '(min-width: 750px) 70vw, 100vw',
          class: 'image-text-overlap__image',
          alt: overlap_image.alt
      }}
    </div>
  {% endif %}

  <div class="image-text-overlap__inner page-width">
    <div class="image-text-overlap__content">
      {% if section.settings.subheading != blank %}
        <p class="image-text-overlap__subheading">
          {{ section.settings.subheading | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="image-text-overlap__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="image-text-overlap__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% render 'custom-global-button',
        button_text: section.settings.button_label,
        button_link: section.settings.button_link,
        transparent: false
      %}

    </div>

    <div class="image-text-overlap__spacer" aria-hidden="true"></div>
  </div>
</section>
{% comment %} 
<style>
  @media screen and (max-width: 749px) {
  .image-text-overlap__media {
    {% if section.settings.mobile_offset_unit == 'percent' %}
      height: calc(
        100vw / var(--ito-image-ratio) *
        var(--ito-mobile-visible-ratio)
      );
    {% else %}
      height: max(
        0px,
        calc(100vw / var(--ito-image-ratio) + var(--ito-mobile-offset))
      );
    {% endif %}
  }
}
</style> {% endcomment %}

{% schema %}
{
  "name": "Image Text Overlap",
  "tag": "section",
  "class": "section-image-text-overlap",
  "settings": [
    
    {
      "type": "select",
      "id": "desktop_image_side",
      "label": "Desktop Image",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_image_alignment",
      "label": "Mobile Image",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover More"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your Main Heading Goes Here"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Add your description here to introduce your product or service.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "label": "Desktop Image Width",
      "min": 35,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_image_height",
      "label": "Desktop Image Height",
      "min": 350,
      "max": 1000,
      "step": 25,
      "unit": "px",
      "default": 650
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Desktop Image Overlap"
    },
    {
      "type": "select",
      "id": "desktop_offset_unit",
      "label": "Offset Unit",
      "default": "px",
      "options": [
        { "value": "px", "label": "Pixels" },
        { "value": "percent", "label": "Percentage of Image Height" }
      ]
    },
    {
      "type": "range",
      "id": "desktop_offset_px",
      "label": "Vertical Offset",
      "min": -500,
      "max": 0,
      "step": 10,
      "unit": "px",
      "default": -200,
      "visible_if": "{{ section.settings.desktop_offset_unit == 'px' }}"
    },
    {
      "type": "range",
      "id": "desktop_offset_percent",
      "label": "Vertical Offset",
      "min": -50,
      "max": 0,
      "step": 1,
      "unit": "%",
      "default": -25,
      "visible_if": "{{ section.settings.desktop_offset_unit == 'percent' }}"
    },
    {
      "type": "header",
      "content": "Desktop Image Border Radius"
    },
    {
      "type": "range",
      "id": "desktop_radius_top_left",
      "label": "Top Left",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "desktop_radius_top_right",
      "label": "Top Right",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_radius_bottom_right",
      "label": "Bottom Right",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_radius_bottom_left",
      "label": "Bottom Left",
      "min": 0,
      "max": 500,
      "step": 5,
      "unit": "px",
      "default": 450
    },
    {
      "type": "header",
      "content": "Mobile Image Overlap"
    },
    {
      "type": "select",
      "id": "mobile_offset_unit",
      "label": "Offset Unit",
      "default": "percent",
      "options": [
        { "value": "px", "label": "Pixels" },
        { "value": "percent", "label": "Percentage of Image Height" }
      ]
    },
    {
      "type": "range",
      "id": "mobile_offset_px",
      "label": "Vertical Offset",
      "min": -400,
      "max": 0,
      "step": 10,
      "unit": "px",
      "default": -200,
      "visible_if": "{{ section.settings.mobile_offset_unit == 'px' }}"
    },
    {
      "type": "range",
      "id": "mobile_offset_percent",
      "label": "Vertical Offset",
      "min": -90,
      "max": 0,
      "step": 5,
      "unit": "%",
      "default": -50,
      "visible_if": "{{ section.settings.mobile_offset_unit == 'percent' }}"
    },
    {
      "type": "header",
      "content": "Mobile Image Border Radius"
    },
    {
      "type": "range",
      "id": "mobile_radius_top_left",
      "label": "Top Left",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_radius_top_right",
      "label": "Top Right",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "mobile_radius_bottom_right",
      "label": "Bottom Right",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "mobile_radius_bottom_left",
