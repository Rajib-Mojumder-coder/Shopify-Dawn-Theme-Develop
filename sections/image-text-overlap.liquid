      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Desktop Column Gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_padding",
      "label": "Enable Desktop Padding",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_section_padding_top",
      "label": "Desktop Top Padding",
      "min": 0,
      "max": 200,
