    },
    {
      "type": "checkbox",
      "id": "enable_mobile_padding",
      "label": "Enable Mobile Padding",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_section_padding_top",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "mobile_section_padding_bottom",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Image Text Overlap"
    }
  ]
