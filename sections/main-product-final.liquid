{{ 'section-main-product-final.css' | asset_url | stylesheet_tag }}
{%  liquid  
    assign color_scheme = section.settings.color_scheme
%}

<product-info  id="MainProduct-{{ section.id }}" class="product-final color-{{ color_scheme }}gradient">

</product-info>


{%  schema  %}
{
  "name": "Product Information",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [

  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}