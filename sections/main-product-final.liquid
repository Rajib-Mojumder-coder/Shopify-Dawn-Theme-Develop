{% comment %}
  ============================================================================
  MAIN PRODUCT FINAL
  ----------------------------------------------------------------------------
  Custom product-page foundation based on Shopify Dawn.

  Architecture:
  Product Page
    ├── Shared Product Layout Variables
    ├── Product Media
    └── Product Information
        └── Blocks

  Future sections such as Tabs & Advisory can consume the same CSS variables:
    --product-media-width
    --product-info-width
    --product-column-gap
    --product-content-max-width
    --product-page-width
============================================================================
{% endcomment %}

{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{% if product.quantity_price_breaks_configured? %}
  {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
{% endif %}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% if product.quantity_price_breaks_configured? %}
  <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% if section.settings.image_zoom == 'hover' %}
  <script
    id="EnableZoomOnHover-main-{{ section.id }}"
    src="{{ 'magnify.js' | asset_url }}"
    defer="defer"
  ></script>
{% endif %}

{% if request.design_mode %}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}

{% if first_3d_model %}
  {{ 'component-product-model.css' | asset_url | stylesheet_tag }}

  <link
    id="ModelViewerStyle-{{ section.id }}"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  >

  <link
    id="ModelViewerOverride-{{ section.id }}"
    rel="stylesheet"
    href="{{ 'component-model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  >
{% endif %}

{%- assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' -%}

{%- liquid
  assign media_width = 50
  assign info_width = 50

  unless section.settings.equal_columns
    case section.settings.media_column_size
      when 'small'
        assign media_width = 40
        assign info_width = 60

      when 'medium'
        assign media_width = 45
        assign info_width = 55

      when 'large'
        assign media_width = 55
        assign info_width = 45

      when 'extra_large'
        assign media_width = 60
        assign info_width = 40
    endcase
  endunless

  assign page_width = 'var(--page-width)'

  if section.settings.page_width == 'full'
    assign page_width = '100%'
  elsif section.settings.page_width == 'custom'
    assign page_width = section.settings.custom_page_width | append: 'px'
  endif
-%}

{%- comment -%}
  ============================================================================
  SHARED PRODUCT LAYOUT VARIABLES
  ----------------------------------------------------------------------------
  These variables intentionally live on :root so independent product sections
  such as Tabs & Advisory can consume the exact same layout configuration.
  ============================================================================
{%- endcomment -%}

<style>
  :root {
    --product-page-width: {{ page_width }};
    --product-media-width: {{ media_width }}%;
    --product-info-width: {{ info_width }}%;
    --product-column-gap: {{ section.settings.column_gap }}px;
  }
</style>

<style>
  /* ==========================================================================
     MAIN PRODUCT FINAL
     ========================================================================== */

  .product-final {
    --product-final-padding-top: {{ section.settings.padding_top }}px;
    --product-final-padding-bottom: {{ section.settings.padding_bottom }}px;

    {% if section.settings.use_custom_colors %}
      --product-final-background: {{ section.settings.custom_background }};
      --product-final-text: {{ section.settings.custom_text }};
      --product-final-heading: {{ section.settings.custom_heading }};
      --product-final-accent: {{ section.settings.custom_accent }};
    {% endif %}
  }

  .product-final__inner {
    width: 100%;
    max-width: var(--product-page-width);
    margin-inline: auto;
    padding-top: var(--product-final-padding-top);
    padding-bottom: var(--product-final-padding-bottom);
  }

  .product-final__layout {
    display: grid;
    grid-template-columns:
      minmax(0, var(--product-media-width))
      minmax(0, var(--product-info-width));
    gap: var(--product-column-gap);
    align-items: start;
  }

  /*
   * Media position
   */
  .product-final[data-media-position='right'] .product-final__media {
    order: 2;
  }

  .product-final[data-media-position='right'] .product-final__information {
    order: 1;
  }

  .product-final[data-media-position='left'] .product-final__media {
    order: 1;
  }

  .product-final[data-media-position='left'] .product-final__information {
    order: 2;
  }

  /*
   * Product media
   */
  .product-final__media {
    min-width: 0;
    width: 100%;
  }

  /*
   * Product information
   */
  .product-final__information {
    min-width: 0;
    width: 100%;
  }

  .product-final__information-inner {
    width: 100%;
  }

  /*
   * Sticky product information
   */
  .product-final__information-inner--sticky {
    position: sticky;
    top: 2rem;
  }

  /*
   * Optional content width inside information column.
   */
  .product-final[data-content-width='narrow'] .product-final__information-inner {
    max-width: 520px;
  }

  .product-final[data-content-width='medium'] .product-final__information-inner {
    max-width: 680px;
  }

  .product-final[data-content-width='full'] .product-final__information-inner {
    max-width: none;
  }

  /*
   * Information alignment
   */
  .product-final[data-text-align='left'] .product-final__information-inner {
    text-align: left;
  }

  .product-final[data-text-align='center'] .product-final__information-inner {
    text-align: center;
  }

  .product-final[data-text-align='right'] .product-final__information-inner {
    text-align: right;
  }

  /*
   * Vertical alignment
   */
  .product-final[data-vertical-align='center']
    .product-final__information {
    align-self: center;
  }

  .product-final[data-vertical-align='end']
    .product-final__information {
    align-self: end;
  }

  /*
   * Product color system.
   *
   * When custom colors are disabled, the normal Dawn color scheme remains
   * responsible for the colors.
   */
  .product-final[data-custom-colors='true'] {
    color: var(--product-final-text);
    background: var(--product-final-background);
  }

  .product-final[data-custom-colors='true'] .product__title,
  .product-final[data-custom-colors='true'] .product__text,
  .product-final[data-custom-colors='true'] .product__description {
    color: var(--product-final-heading);
  }

  /*
   * Sticky Add To Cart
   */
  .product-final__sticky-cart {
    position: fixed;
    z-index: 40;
    left: 0;
    right: 0;
    bottom: 0;

    display: none;

    padding: 12px 16px;

    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));

    border-top: 1px solid rgba(var(--color-foreground), 0.12);
  }

  .product-final__sticky-cart-inner {
    width: min(100%, var(--page-width));
    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .product-final__sticky-cart-title {
    min-width: 0;
    flex: 1;
  }

  .product-final__sticky-cart-title span {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-final__sticky-cart-button {
    flex: 0 0 auto;
  }

  .product-final__sticky-cart-button button {
    min-width: 180px;
  }

  /*
   * Mobile
   */
  @media screen and (max-width: 749px) {
    .product-final__inner {
      padding-top: calc(var(--product-final-padding-top) * 0.75);
      padding-bottom: calc(var(--product-final-padding-bottom) * 0.75);
    }

    .product-final__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    /*
     * On mobile, media always comes before information.
     */
    .product-final .product-final__media,
    .product-final .product-final__information {
      order: initial;
    }

    .product-final[data-mobile-order='information-first']
      .product-final__information {
      order: 1;
    }

    .product-final[data-mobile-order='information-first']
      .product-final__media {
      order: 2;
    }

    .product-final__information-inner--sticky {
      position: static;
    }

    .product-final__sticky-cart {
      display: block;
    }

    .product-final__sticky-cart-inner {
      gap: 10px;
    }

    .product-final__sticky-cart-title {
      display: none;
    }

    .product-final__sticky-cart-button {
      width: 100%;
    }

    .product-final__sticky-cart-button button {
      width: 100%;
    }
  }

  @media screen and (min-width: 750px) {
    .product-final[data-custom-colors='true'] {
      background: var(--product-final-background);
    }
  }

  /*
   * Full-width mode.
   *
   * The layout itself remains constrained by the configured width while the
   * section background can span the viewport.
   */
  .product-final--full {
    width: 100%;
  }

  /*
   * Accessibility / reduced motion
   */
  @media (prefers-reduced-motion: reduce) {
    .product-final *,
    .product-final *::before,
    .product-final *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>

<product-info
  id="MainProduct-{{ section.id }}"
  class="
    product-final
    color-{{ section.settings.color_scheme }}
    gradient
    {% if section.settings.page_width == 'full' %}
      product-final--full
    {% endif %}
  "
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  data-media-position="{{ section.settings.media_position }}"
  data-equal-columns="{{ section.settings.equal_columns }}"
  data-column-size="{{ section.settings.media_column_size }}"
  data-content-width="{{ section.settings.information_content_width }}"
  data-text-align="{{ section.settings.information_alignment }}"
  data-vertical-align="{{ section.settings.information_vertical_alignment }}"
  data-mobile-order="{{ section.settings.mobile_information_order }}"
  data-custom-colors="{{ section.settings.use_custom_colors }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  <div class="product-final__inner">

    {% render 'product-final-breadcrumb' %}

    <div class="product-final__layout">

      {%- comment -%}
        ======================================================================
        PRODUCT MEDIA
        ======================================================================
      {%- endcomment -%}

      <div class="product-final__media">

        {% render 'product-final-media',
          variant_images: variant_images
        %}

      </div>


      {%- comment -%}
        ======================================================================
        PRODUCT INFORMATION
        ======================================================================
      {%- endcomment -%}

      <div class="product-final__information">

        <div
          id="ProductInfo-{{ section.id }}"
          class="
            product-final__information-inner
            {% if section.settings.enable_sticky_info %}
              product-final__information-inner--sticky
            {% endif %}
          "
        >

          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}

            {%- case block.type -%}

              {%- when '@app' -%}

                {% render block %}


              {%- when 'title' -%}

                <div
                  class="product__title"
                  {{ block.shopify_attributes }}
                >
                  <h1 class="{{ block.settings.heading_size }}">
                    {{ product.title | escape }}
                  </h1>
                </div>


              {%- when 'text' -%}

                <div
                  class="product__text rte"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>


              {%- when 'vendor' -%}

                <div
                  class="product__vendor"
                  {{ block.shopify_attributes }}
                >
                  {{ product.vendor | escape }}
                </div>


              {%- when 'sku' -%}

                <div
                  class="product__sku"
                  {{ block.shopify_attributes }}
                >
                  {{ product.selected_or_first_available_variant.sku }}
                </div>


              {%- when 'price' -%}

                <div
                  id="price-{{ section.id }}"
                  class="product__price"
                  {{ block.shopify_attributes }}
                >
                  {% render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: block.settings.show_badges,
                    price_class: 'price--large'
                  %}
                </div>


              {%- when 'variant_picker' -%}

                {% unless product.has_only_default_variant %}
                  {% render 'product-variant-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id
                  %}
                {% endunless %}


              {%- when 'quantity_selector' -%}

                <div
                  class="product-form__input product-form__quantity"
                  {{ block.shopify_attributes }}
                >
                  <label
                    class="form__label"
                    for="Quantity-{{ section.id }}"
                  >
                    {{ 'products.product.quantity.label' | t }}
                  </label>

                  <quantity-input class="quantity">
                    <button
                      class="quantity__button"
                      name="minus"
                      type="button"
                    >
                      <span class="visually-hidden">
                        {{ 'products.product.quantity.decrease' | t: product: product.title | escape }}
                      </span>
                      {{- 'icon-minus.svg' | inline_asset_content -}}
                    </button>

                    <input
                      class="quantity__input"
                      type="number"
                      name="quantity"
                      id="Quantity-{{ section.id }}"
                      min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                      {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                        max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                      {% endif %}
                      step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                      value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                      form="{{ product_form_id }}"
                    >

                    <button
                      class="quantity__button"
                      name="plus"
                      type="button"
                    >
                      <span class="visually-hidden">
                        {{ 'products.product.quantity.increase' | t: product: product.title | escape }}
                      </span>
                      {{- 'icon-plus.svg' | inline_asset_content -}}
                    </button>
                  </quantity-input>
                </div>


              {%- when 'buy_buttons' -%}

                {% render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: block.settings.show_pickup_availability
                %}


              {%- when 'description' -%}

                {% if product.description != blank %}
                  <div
                    class="product__description rte"
                    {{ block.shopify_attributes }}
                  >
                    {{ product.description }}
                  </div>
                {% endif %}


              {%- when 'custom_liquid' -%}

                <div
                  class="product__custom-liquid"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.custom_liquid }}
                </div>


              {%- when 'share' -%}

                {% render 'share-button',
                  block: block,
                  share_link: product.selected_or_first_available_variant.url,
                  share_title: product.title,
                  share_image: product.featured_media
                %}


              {%- when 'popup' -%}

                <modal-opener
                  class="product-popup-modal__opener no-js-hidden"
                  data-modal="#PopupModal-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <button
                    type="button"
                    class="product-popup-modal__button link"
                  >
                    {{ block.settings.text | escape }}
                  </button>
                </modal-opener>


              {%- when 'collapsible_tab' -%}

                <div {{ block.shopify_attributes }}>
                  {% render 'product-accordion',
                    block: block
                  %}
                </div>


            {%- endcase -%}

          {%- endfor -%}

        </div>

      </div>

    </div>


        {%- comment -%}
        ==========================================================================
        PRODUCT MEDIA MODAL
        ==========================================================================
      {%- endcomment -%}

      {% render 'product-media-modal', variant_images: variant_images %}


  </div>


  {%- comment -%}
    ==========================================================================
    STICKY ADD TO CART
    --------------------------------------------------------------------------
    This is intentionally a lightweight layer.

    It triggers the primary Dawn product form rather than creating a second
    product form. Therefore variant selection remains controlled by the main
    product form.
    ==========================================================================
  {%- endcomment -%}

  {% if section.settings.enable_sticky_add_to_cart %}
    <div
      class="product-final__sticky-cart"
      data-sticky-add-to-cart
    >
      <div class="product-final__sticky-cart-inner">

        <div class="product-final__sticky-cart-title">
          <span>
            {{ product.title | escape }}
          </span>
        </div>

        <div class="product-final__sticky-cart-button">
          <button
            type="button"
            class="button button--full-width"
            data-sticky-add-button
          >
            {{ 'products.product.add_to_cart' | t }}
          </button>
        </div>

      </div>
    </div>
  {% endif %}


  

  {%- comment -%}
    ==========================================================================
    POPUP BLOCKS
    ==========================================================================
  {%- endcomment -%}

  {% assign popups = section.blocks | where: 'type', 'popup' %}

  {% for block in popups %}
    <modal-dialog
      id="PopupModal-{{ block.id }}"
      class="product-popup-modal"
      {{ block.shopify_attributes }}
    >
      <div
        role="dialog"
        aria-label="{{ block.settings.text | escape }}"
        aria-modal="true"
        class="product-popup-modal__content"
        tabindex="-1"
      >

        <button
          id="ModalClose-{{ block.id }}"
          type="button"
          class="product-popup-modal__toggle"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>

        <div class="product-popup-modal__content-info">

          <h2 class="h2">
            {{ block.settings.page.title | escape }}
          </h2>

          {{ block.settings.page.content }}

        </div>

      </div>
    </modal-dialog>
  {% endfor %}


  {%- comment -%}
    ==========================================================================
    MEDIA / MODEL SCRIPTS
    ==========================================================================
  {%- endcomment -%}

  {% if product.media.size > 0 %}
    <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
  {% endif %}


  {% if first_3d_model %}
    <script
      type="application/json"
      id="ProductJSON-{{ product.id }}"
    >
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>

    <script
      src="{{ 'product-model.js' | asset_url }}"
      defer
    ></script>
  {% endif %}


  {%- comment -%}
    ==========================================================================
    STRUCTURED DATA
    ==========================================================================
  {%- endcomment -%}

  {%- liquid
    if product.selected_or_first_available_variant.featured_media
      assign seo_media = product.selected_or_first_available_variant.featured_media
    else
      assign seo_media = product.featured_media
    endif
  -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

</product-info>


<script>
  /*
   * ==========================================================================
   * MAIN PRODUCT FINAL
   * ==========================================================================
   *
   * Sticky Add To Cart
   *
   * We intentionally do not create another product form.
   * The existing Dawn product form remains the source of truth.
   */

  (() => {
    const productSection = document.querySelector(
      '#MainProduct-{{ section.id }}'
    );

    if (!productSection) return;

    const stickyButton = productSection.querySelector(
      '[data-sticky-add-button]'
    );

    if (!stickyButton) return;

    stickyButton.addEventListener('click', () => {
      const productForm = productSection.querySelector(
        'form[action*="/cart/add"]'
      );

      if (!productForm) return;

      const submitButton = productForm.querySelector(
        '[name="add"]'
      );

      if (submitButton && !submitButton.disabled) {
        submitButton.click();
      }
    });

    /*
     * Keep the sticky button state synchronized with the main product form.
     */
    const productForm = productSection.querySelector(
      'form[action*="/cart/add"]'
    );

    if (!productForm) return;

    const submitButton = productForm.querySelector(
      '[name="add"]'
    );

    if (!submitButton) return;

    const syncButtonState = () => {
      stickyButton.disabled = submitButton.disabled;

      const buttonText = submitButton.querySelector(
        '.button-text'
      );

      if (buttonText) {
        stickyButton.textContent = buttonText.textContent.trim();
      } else if (submitButton.textContent.trim()) {
        stickyButton.textContent =
          submitButton.textContent.trim();
      }
    };

    syncButtonState();

    const observer = new MutationObserver(syncButtonState);

    observer.observe(submitButton, {
      attributes: true,
      childList: true,
      subtree: true
    });
  })();
</script>


{% schema %}
{
  "name": "Main Product Final",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },

  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "select",
      "id": "breadcrumb_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "breadcrumb_bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "select",
      "id": "page_width",
      "label": "Page width",
      "options": [
        {
          "value": "page",
          "label": "Theme page width"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "custom",
          "label": "Custom width"
        }
      ],
      "default": "page"
    },

    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 800,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1200
    },

    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },

    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "Equal columns",
