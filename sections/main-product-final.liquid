{{ 'section-main-product-final.css' | asset_url | stylesheet_tag }}
{%  liquid  
    assign color_scheme = section.settings.color_scheme
    assign breadcrumb_bottom_spacing = section.settings.breadcrumb_bottom_spacing
    assign section_padding_top = section.settings.padding_top
    assign section_padding_bottom = section.settings.padding_bottom

    if section.settings.layout_size == 'full'
      assign layout-width = '100%'
    elsif section.settings.page_width == 'default'
      assign layout-width = 'var(--page-width)'
    elsif section.settings.page_width == 'custom'
      assign layout-width = section.settings.custom_page_width | append: 'px'
    endif
%}

<product-info  id="MainProduct-{{ section.id }}" class="product-final color-{{ color_scheme }}gradient">
   <style>
     #MainProduct-{{ section.id }} {
        --page-layout-width: {{ layout-width }};
        --breadcrumb_bottom_spacing: {{ breadcrumb_bottom_spacing }}px;
        --section_padding_top: {{ section_padding_top }}px;
        --section_padding_bottom: {{ section_padding_bottom }}px;
     }
   </style>
  <div class="product-final__inner" style="background-color: aqua; ">
    
    {% if section.settings.show_breadcrumb %}
      <div class="product-final__breadcrumb">
        {% render 'product-final-breadcrumb' %}
      </div>
    {% endif %}

  </div>

</product-info>


{%  schema  %}
{
  "name": "Product Information",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [

  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_size",
      "label": "Width",
      "options": [
        { "label": "Page", "value": "page" },
        { "label": "Full", "value": "100%" }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Page width",
      "options": [
    { "label": "Theme default", "value": "default" },
    { "label": "Custom", "value": "custom" }
    ],
     "default": "default",
      "visible_if": "{{ section.settings.layout_size == 'page' }}"
    },
    {
      "type": "range",
      "id": "custom_page_width",
      "label": "Custom page width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200,
      "visible_if": "{{ section.settings.layout_size == 'page' and section.settings.page_width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "range",
      "id": "breadcrumb_bottom_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Product information"
    }
  ]
}
{% endschema %}